#!/usr/bin/env bash
# =============================================================================
# pridec — Pride native compiler driver
# =============================================================================
# "The over-engineered C."
export PATH="/usr/bin:$PATH"   # ensure llvm-22 tools are reachable
#
# Compiles Pride source files (.pie) to native ELF binaries using the pure
# LLVM 22 toolchain.  No Clang anywhere in the pipeline.
#
# PIPELINE:
#   pride --emit-llvm   →   llvm-as-22   →   opt-22   →   llc-22   →   ld.lld-22
#
# OPTIMIZATION TIERS:
#   (none)           Default: -O2, ThinLTO, standard passes.
#   --debug          No optimization (-O0), fastest compile, debuggable.
#   --maxout         -O3 + ThinLTO + WPD + GVN + ICP + MLGO + ICF + all passes.
#   --super-maxout   All of --maxout + PGO (two-pass) + VeriOpt verification.
#   --instrument     Emit instrumented binary for PGO profile collection.
#   --profile=FILE   Use PGO profile data (collected from --instrument run).
#
# VERIOPT:
#   --verify         Run Alive2 translation validation on each opt pass.
#                    Proves that optimizations are semantically correct.
#                    Requires alive2/build/opt-alive.sh on PATH or ALIVE2_PATH.
#
# USAGE:
#   pridec source.pie                        # compile to ./a.out (default tier)
#   pridec source.pie -o program             # specify output
#   pridec --debug source.pie -o program     # debug build
#   pridec --maxout source.pie -o program    # maximum optimization
#   pridec --super-maxout source.pie -o prog # AI-guided + verified optimization
#   pridec --verify source.pie               # verify optimizations with Alive2
#   pridec --instrument source.pie -o prog_instr && ./prog_instr && \
#     llvm-profdata-22 merge -o default.profdata default.profraw && \
#     pridec --super-maxout --profile=default.profdata source.pie -o prog
#
# ENVIRONMENT:
#   PRYDE_HOME       Path to pride compiler (default: directory of this script)
#   PRYDE_RUNTIME    Path to runtime.o (default: $PRYDE_HOME/runtime/runtime.o)
#   PRYDE_SYSROOT    Override sysroot for cross-compilation
#   ALIVE2_PATH      Path to opt-alive.sh (for --verify / --super-maxout)
#   LLVM_VERSION     Override LLVM version suffix (default: 22)
#   PRYDC_VERBOSE    Set to 1 for verbose command logging
#   PRYDC_KEEP_BC    Set to 1 to keep intermediate .bc files
#
# TOOL REQUIREMENTS (auto-detected):
#   Required:  pride  llvm-as-22  opt-22  llc-22  ld.lld-22  gcc
#   Optional:  llvm-profdata-22  alive-tv / opt-alive.sh
# =============================================================================

set -euo pipefail

# ── Constants ────────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRYDE_HOME="${PRYDE_HOME:-$SCRIPT_DIR}"
LLVM_VER="${LLVM_VERSION:-22}"
VERBOSE="${PRYDC_VERBOSE:-0}"
KEEP_BC="${PRYDC_KEEP_BC:-0}"

# Tool paths
PRIDE="$PRYDE_HOME/pride"
LLVM_AS="llvm-as-${LLVM_VER}"
OPT="opt-${LLVM_VER}"
LLC="llc-${LLVM_VER}"
LLD="ld.lld-${LLVM_VER}"
LLVM_PROFDATA="llvm-profdata-${LLVM_VER}"
LLVM_STRIP="llvm-strip-${LLVM_VER}"
ALIVE2_OPT="${ALIVE2_PATH:-/home/user/alive2/build/opt-alive.sh}"

# System paths (x86-64 Linux)
CRT_DIR="${PRYDE_SYSROOT:-}/usr/lib/x86_64-linux-gnu"
LIB_DIRS="-L${CRT_DIR} -L/lib/x86_64-linux-gnu"
DYNAMIC_LINKER="/lib64/ld-linux-x86-64.so.2"

# Colors
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; BOLD='\033[1m'; NC='\033[0m'

# ── Helpers ───────────────────────────────────────────────────────────────────

die()   { echo -e "${RED}pridec error:${NC} $*" >&2; exit 1; }
info()  { echo -e "${BLUE}pridec:${NC} $*" >&2; }
ok()    { echo -e "${GREEN}pridec:${NC} $*" >&2; }
warn()  { echo -e "${YELLOW}pridec warn:${NC} $*" >&2; }

run() {
    if [[ "$VERBOSE" == "1" ]]; then
        echo -e "${BOLD}+${NC} $*" >&2
    fi
    "$@"
}

require_tool() {
    command -v "$1" &>/dev/null || die "required tool not found: $1"
}

optional_tool() {
    command -v "$1" &>/dev/null && echo "1" || echo "0"
}

# ── Usage ─────────────────────────────────────────────────────────────────────

usage() {
    cat >&2 << 'USAGE'
pridec — Pride compiler driver (LLVM 22.1.8)

USAGE:
  pridec [TIER] [OPTIONS] source.pie [-o output]

TIERS (pick one):
  (default)          -O2, ThinLTO, standard LLVM passes
  --debug            -O0, no optimization, debuggable
  --maxout           -O3, ThinLTO, WPD, GVN, MLGO inlining, ICF, full BOLT-ready
  --super-maxout     All of --maxout + PGO + Alive2/VeriOpt verification

OPTIONS:
  -o FILE            Output binary (default: a.out)
  --verify           Run Alive2 translation validation on optimizations
  --instrument       Instrument for PGO profile collection
  --profile=FILE     Use PGO profile data (.profdata)
  --emit-llvm=FILE   Only emit LLVM IR, don't compile (- for stdout)
  --emit-bc=FILE     Only emit bitcode, don't compile
  --no-lto           Disable link-time optimization
  --keep-bc          Keep intermediate .bc files
  --verbose          Print each command as it runs
  --help             This message

EXAMPLES:
  pridec hello.pie                           # simple compile
  pridec --debug hello.pie -o hello_dbg      # debug build
  pridec --maxout app.pie -o app             # max performance
  pridec --verify app.pie -o app             # verified optimization
  pridec --super-maxout --profile=p.profdata app.pie -o app

ENVIRONMENT:
  PRYDE_HOME, ALIVE2_PATH, PRYDC_VERBOSE, PRYDC_KEEP_BC, LLVM_VERSION
USAGE
    exit 0
}

# ── Argument parsing ──────────────────────────────────────────────────────────

TIER="default"
SOURCE=""
OUTPUT="a.out"
VERIFY=0
INSTRUMENT=0
PROFILE=""
EMIT_LLVM=""
EMIT_BC=""
NO_LTO=0
EXTRA_LDFLAGS=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --debug)          TIER="debug"; shift ;;
        --maxout)         TIER="maxout"; shift ;;
        --super-maxout)   TIER="supermaxout"; shift ;;
        --verify)         VERIFY=1; shift ;;
        --instrument)     INSTRUMENT=1; shift ;;
        --profile=*)      PROFILE="${1#--profile=}"; shift ;;
        --emit-llvm=*)    EMIT_LLVM="${1#--emit-llvm=}"; shift ;;
        --emit-bc=*)      EMIT_BC="${1#--emit-bc=}"; shift ;;
        --no-lto)         NO_LTO=1; shift ;;
        --keep-bc)        KEEP_BC=1; shift ;;
        --verbose|-v)     VERBOSE=1; shift ;;
        --help|-h)        usage ;;
        -o)               OUTPUT="$2"; shift 2 ;;
        -o*)              OUTPUT="${1#-o}"; shift ;;
        *.pie)            SOURCE="$1"; shift ;;
        *)                die "unknown option: $1 (run pridec --help)" ;;
    esac
done

[[ -z "$SOURCE" ]] && die "no source file specified (run pridec --help)"
[[ -f "$SOURCE" ]] || die "source file not found: $SOURCE"
[[ -x "$PRIDE" ]] || die "pride compiler not found: $PRIDE"

# ── Tool availability ─────────────────────────────────────────────────────────

require_tool "$LLVM_AS"
require_tool "$OPT"
require_tool "$LLC"
require_tool "$LLD"

HAS_PROFDATA=$(optional_tool "$LLVM_PROFDATA")
HAS_ALIVE2=0
if [[ -x "$ALIVE2_OPT" ]]; then
    HAS_ALIVE2=1
elif command -v opt-alive.sh &>/dev/null; then
    ALIVE2_OPT="opt-alive.sh"
    HAS_ALIVE2=1
fi

# VeriOpt requires Alive2
if [[ "$VERIFY" == "1" && "$HAS_ALIVE2" == "0" ]]; then
    warn "Alive2 not found (set ALIVE2_PATH). Skipping VeriOpt verification."
    VERIFY=0
fi
if [[ "$TIER" == "supermaxout" && "$HAS_ALIVE2" == "0" ]]; then
    warn "Alive2 not found — super-maxout will run without VeriOpt verification."
fi

# ── Runtime object ────────────────────────────────────────────────────────────

RUNTIME_C="$PRYDE_HOME/runtime/runtime.c"
RUNTIME_O="${PRYDE_RUNTIME:-$PRYDE_HOME/runtime/runtime.o}"

if [[ ! -f "$RUNTIME_O" ]]; then
    if [[ -f "$RUNTIME_C" ]]; then
        info "Compiling runtime..."
        run gcc -O2 -std=c11 -pthread -Wall -fno-strict-aliasing -fPIC \
            -c "$RUNTIME_C" -o "$RUNTIME_O"
        ok "Runtime compiled: $RUNTIME_O"
    else
        die "runtime not found: $RUNTIME_O (run: gcc -O2 -c runtime/runtime.c -o runtime/runtime.o)"
    fi
fi

# ── Temporary files ───────────────────────────────────────────────────────────

TMPDIR_PRYDC=$(mktemp -d /tmp/pridec.XXXXXX)
trap 'rm -rf "$TMPDIR_PRYDC"' EXIT

BASE=$(basename "$SOURCE" .pie)
TMP_LL="$TMPDIR_PRYDC/$BASE.ll"
TMP_BC="$TMPDIR_PRYDC/$BASE.bc"
TMP_OPT="$TMPDIR_PRYDC/$BASE.opt.bc"
TMP_O="$TMPDIR_PRYDC/$BASE.o"

# ── Banner ────────────────────────────────────────────────────────────────────

tier_label() {
    case "$1" in
        debug)       echo "debug (-O0)" ;;
        default)     echo "default (-O2 + ThinLTO)" ;;
        maxout)      echo "maxout (-O3 + ThinLTO + WPD + MLGO + ICF)" ;;
        supermaxout) echo "super-maxout (-O3 + PGO + VeriOpt + all passes)" ;;
        *)           echo "$1" ;;
    esac
}
info "compiling ${BOLD}$SOURCE${NC}  tier=$(tier_label "$TIER")"
[[ "$VERIFY" == "1" ]] && info "VeriOpt (Alive2) verification: ENABLED"

# ── Step 1: Emit LLVM IR ──────────────────────────────────────────────────────

info "[1/4] Emitting LLVM 22 IR..."
PRYDE_FLAGS=(--emit-llvm "$TMP_LL")
[[ "$INSTRUMENT" == "1" ]] && PRYDE_FLAGS+=(--instrument)

run "$PRIDE" "${PRYDE_FLAGS[@]}" "$SOURCE"

# Handle --emit-llvm shortcut
if [[ -n "$EMIT_LLVM" ]]; then
    if [[ "$EMIT_LLVM" == "-" ]]; then cat "$TMP_LL"
    else cp "$TMP_LL" "$EMIT_LLVM"; ok "LLVM IR written to $EMIT_LLVM"
    fi
    exit 0
fi

# ── Step 2: Assemble to bitcode ───────────────────────────────────────────────

info "[2/4] Assembling to LLVM bitcode..."
run "$LLVM_AS" "$TMP_LL" -o "$TMP_BC"

if [[ -n "$EMIT_BC" ]]; then
    cp "$TMP_BC" "$EMIT_BC"; ok "Bitcode written to $EMIT_BC"; exit 0
fi

# ── Step 3: Optimise ──────────────────────────────────────────────────────────

info "[3/4] Optimising..."

# Select the opt command based on tier and VeriOpt setting
OPT_CMD="$OPT"
if [[ "$VERIFY" == "1" && "$HAS_ALIVE2" == "1" ]]; then
    OPT_CMD="$ALIVE2_OPT"
    info "  VeriOpt: using Alive2 opt wrapper for verified optimization"
fi

case "$TIER" in

# ── debug: -O0, no optimization whatsoever ────────────────────────────────────
debug)
    run "$OPT_CMD" -O0 "$TMP_BC" -o "$TMP_OPT"
    LLC_FLAGS=(-O0 -filetype=obj)
    LTO_FLAGS=()
    ;;

# ── default: -O2, ThinLTO, standard passes ───────────────────────────────────
default)
    OPT_PASSES="default<O2>"
    [[ -n "$PROFILE" ]] && OPT_PASSES="${OPT_PASSES},pgo-instr-use"

    OPT_ARGS=(-passes="$OPT_PASSES")
    [[ -n "$PROFILE" ]] && OPT_ARGS+=(-pgo-instrument-path="$PROFILE")

    run "$OPT_CMD" "${OPT_ARGS[@]}" "$TMP_BC" -o "$TMP_OPT" 2>/dev/null || \
        run "$OPT" -passes="$OPT_PASSES" "$TMP_BC" -o "$TMP_OPT"
    LLC_FLAGS=(-O2 -filetype=obj -relocation-model=pic)
    LTO_FLAGS=(--lto-O2 --thinlto-cache-dir="$TMPDIR_PRYDC/thinlto_cache")
    ;;

# ── maxout: -O3 + all aggressive passes ──────────────────────────────────────
maxout)
    # Build the maxout pass pipeline:
    #   default<O3>      — full standard -O3 pipeline
    #   wholeprogramdevirt — eliminate virtual dispatch under LTO
    #   globalopt        — global dead code and constant propagation
    #   constmerge       — merge identical constants
    #   deadargelim      — dead argument elimination
    #   newgvn           — aggressive Global Value Numbering
    #   mergefunc        — merge structurally identical functions
    #   tailcallelim     — tail-call optimization
    #   dse              — dead store elimination
    OPT_PASSES="default<O3>,\
wholeprogramdevirt,\
globalopt,\
constmerge,\
deadargelim,\
newgvn,\
mergefunc,\
tailcallelim,\
dse"

    # Add ICP (Indirect Call Promotion) if profile available
    if [[ -n "$PROFILE" ]]; then
        OPT_PASSES="${OPT_PASSES},pgo-icall-prom,pgo-instr-use"
    fi

    OPT_ARGS=(-passes="$OPT_PASSES")
    [[ -n "$PROFILE" ]] && OPT_ARGS+=(-pgo-instrument-path="$PROFILE")

    # MLGO: ML-guided inlining (uses embedded TFLite model)
    # The inliner-ml-advisor-release pass is wired into default<O3> when
    # LLVM is built with ML support. Explicitly request it:
    OPT_ARGS+=(
        -enable-ml-inliner=release       # MLGO inlining heuristic
        -regalloc-enable-advisor=release # MLGO register allocation
    )

    run "$OPT_CMD" "${OPT_ARGS[@]}" "$TMP_BC" -o "$TMP_OPT" 2>/dev/null || {
        # Graceful fallback if MLGO flags not supported in this build
        warn "MLGO flags not supported in this opt build; retrying without them"
        run "$OPT_CMD" -passes="$OPT_PASSES" "$TMP_BC" -o "$TMP_OPT"
    }

    LLC_FLAGS=(
        -O3 -filetype=obj -relocation-model=pic
        -enable-misched             # machine instruction scheduler
        -regalloc=greedy            # greedy register allocator
        -enable-implicit-null-checks # implicit null check optimization
    )
    LTO_FLAGS=(
        --lto-O3
        --thinlto-cache-dir="$TMPDIR_PRYDC/thinlto_cache"
        --icf=all
        --gc-sections
        --export-dynamic-symbol=main
    )
    ;;

# ── super-maxout: maxout + PGO + VeriOpt ─────────────────────────────────────
supermaxout)
    # Instrumentation pass: if --instrument was set, the binary was already
    # compiled with instrumentation. Here we're in the use phase.
    OPT_PASSES="default<O3>,\
wholeprogramdevirt,\
globalopt,\
constmerge,\
deadargelim,\
newgvn,\
mergefunc,\
tailcallelim,\
dse,\
pgo-force-function-attrs"

    # PGO use pass
    if [[ -n "$PROFILE" ]]; then
        OPT_PASSES="${OPT_PASSES},pgo-instr-use,pgo-icall-prom,pgo-memop-opt"
        info "  PGO: using profile data: $PROFILE"
    elif [[ "$HAS_PROFDATA" == "1" && -f "default.profdata" ]]; then
        PROFILE="default.profdata"
        OPT_PASSES="${OPT_PASSES},pgo-instr-use,pgo-icall-prom"
        warn "Using default.profdata for PGO"
    else
        info "  PGO: no profile data (run with --instrument first for full super-maxout)"
    fi

    # Contextual PGO: finer-grained call-site profiling
    if [[ -n "$PROFILE" ]]; then
        OPT_PASSES="${OPT_PASSES},ctx-prof-flatten"
    fi

    # Base opt args (without MLGO — alive2 doesn't support ML advisor flags)
    OPT_ARGS=(-passes="$OPT_PASSES")
    [[ -n "$PROFILE" ]] && OPT_ARGS+=(-pgo-instrument-path="$PROFILE")
    # MLGO args (only for plain opt, not alive2)
    MLGO_ARGS=(-enable-ml-inliner=release -regalloc-enable-advisor=release)

    if [[ "$HAS_ALIVE2" == "1" ]]; then
        info "  VeriOpt: Alive2 translation validation active"
        VERIFY_LOG="$TMPDIR_PRYDC/veriopt.log"
        # Run alive2 opt for verification (without MLGO flags)
        run "$ALIVE2_OPT" "${OPT_ARGS[@]}" "$TMP_BC" -o "$TMP_OPT" 2>"$VERIFY_LOG" || true
        # If output empty/missing (alive2 failed), fall back to plain opt with MLGO
        if [[ ! -s "$TMP_OPT" ]]; then
            warn "Alive2 failed; using standard opt"
            run "$OPT" "${OPT_ARGS[@]}" "${MLGO_ARGS[@]}" "$TMP_BC" -o "$TMP_OPT" 2>/dev/null ||                 run "$OPT" "${OPT_ARGS[@]}" "$TMP_BC" -o "$TMP_OPT"
        fi
        # Report verification results
        if grep -q "Transformation doesn't verify" "$VERIFY_LOG" 2>/dev/null; then
            warn "Some optimizations failed Alive2 verification"
            cp "$VERIFY_LOG" "${OUTPUT%.out}.veriopt.log" 2>/dev/null || true
            info "  VeriOpt report saved to: ${OUTPUT%.out}.veriopt.log"
        else
            ok "VeriOpt: all transformations verified correct by Alive2/Z3"
        fi
    else
        # No VeriOpt — use plain opt with MLGO
        run "$OPT" "${OPT_ARGS[@]}" "${MLGO_ARGS[@]}" "$TMP_BC" -o "$TMP_OPT" 2>/dev/null || {
            warn "MLGO flags not supported; retrying without them"
            run "$OPT" "${OPT_ARGS[@]}" "$TMP_BC" -o "$TMP_OPT"
        }
    fi

    LLC_FLAGS=(
        -O3 -filetype=obj -relocation-model=pic
        -enable-misched
        -regalloc=greedy
        -enable-implicit-null-checks
    )
    LTO_FLAGS=(
        --lto-O3
        --thinlto-cache-dir="$TMPDIR_PRYDC/thinlto_cache"
        --icf=all
        --gc-sections
        --lto-whole-program-visibility
        --export-dynamic-symbol=main    # prevent WPD from eliminating entry point
    )
    ;;

*)
    die "unknown tier: $TIER"
    ;;
esac

# For debug tier the OPT_CMD already ran above
# For others, OPT_CMD ran in the case blocks. TMP_OPT is set.

# Handle instrumentation mode
if [[ "$INSTRUMENT" == "1" && "$TIER" != "debug" ]]; then
    info "  PGO instrumentation: adding profile-generate pass"
    run "$OPT" -passes="pgo-instr-gen,default<O2>" \
        "$TMP_BC" -o "$TMP_OPT"
fi

# Keep bitcode if requested
if [[ "$KEEP_BC" == "1" ]]; then
    cp "$TMP_OPT" "${OUTPUT%.out}.opt.bc"
    ok "Optimised bitcode saved to ${OUTPUT%.out}.opt.bc"
fi

# ── Step 4: Compile object + Link ─────────────────────────────────────────────

info "[4/4] Compiling object and linking..."

# LLC: bitcode → ELF object
run "$LLC" "${LLC_FLAGS[@]}" "$TMP_OPT" -o "$TMP_O"

# LLD: link everything
if [[ "$NO_LTO" == "1" ]]; then
    LTO_FLAGS=()
fi

run "$LLD" \
    "${CRT_DIR}/crt1.o" \
    "${CRT_DIR}/crti.o" \
    "$TMP_O" \
    "$RUNTIME_O" \
    "${CRT_DIR}/crtn.o" \
    ${LIB_DIRS} \
    -lc -lpthread -lm \
    --dynamic-linker "$DYNAMIC_LINKER" \
    "${LTO_FLAGS[@]}" \
    -o "$OUTPUT"

# Strip debug info for non-debug builds
if [[ "$TIER" != "debug" ]] && command -v "$LLVM_STRIP" &>/dev/null; then
    run "$LLVM_STRIP" --strip-debug "$OUTPUT" 2>/dev/null || true
fi

# ── Done ──────────────────────────────────────────────────────────────────────

SIZE=$(stat -c%s "$OUTPUT" 2>/dev/null || echo "?")
ok "Built: ${BOLD}$OUTPUT${NC}  (${SIZE} bytes, tier=$TIER)"

# BOLT hint for maxout/super-maxout
if [[ "$TIER" == "maxout" || "$TIER" == "supermaxout" ]]; then
    if ! command -v llvm-bolt &>/dev/null; then
        info "  BOLT tip: for further gains, rebuild with llvm-bolt after profiling:"
        info "    perf record -e cycles:u -j any,u -- $OUTPUT [args]"
        info "    perf2bolt -p perf.data -o perf.fdata $OUTPUT"
        info "    llvm-bolt $OUTPUT -o ${OUTPUT}.bolt -data=perf.fdata \\"
        info "      -reorder-blocks=ext-tsp -reorder-functions=cdsort -split-functions"
    fi
fi
