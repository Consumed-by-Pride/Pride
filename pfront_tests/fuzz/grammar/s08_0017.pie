mod s
fn f : (i64) -> i64
  | n ->
    match n
    | 0i64 -> 0i64
    | 1i64 -> 1i64
    | 2i64 -> 2i64
    | 3i64 -> 3i64
    | 4i64 -> 4i64
    | 5i64 -> 5i64
    | 6i64 -> 6i64
    | 7i64 -> 7i64
    | 8i64 -> 8i64
    | 9i64 -> 9i64
    | 10i64 -> 10i64
    | 11i64 -> 11i64
    | 12i64 -> 12i64
    | 13i64 -> 13i64
    | 14i64 -> 14i64
    | 15i64 -> 15i64
    | 16i64 -> 16i64
    | _ -> 0i64
