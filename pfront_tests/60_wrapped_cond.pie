fn f : (u64, u64) -> u64
  | (m, hi) ->
    let mut x = m
    if x <= 1u64 &&
       x == hi
      x = 1u64
    else
      x = 2u64
    x

fn g : (u64, u64) -> u64
  | (m, hi) ->
    let mut x = m
    if x <= 1u64 &&
       x >= 2u64 &&
       x == hi
      x = x & 4u64
    x

fn h : (u64, u64) -> u64
  | (m, hi) ->
    let mut x = m
    if x <= 1u64 &&
       x == hi
      if x > 0u64
        x = x + 1u64
    x
