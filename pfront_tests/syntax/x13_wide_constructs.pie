-- WIDE CONSTRUCTS: every place a1 used a fixed-size buffer.
--
-- a1 lowered variadic constructs through `uint[16] ops` with a `k < 16`
-- loop guard, a clause list through `Node*[64]`, match arms through
-- `Node*[64]`, the match join through `uint[64]`, and a phi's operands
-- through `uint[64]`. Everything past the bound was DROPPED, mostly with
-- no diagnostic. D6 forbids exactly this.
--
-- Each construct here is deliberately wider than its old cap.
mod wide_constructs

struct Wide
  f0 : i64
  f1 : i64
  f2 : i64
  f3 : i64
  f4 : i64
  f5 : i64
  f6 : i64
  f7 : i64
  f8 : i64
  f9 : i64
  f10 : i64
  f11 : i64
  f12 : i64
  f13 : i64
  f14 : i64
  f15 : i64
  f16 : i64
  f17 : i64
  f18 : i64
  f19 : i64

fn take20 : (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64
  | (a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19) -> a0 + a19

-- 21 call operands: callee + 20 args, old cap 16.
fn call20 : () -> i64
  | () -> take20(0i64, 1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64, 10i64, 11i64, 12i64, 13i64, 14i64, 15i64, 16i64, 17i64, 18i64, 19i64)

-- Nested wide calls: proves the operand stack is re-entrant.
fn nested : () -> i64
  | () -> take20(take20(0i64, 1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64, 10i64, 11i64, 12i64, 13i64, 14i64, 15i64, 16i64, 17i64, 18i64, 19i64), 1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, take20(0i64, 1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64, 10i64, 11i64, 12i64, 13i64, 14i64, 15i64, 16i64, 17i64, 18i64, 19i64), 10i64, 11i64, 12i64, 13i64, 14i64, 15i64, 16i64, 17i64, take20(0i64, 1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64, 10i64, 11i64, 12i64, 13i64, 14i64, 15i64, 16i64, 17i64, 18i64, 19i64), 19i64)

-- 20 struct fields, old cap 16.
fn make20 : () -> Wide
  | () -> Wide { f0: 0i64, f1: 1i64, f2: 2i64, f3: 3i64, f4: 4i64, f5: 5i64, f6: 6i64, f7: 7i64, f8: 8i64, f9: 9i64, f10: 10i64, f11: 11i64, f12: 12i64, f13: 13i64, f14: 14i64, f15: 15i64, f16: 16i64, f17: 17i64, f18: 18i64, f19: 19i64 }

-- 20-element tuple and array, old cap 16.
fn tup20 : () -> i64
  | () -> (0i64, 1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64, 10i64, 11i64, 12i64, 13i64, 14i64, 15i64, 16i64, 17i64, 18i64, 19i64) |> fn | t -> 0i64

fn arr20 : () -> i64
  | () -> [0i64, 1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64, 10i64, 11i64, 12i64, 13i64, 14i64, 15i64, 16i64, 17i64, 18i64, 19i64] |> fn | a -> 0i64

-- 80 match arms, old cap 64.
fn m80 : (i64) -> i64
  | x ->
    match x
    | 0i64 -> 0i64
    | 1i64 -> 2i64
    | 2i64 -> 4i64
    | 3i64 -> 6i64
    | 4i64 -> 8i64
    | 5i64 -> 10i64
    | 6i64 -> 12i64
    | 7i64 -> 14i64
    | 8i64 -> 16i64
    | 9i64 -> 18i64
    | 10i64 -> 20i64
    | 11i64 -> 22i64
    | 12i64 -> 24i64
    | 13i64 -> 26i64
    | 14i64 -> 28i64
    | 15i64 -> 30i64
    | 16i64 -> 32i64
    | 17i64 -> 34i64
    | 18i64 -> 36i64
    | 19i64 -> 38i64
    | 20i64 -> 40i64
    | 21i64 -> 42i64
    | 22i64 -> 44i64
    | 23i64 -> 46i64
    | 24i64 -> 48i64
    | 25i64 -> 50i64
    | 26i64 -> 52i64
    | 27i64 -> 54i64
    | 28i64 -> 56i64
    | 29i64 -> 58i64
    | 30i64 -> 60i64
    | 31i64 -> 62i64
    | 32i64 -> 64i64
    | 33i64 -> 66i64
    | 34i64 -> 68i64
    | 35i64 -> 70i64
    | 36i64 -> 72i64
    | 37i64 -> 74i64
    | 38i64 -> 76i64
    | 39i64 -> 78i64
    | 40i64 -> 80i64
    | 41i64 -> 82i64
    | 42i64 -> 84i64
    | 43i64 -> 86i64
    | 44i64 -> 88i64
    | 45i64 -> 90i64
    | 46i64 -> 92i64
    | 47i64 -> 94i64
    | 48i64 -> 96i64
    | 49i64 -> 98i64
    | 50i64 -> 100i64
    | 51i64 -> 102i64
    | 52i64 -> 104i64
    | 53i64 -> 106i64
    | 54i64 -> 108i64
    | 55i64 -> 110i64
    | 56i64 -> 112i64
    | 57i64 -> 114i64
    | 58i64 -> 116i64
    | 59i64 -> 118i64
    | 60i64 -> 120i64
    | 61i64 -> 122i64
    | 62i64 -> 124i64
    | 63i64 -> 126i64
    | 64i64 -> 128i64
    | 65i64 -> 130i64
    | 66i64 -> 132i64
    | 67i64 -> 134i64
    | 68i64 -> 136i64
    | 69i64 -> 138i64
    | 70i64 -> 140i64
    | 71i64 -> 142i64
    | 72i64 -> 144i64
    | 73i64 -> 146i64
    | 74i64 -> 148i64
    | 75i64 -> 150i64
    | 76i64 -> 152i64
    | 77i64 -> 154i64
    | 78i64 -> 156i64
    | 79i64 -> 158i64
    | _ -> 0i64

-- 80 clauses, old cap 64. The join block gets ~81 predecessors, so the
-- phi needs ~81 operands: old cap 64, and the verifier rejected it.
fn c80 : (i64) -> i64
  | 0i64 -> 0i64
  | 1i64 -> 1i64
  | 2i64 -> 2i64
  | 3i64 -> 3i64
  | 4i64 -> 4i64
  | 5i64 -> 5i64
  | 6i64 -> 6i64
  | 7i64 -> 7i64
  | 8i64 -> 8i64
  | 9i64 -> 9i64
  | 10i64 -> 10i64
