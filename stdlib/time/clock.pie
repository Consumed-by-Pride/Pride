mod time.clock

use os.linux
use time.duration

-- stdlib/time/clock.pie — POSIX Clocks and System Timers
-- Linux clock_gettime / clock_getres bindings for real-time, monotonic, and boot clocks.

const CLOCK_REALTIME           : i32 = 0i32
const CLOCK_MONOTONIC          : i32 = 1i32
const CLOCK_PROCESS_CPUTIME_ID : i32 = 2i32
const CLOCK_THREAD_CPUTIME_ID  : i32 = 3i32
const CLOCK_MONOTONIC_RAW      : i32 = 4i32
const CLOCK_REALTIME_COARSE    : i32 = 5i32
const CLOCK_MONOTONIC_COARSE   : i32 = 6i32
const CLOCK_BOOTTIME           : i32 = 7i32

fn clock_gettime_raw : (i32, ptr) -> i64
  | (clk_id, ts_ptr) -> os.linux.clock_gettime(clk_id, ts_ptr)

fn clock_getres_raw : (i32, ptr) -> i64
  | (clk_id, ts_ptr) -> os.linux.clock_getres(clk_id, ts_ptr)

fn clock_get_duration : i32 -> duration.Duration
  | clk_id ->
    let ts = os.linux.malloc(16i64) as *i64
    let r  = clock_gettime_raw(clk_id, ts as ptr)
    if r < 0i64
      os.linux.free(ts as ptr)
      duration.Duration { secs: 0i64, nanos: 0i32 }
    else
      let s = ts[0i64]
      let n = ts[1i64] as i32
      os.linux.free(ts as ptr)
      duration.Duration { secs: s, nanos: n }

fn clock_monotonic : () -> duration.Duration
  | () -> clock_get_duration(CLOCK_MONOTONIC)

fn clock_realtime : () -> duration.Duration
  | () -> clock_get_duration(CLOCK_REALTIME)

fn clock_boottime : () -> duration.Duration
  | () -> clock_get_duration(CLOCK_BOOTTIME)

fn clock_resolution : i32 -> duration.Duration
  | clk_id ->
    let ts = os.linux.malloc(16i64) as *i64
    let r  = clock_getres_raw(clk_id, ts as ptr)
    if r < 0i64
      os.linux.free(ts as ptr)
      duration.Duration { secs: 0i64, nanos: 0i32 }
    else
      let s = ts[0i64]
      let n = ts[1i64] as i32
      os.linux.free(ts as ptr)
      duration.Duration { secs: s, nanos: n }
