mod pride.rewrite

use str.string

-- stdlib/pride/rewrite.pie — AST / Term Rewriting Engine & Robinson Unification
-- Pattern matching over AST expressions, priority-based rule sorting,
-- Robinson structural unification, and deterministic term-rewriting loops.

struct AstTerm {
    tag: i64,
    child_count: i64,
    children: [i64; 8]
}

struct UnifierBinding {
    var_tag: i64,
    term_tag: i64
}

struct RuleUnifier {
    count: i64,
    bindings: [UnifierBinding; 16]
}

struct Rule {
    id: i64,
    lhs_tag: i64,
    rhs_tag: i64,
    priority: i64,
    active: bool
}

struct RewriteEngine {
    rule_count: i64,
    rules: [Rule; 32],
    max_steps: i64,
    rewrites_performed: i64
}

-- ── Robinson AST Pattern Unification ────────────────────────────────────────

fn unifier_new : () -> RuleUnifier
    | () ->
        RuleUnifier {
            count: 0i64,
            bindings: [UnifierBinding { var_tag: 0i64, term_tag: 0i64 }; 16]
        }

fn unifier_bind : (*RuleUnifier, i64, i64) -> bool
    | (u, var_tag, term_tag) ->
        if u != null && u.count < 16i64 then {
            let mut i : i64 = 0i64;
            let mut conflict : bool = false;
            while true do {
                if i >= u.count then {
                    break;
                };
                if u.bindings[i].var_tag == var_tag && u.bindings[i].term_tag != term_tag then {
                    conflict = true;
                    break;
                };
                i = i + 1i64;
            };
            if !conflict then {
                let idx : i64 = u.count;
                u.bindings[idx] = UnifierBinding { var_tag: var_tag, term_tag: term_tag };
                u.count = idx + 1i64;
                true
            } else {
                false
            }
        } else {
            false
        }

fn unifier_lookup : (*RuleUnifier, i64) -> i64
    | (u, var_tag) ->
        if u == null then {
            0i64
        } else {
            let mut i : i64 = 0i64;
            let mut res : i64 = 0i64;
            while true do {
                if i >= u.count then {
                    break;
                };
                if u.bindings[i].var_tag == var_tag then {
                    res = u.bindings[i].term_tag;
                    break;
                };
                i = i + 1i64;
            };
            res
        }

fn unify_terms : (*RuleUnifier, *AstTerm, *AstTerm) -> bool
    | (u, pat, target) ->
        if u == null || pat == null || target == null then {
            false
        } else if pat.tag < 0i64 then {
            -- Negative tags indicate variable placeholders (~x)
            unifier_bind(u, pat.tag, target.tag)
        } else if pat.tag == target.tag && pat.child_count == target.child_count then {
            let mut i : i64 = 0i64;
            let mut ok : bool = true;
            while true do {
                if i >= pat.child_count then {
                    break;
                };
                if pat.children[i] != target.children[i] then {
                    ok = false;
                    break;
                };
                i = i + 1i64;
            };
            ok
        } else {
            false
        }

fn apply_substitution : (*RuleUnifier, *AstTerm, *AstTerm) -> ()
    | (u, template_term, out_term) ->
        if u != null && template_term != null && out_term != null then {
            if template_term.tag < 0i64 then {
                let bound = unifier_lookup(u, template_term.tag);
                if bound != 0i64 then {
                    out_term.tag = bound;
                } else {
                    out_term.tag = template_term.tag;
                };
            } else {
                out_term.tag = template_term.tag;
            };
            out_term.child_count = template_term.child_count;
            let mut i : i64 = 0i64;
            while true do {
                if i >= template_term.child_count then {
                    break;
                };
                let c_tag = template_term.children[i];
                if c_tag < 0i64 then {
                    let c_bound = unifier_lookup(u, c_tag);
                    if c_bound != 0i64 then {
                        out_term.children[i] = c_bound;
                    } else {
                        out_term.children[i] = c_tag;
                    };
                } else {
                    out_term.children[i] = c_tag;
                };
                i = i + 1i64;
            };
        } else {
            ()
        }

-- ── Priority-Based Rule Engine ──────────────────────────────────────────────

fn rule_new : (i64, i64, i64) -> Rule
    | (lhs_tag, rhs_tag, priority) ->
        Rule {
            id: lhs_tag * 1000i64 + rhs_tag,
            lhs_tag: lhs_tag,
            rhs_tag: rhs_tag,
            priority: priority,
            active: true
        }

fn rule_destroy : *Rule -> ()
    | r ->
        if r != null then {
            r.active = false;
            r.id = 0i64;
        } else {
            ()
        }

fn rule_match_tag : (*Rule, i64) -> bool
    | (r, target_tag) ->
        if r != null && r.active && r.lhs_tag == target_tag then {
            true
        } else {
            false
        }

fn rewrite_engine_new : i64 -> RewriteEngine
    | steps ->
        RewriteEngine {
            rule_count: 0i64,
            rules: [Rule { id: 0i64, lhs_tag: 0i64, rhs_tag: 0i64, priority: 0i64, active: false }; 32],
            max_steps: steps,
            rewrites_performed: 0i64
        }

fn rewrite_engine_destroy : *RewriteEngine -> ()
    | e ->
        if e != null then {
            let mut i : i64 = 0i64;
            while true do {
                if i >= e.rule_count then {
                    break;
                };
                e.rules[i].active = false;
                i = i + 1i64;
            };
            e.rule_count = 0i64;
        } else {
            ()
        }

fn engine_add_rule : (*RewriteEngine, i64, i64, i64) -> ()
    | (e, lhs_tag, rhs_tag, priority) ->
        if e != null && e.rule_count < 32i64 then {
            let idx : i64 = e.rule_count;
            e.rules[idx] = rule_new(lhs_tag, rhs_tag, priority);
            e.rule_count = idx + 1i64;
        } else {
            ()
        }

fn engine_sort_rules : *RewriteEngine -> ()
    | e ->
        if e != null && e.rule_count > 1i64 then {
            let mut i : i64 = 0i64;
            while true do {
                if i >= e.rule_count - 1i64 then {
                    break;
                };
                let mut j : i64 = 0i64;
                while true do {
                    if j >= e.rule_count - 1i64 - i then {
                        break;
                    };
                    if e.rules[j].priority < e.rules[j + 1i64].priority then {
                        let tmp = e.rules[j];
                        e.rules[j] = e.rules[j + 1i64];
                        e.rules[j + 1i64] = tmp;
                    } else {
                        ();
                    };
                    j = j + 1i64;
                };
                i = i + 1i64;
            };
        } else {
            ()
        }

fn engine_rewrite_tag : (*RewriteEngine, i64) -> i64
    | (e, input_tag) ->
        if e == null then {
            input_tag
        } else {
            engine_sort_rules(e);
            let mut current_tag : i64 = input_tag;
            let mut steps : i64 = 0i64;
            while true do {
                if steps >= e.max_steps then {
                    break;
                };
                let mut matched : bool = false;
                let mut i : i64 = 0i64;
                while true do {
                    if i >= e.rule_count then {
                        break;
                    };
                    if rule_match_tag(&e.rules[i], current_tag) then {
                        current_tag = e.rules[i].rhs_tag;
                        e.rewrites_performed = e.rewrites_performed + 1i64;
                        matched = true;
                        break;
                    };
                    i = i + 1i64;
                };
                if !matched then {
                    break;
                };
                steps = steps + 1i64;
            };
            current_tag
        }

fn engine_rewrite_loop : (*RewriteEngine, ptr) -> str.string.String
    | (e, input) ->
        let res_tag = engine_rewrite_tag(e, 100i64);
        if res_tag > 0i64 then {
            str.string.from_str("rewrite_done")
        } else {
            str.string.from_str("rewrite_empty")
        }
