mod tui.raw_mode

use os.linux

-- stdlib/tui/raw_mode.pie — Terminal Raw-Mode Control
-- POSIX tcgetattr / tcsetattr via Linux ioctl syscalls for raw TUI input.

struct TermState
  fd          : i64
  saved_flags : ptr

const TCGETS : i64 = 21505i64   -- 0x5401
const TCSETS : i64 = 21506i64   -- 0x5402

const ECHO   : u32 = 8u32
const ICANON : u32 = 2u32
const ISIG   : u32 = 1u32
const IEXTEN : u32 = 32768u32

fn term_get_state : i64 -> TermState
  | fd ->
    let p = os.linux.malloc(64i64)
    os.linux.memset(p, 0i32, 64u64)
    let r = os.linux.ioctl(fd, TCGETS, p)
    if r < 0i64
      os.linux.free(p)
      TermState { fd: fd, saved_flags: 0 as ptr }
    else
      TermState { fd: fd, saved_flags: p }

fn term_restore_state : *TermState -> i64
  | st ->
    if st.saved_flags as i64 == 0i64 then -1i64
    else
      let r = os.linux.ioctl(st.fd, TCSETS, st.saved_flags)
      os.linux.free(st.saved_flags)
      st.saved_flags = 0 as ptr
      r

fn term_enable_raw_mode : i64 -> (TermState, i64)
  | fd ->
    let orig = term_get_state(fd)
    if orig.saved_flags as i64 == 0i64 then (orig, -1i64)
    else
      let raw_p = os.linux.malloc(64i64)
      os.linux.memcpy(raw_p, orig.saved_flags, 64u64)
      -- Turn off ECHO, ICANON, ISIG, IEXTEN in c_lflag (offset 12, u32)
      let lflag_ptr = (raw_p as i64 + 12i64) as *u32
      lflag_ptr[0i64] = lflag_ptr[0i64] & ~(ECHO | ICANON | ISIG | IEXTEN)
      let r = os.linux.ioctl(fd, TCSETS, raw_p)
      os.linux.free(raw_p)
      (orig, r)
