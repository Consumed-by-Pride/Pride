-- §2  TABLE LOOKUP

fn el_pow5 : i64 -> (u64, u64)
  | q ->
    let idx = (q - EL_MIN_POW) * 2i64
    (el_tbl[idx], el_tbl[idx + 1i64])

-- §3  BASE-2 EXPONENT FROM DECIMAL EXPONENT
-- Approximation: log2(10) ≈ 217706/2^16
-- Accurate for all q in [-342, 308]

fn el_power2 : i32 -> i32
  | q -> ((q as i64 *% 152170i64 + 65536i64) >> 16i64) as i32 + 63i32

-- §4  128-BIT PRODUCT APPROXIMATION w × 5^q
-- Returns (lo, hi) of w × pow5[q], handling the need for a second multiplication
-- when the lower bits may be imprecise (lo == 0xFFFFFFFFFFFFFFFF).

fn el_product_approx : (i64, u64, i32) -> (u64, u64)
  | (q, w, precision) ->
    let mask : u64 = if precision < 64i32 then 0xFFFFFFFFFFFFFFFFu64 >> precision as u64 else 0xFFFFFFFFFFFFFFFFu64
    let (pow_lo, pow_hi) = el_pow5(q)
    let first = u128_mul(w, pow_lo)
    let mut lo = first.lo; let mut hi = first.hi
    if hi & mask == mask
      let second = u128_mul(w, pow_hi)
      let new_lo = lo +% second.hi
      if second.hi > new_lo then hi = hi +% 1u64
      lo = new_lo
    (lo, hi)

-- §5  MAIN EISEL-LEMIRE CONVERTER
-- Returns (mantissa, biased_exp, ok): ok=false means slow path needed.
-- Target: f64. Call with mantissa_bits=52, min_exp=-1023.

fn el_convert_f64 : (i64, u64, bool) -> (u64, i32, bool)
  | (q, w_, neg) ->
    el_init()
    if w_ == 0u64 || q < EL_MIN_POW
      (0u64, 0i32, true)
    else if q > EL_MAX_POW
      (0u64, float_info.F64_INFINITE_POWER, true)
    else
      -- Normalize: shift w so MSB is set
      let lz = common.clz64(w_)
      let w = common.shl64(w_, lz)
      let precision = float_info.F64_MANTISSA_EXPLICIT_BITS + 3i32
      let (lo, hi) = el_product_approx(q, w, precision)

      -- Check if lower bits are all-ones (ambiguous rounding region)
      let mask : u64 = if precision < 64i32 then 0xFFFFFFFFFFFFFFFFu64 >> precision as u64 else 0xFFFFFFFFFFFFFFFFu64
      if lo == 0xFFFFFFFFFFFFFFFFu64 && (hi & mask) == mask
        -- Only safe if q outside [-27, 55]
        if q >= -27i64 && q <= 55i64
          (0u64, 0i32, false)   -- signal: use slow path
        else
          -- continue — approximation is still good enough
          let upper_bit = (hi >> 63u64) as i32
          let shift = upper_bit + 64i32 - float_info.F64_MANTISSA_EXPLICIT_BITS - 3i32
          let mut mantissa = common.shr64(hi, shift)
          let mut power2 = el_power2(q as i32) + upper_bit - lz as i32 + float_info.F64_MINIMUM_EXPONENT
          if power2 <= 0i32
            if -power2 + 1i32 >= 64i32 then (0u64, 0i32, true)
            else
              let sub_shift = -power2 + 1i32
              mantissa = common.shr64(mantissa, sub_shift)
              mantissa = mantissa +% (mantissa & 1u64)
              mantissa = mantissa >> 1u64
              let p2 = if mantissa >= (1u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64) then 1i32 else 0i32
              (mantissa & ((1u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64) - 1u64), p2, true)
          else
            -- round-to-even tie check
            let mut m = mantissa
            if lo <= 1u64 &&
               q >= float_info.F64_MIN_EXPONENT_ROUND_TO_EVEN &&
               q <= float_info.F64_MAX_EXPONENT_ROUND_TO_EVEN &&
               m & 3u64 == 1u64 &&
               common.shl64(m, shift) == hi
              m = m & 0xFFFFFFFFFFFFFFFEu64
            m = m +% (m & 1u64)
            m = m >> 1u64
            if m >= (2u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64)
              m = 1u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64
              power2 = power2 + 1i32
            m = m & ((1u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64) - 1u64)
            if power2 >= float_info.F64_INFINITE_POWER
              (0u64, float_info.F64_INFINITE_POWER, true)
            else
              (m, power2, true)
      else
        let upper_bit = (hi >> 63u64) as i32
        let shift = upper_bit + 64i32 - float_info.F64_MANTISSA_EXPLICIT_BITS - 3i32
        let mut mantissa = common.shr64(hi, shift)
        let mut power2 = el_power2(q as i32) + upper_bit - lz as i32 + float_info.F64_MINIMUM_EXPONENT
        if power2 <= 0i32
          if -power2 + 1i32 >= 64i32 then (0u64, 0i32, true)
          else
            let sub_shift = -power2 + 1i32
            mantissa = common.shr64(mantissa, sub_shift)
            mantissa = mantissa +% (mantissa & 1u64)
            mantissa = mantissa >> 1u64
            let p2 = if mantissa >= (1u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64) then 1i32 else 0i32
            (mantissa & ((1u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64) - 1u64), p2, true)
        else
          let mut m = mantissa
          if lo <= 1u64 &&
             q >= float_info.F64_MIN_EXPONENT_ROUND_TO_EVEN &&
             q <= float_info.F64_MAX_EXPONENT_ROUND_TO_EVEN &&
             m & 3u64 == 1u64 &&
             common.shl64(m, shift) == hi
            m = m & 0xFFFFFFFFFFFFFFFEu64
          m = m +% (m & 1u64)
          m = m >> 1u64
          if m >= (2u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64)
            m = 1u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64
            power2 = power2 + 1i32
          m = m & ((1u64 << float_info.F64_MANTISSA_EXPLICIT_BITS as u64) - 1u64)
          if power2 >= float_info.F64_INFINITE_POWER
            (0u64, float_info.F64_INFINITE_POWER, true)
          else
            (m, power2, true)

-- §6  F32 VARIANT
-- Same algorithm but with f32 constants.

fn el_convert_f32 : (i64, u64, bool) -> (u32, i32, bool)
  | (q, w_, neg) ->
    el_init()
    if w_ == 0u64 || q < float_info.F32_SMALLEST_POWER_OF_TEN
      (0u32, 0i32, true)
    else if q > float_info.F32_LARGEST_POWER_OF_TEN
      (0u32, float_info.F32_INFINITE_POWER, true)
    else
      let lz = common.clz64(w_)
      let w = common.shl64(w_, lz)
      let precision = float_info.F32_MANTISSA_EXPLICIT_BITS + 3i32
      let (lo, hi) = el_product_approx(q, w, precision)
      if lo == 0xFFFFFFFFFFFFFFFFu64
        if q >= -17i64 && q <= 10i64 then (0u32, 0i32, false)
        else
          let upper_bit = (hi >> 63u64) as i32
          let shift = upper_bit + 64i32 - float_info.F32_MANTISSA_EXPLICIT_BITS - 3i32
          let mut mantissa = common.shr64(hi, shift) as u32
          let mut power2 = el_power2(q as i32) + upper_bit - lz as i32 + float_info.F32_MINIMUM_EXPONENT
          if power2 <= 0i32
            if -power2 + 1i32 >= 32i32 then (0u32, 0i32, true)
            else
              mantissa = mantissa >> (-power2 + 1i32) as u32
              mantissa = mantissa +% (mantissa & 1u32)
              mantissa = mantissa >> 1u32
              let p2 = if mantissa >= (1u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32) then 1i32 else 0i32
              (mantissa & ((1u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32) - 1u32), p2, true)
          else
            mantissa = mantissa +% (mantissa & 1u32)
            mantissa = mantissa >> 1u32
            if mantissa >= (2u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32)
              mantissa = 1u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32
              power2 = power2 + 1i32
            mantissa = mantissa & ((1u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32) - 1u32)
            if power2 >= float_info.F32_INFINITE_POWER then (0u32, float_info.F32_INFINITE_POWER, true)
            else (mantissa, power2, true)
      else
        let upper_bit = (hi >> 63u64) as i32
        let shift = upper_bit + 64i32 - float_info.F32_MANTISSA_EXPLICIT_BITS - 3i32
        let mut mantissa = common.shr64(hi, shift) as u32
        let mut power2 = el_power2(q as i32) + upper_bit - lz as i32 + float_info.F32_MINIMUM_EXPONENT
        if power2 <= 0i32
          if -power2 + 1i32 >= 32i32 then (0u32, 0i32, true)
          else
            mantissa = mantissa >> (-power2 + 1i32) as u32
            mantissa = mantissa +% (mantissa & 1u32)
            mantissa = mantissa >> 1u32
            let p2 = if mantissa >= (1u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32) then 1i32 else 0i32
            (mantissa & ((1u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32) - 1u32), p2, true)
        else
          mantissa = mantissa +% (mantissa & 1u32)
          mantissa = mantissa >> 1u32
          if mantissa >= (2u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32)
            mantissa = 1u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32
            power2 = power2 + 1i32
          mantissa = mantissa & ((1u32 << float_info.F32_MANTISSA_EXPLICIT_BITS as u32) - 1u32)
          if power2 >= float_info.F32_INFINITE_POWER then (0u32, float_info.F32_INFINITE_POWER, true)
          else (mantissa, power2, true)