mod fmt.parse_float.convert_eisel_lemire

use fmt.parse_float.common
use fmt.parse_float.float_info

-- Eisel-Lemire fast float parse algorithm.
-- Daniel Lemire, 'Number Parsing at a Gigabyte per Second' (2021)
-- https://arxiv.org/abs/2101.11408
-- Handles ~99.9% of decimal floats in 1-2 multiplications.
-- Falls back to decimal.pie for near-halfway cases.

-- §1  PRE-COMPUTED 128-BIT POWERS OF FIVE TABLE
-- 651 entries covering 5^-342 through 5^308.
-- Each entry: two u64 values (lo, hi) of the 128-bit approximation.
-- The table is heap-initialized on first use to avoid BSS segment bloat.

const EL_MIN_POW  : i64 = -342i64
const EL_MAX_POW  : i64 = 308i64
const EL_N_ENTRIES : i64 = 651i64

let el_tbl      : *u64 = 0 as *u64
let el_tbl_init : bool = false

fn el_init : () -> ()
  | () ->
    if el_tbl_init then ()
    else
      let tbl = os.linux.malloc(10416i64) as *u64
      tbl[0i64]   = 0xeef453d6923bd65au64
