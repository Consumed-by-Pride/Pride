mod async

use async.task
use async.reactor
use async.io_uring_rt

-- stdlib/async.pie — Standard Library Asynchronous I/O and Event-Loop Suite
-- Exports cooperative tasks/futures, Epoll reactors, and io_uring runtime engines.

-- Task
fn task_new : i64 -> task.Task                       | id -> task.task_new(id)
fn task_poll : *task.Task -> bool                    | t -> task.task_poll(t)
fn task_complete : (*task.Task, i64) -> ()           | (t, r) -> task.task_complete(t, r)

-- Reactor
fn reactor_new : i64 -> reactor.Reactor              | max -> reactor.reactor_new(max)
fn reactor_destroy : *reactor.Reactor -> ()          | r -> reactor.reactor_destroy(r)
fn reactor_add : (*reactor.Reactor, i64, u32) -> i64 | (r, f, m) -> reactor.reactor_add(r, f, m)
fn reactor_del : (*reactor.Reactor, i64) -> i64      | (r, f) -> reactor.reactor_del(r, f)
fn reactor_step : (*reactor.Reactor, i64) -> i64     | (r, t) -> reactor.reactor_step(r, t)

-- io_uring runtime
fn uring_new : u32 -> io_uring_rt.IoUringRt          | e -> io_uring_rt.uring_rt_new(e)
fn uring_destroy : *io_uring_rt.IoUringRt -> ()      | u -> io_uring_rt.uring_rt_destroy(u)
fn uring_submit : *io_uring_rt.IoUringRt -> i64      | u -> io_uring_rt.uring_rt_submit(u)
fn uring_poll : (*io_uring_rt.IoUringRt, u32) -> i64 | (u, m) -> io_uring_rt.uring_rt_poll(u, m)
