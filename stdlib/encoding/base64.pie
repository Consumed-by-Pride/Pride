mod encoding.base64

use os.linux
use str.string

-- stdlib/encoding/base64.pie — Standard and URL-Safe Base64 Encoding/Decoding
-- Converts binary buffers to Base64/Base64URL text and decodes back to bytes.

fn base64_encode_slice : (ptr, i64, bool) -> string.String
  | (data, len, url_safe) ->
    let table = if url_safe then
                  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_" as *u8
                else
                  "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" as *u8
    let out_cap = ((len + 2i64) / 3i64) * 4i64
    let mut out = string.string_with_cap(out_cap)
    let buf = data as *u8
    let mut i : i64 = 0i64
    while i < len
      let b0 = buf[i] as i64
      let b1 = if i + 1i64 < len then buf[i + 1i64] as i64 else 0i64
      let b2 = if i + 2i64 < len then buf[i + 2i64] as i64 else 0i64

      let triple = (b0 << 16i64) | (b1 << 8i64) | b2
      string.string_push_byte(&out, table[(triple >> 18i64) & 0x3Fi64])
      string.string_push_byte(&out, table[(triple >> 12i64) & 0x3Fi64])

      if i + 1i64 < len
        string.string_push_byte(&out, table[(triple >> 6i64) & 0x3Fi64])
      else if !url_safe
        string.string_push_byte(&out, 61u8)   -- '='

      if i + 2i64 < len
        string.string_push_byte(&out, table[triple & 0x3Fi64])
      else if !url_safe
        string.string_push_byte(&out, 61u8)   -- '='

      i = i + 3i64
    out

fn b64_char_to_val : u8 -> i64
  | c ->
    if c >= 65u8 && c <= 90u8 then (c as i64 - 65i64)
    else if c >= 97u8 && c <= 122u8 then (c as i64 - 71i64)
    else if c >= 48u8 && c <= 57u8 then (c as i64 + 4i64)
    else if c == 43u8 || c == 45u8 then 62i64
    else if c == 47u8 || c == 95u8 then 63i64
    else -1i64

fn base64_decode_slice : (ptr, i64) -> (ptr, i64, bool)
  | (b64_str, len) ->
    let max_out = (len / 4i64) * 3i64
    let out_buf = os.linux.malloc(max_out + 4i64) as *u8
    let in_buf  = b64_str as *u8
    let mut i : i64 = 0i64
    let mut out_len : i64 = 0i64
    let mut ok = true
    while i < len
      if in_buf[i] == 61u8   -- '=' padding
        break
      let v0 = b64_char_to_val(in_buf[i])
      let v1 = if i + 1i64 < len && in_buf[i + 1i64] != 61u8 then b64_char_to_val(in_buf[i + 1i64]) else 0i64
      let v2 = if i + 2i64 < len && in_buf[i + 2i64] != 61u8 then b64_char_to_val(in_buf[i + 2i64]) else 0i64
      let v3 = if i + 3i64 < len && in_buf[i + 3i64] != 61u8 then b64_char_to_val(in_buf[i + 3i64]) else 0i64
      if v0 < 0i64 || v1 < 0i64
        ok = false
        break
      let triple = (v0 << 18i64) | (v1 << 12i64) | (v2 << 6i64) | v3
      out_buf[out_len] = ((triple >> 16i64) & 0xFFi64) as u8
      out_len = out_len + 1i64
      if i + 2i64 < len && in_buf[i + 2i64] != 61u8
        out_buf[out_len] = ((triple >> 8i64) & 0xFFi64) as u8
        out_len = out_len + 1i64
      if i + 3i64 < len && in_buf[i + 3i64] != 61u8
        out_buf[out_len] = (triple & 0xFFi64) as u8
        out_len = out_len + 1i64
      i = i + 4i64
    if !ok
      os.linux.free(out_buf as ptr)
      (0 as ptr, 0i64, false)
    else
      (out_buf as ptr, out_len, true)
