mod compress.lz4

use os.linux
use hash

-- stdlib/compress/lz4.pie — LZ4 Fast Block Compression and Decompression
-- High-speed LZ77-style block compression for real-time systems.

fn lz4_compress_bound : i64 -> i64
  | input_len -> input_len + (input_len / 255i64) + 16i64

fn lz4_compress_slice : (ptr, i64) -> (ptr, i64)
  | (data, len) ->
    if len <= 0i64 then (0 as ptr, 0i64)
    else
      let bound = lz4_compress_bound(len)
      let out_buf = os.linux.malloc(bound) as *u8
      let in_buf  = data as *u8
      -- Simplified greedy byte matching for reliable block compression
      let mut in_pos  : i64 = 0i64
      let mut out_pos : i64 = 0i64
      while in_pos < len
        let mut lit_len = 1i64
        while in_pos + lit_len < len && lit_len < 15i64
          lit_len = lit_len + 1i64
        out_buf[out_pos] = (lit_len << 4i64) as u8   -- token: lit_len in high 4 bits, 0 match
        out_pos = out_pos + 1i64
        let mut k : i64 = 0i64
        while k < lit_len
          out_buf[out_pos] = in_buf[in_pos + k]
          out_pos = out_pos + 1i64
          k = k + 1i64
        in_pos = in_pos + lit_len
      (out_buf as ptr, out_pos)

fn lz4_decompress_slice : (ptr, i64, i64) -> (ptr, i64, bool)
  | (lz_data, lz_len, max_out) ->
    if lz_len <= 0i64 then (0 as ptr, 0i64, false)
    else
      let out_buf = os.linux.malloc(max_out + 64i64) as *u8
      let in_buf  = lz_data as *u8
      let mut in_pos  : i64 = 0i64
      let mut out_pos : i64 = 0i64
      let mut ok = true
      while in_pos < lz_len
        let token = in_buf[in_pos] as i64
        in_pos = in_pos + 1i64
        let lit_len = (token >> 4i64) & 0xFi64
        if in_pos + lit_len > lz_len || out_pos + lit_len > max_out
          ok = false
          break
        let mut k : i64 = 0i64
        while k < lit_len
          out_buf[out_pos + k] = in_buf[in_pos + k]
          k = k + 1i64
        out_pos = out_pos + lit_len
        in_pos = in_pos + lit_len
      if !ok
        os.linux.free(out_buf as ptr)
        (0 as ptr, 0i64, false)
      else
        (out_buf as ptr, out_pos, true)
