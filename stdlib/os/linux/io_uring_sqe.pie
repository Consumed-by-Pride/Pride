-- §8  VALIDATION FUNCTION (input checking per constraint)

fn sqe_op_needs_fd : u8 -> bool
  | op ->
    op != IORING_OP_NOP &&
    op != IORING_OP_TIMEOUT &&
    op != IORING_OP_TIMEOUT_REMOVE &&
    op != IORING_OP_ASYNC_CANCEL &&
    op != IORING_OP_MADVISE

fn sqe_check_reserved : (*IoUringSqe) -> bool
  | sqe -> sqe.resv == 0u64

fn sqe_check_opcode_range : u8 -> bool
  | op -> op < IORING_OP_LAST

fn sqe_full_validate : (*IoUringSqe) -> (bool, *u8)
  | sqe ->
    if !sqe_check_opcode_range(sqe.opcode)
      (false, "invalid opcode" as *u8)
    else if !sqe_check_reserved(sqe)
      (false, "reserved field must be zero" as *u8)
    else if sqe_op_needs_fd(sqe.opcode) && sqe.fd < -1i32
      (false, "invalid fd" as *u8)
    else
      (true, 0 as *u8)

