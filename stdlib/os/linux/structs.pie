-- §31  CPU SET

const CPU_SETSIZE    : i64 = 128i64   -- bytes
const CPU_SET_NWORDS : i64 = 16i64   -- 128 bytes / 8 bytes per word

-- cpu_set_t is CPU_SETSIZE bytes of bitmask
-- We represent it as a heap-allocated *u64[16]

fn cpuset_new : () -> *u64
  | () ->
    let s = os.linux.malloc(CPU_SETSIZE) as *u64
    os.linux.memset(s as ptr, 0i32, CPU_SETSIZE as u64)
    s

fn cpuset_free : *u64 -> () | s -> os.linux.free(s as ptr)

fn cpuset_set : (*u64, i64) -> ()
  | (s, cpu) ->
    if cpu >= 0i64 && cpu < CPU_SETSIZE * 8i64
      s[cpu / 64i64] = s[cpu / 64i64] | (1u64 << (cpu % 64i64) as u64)

fn cpuset_clr : (*u64, i64) -> ()
  | (s, cpu) ->
    if cpu >= 0i64 && cpu < CPU_SETSIZE * 8i64
      s[cpu / 64i64] = s[cpu / 64i64] & !(1u64 << (cpu % 64i64) as u64)

fn cpuset_isset : (*u64, i64) -> bool
  | (s, cpu) ->
    if cpu < 0i64 || cpu >= CPU_SETSIZE * 8i64 then false
    else (s[cpu / 64i64] >> (cpu % 64i64) as u64) & 1u64 != 0u64

fn cpuset_count : *u64 -> i64
  | s ->
    let mut count : i64 = 0i64; let mut i : i64 = 0i64
    while i < CPU_SET_NWORDS
      let mut w = s[i]; while w != 0u64 then count = count + 1i64; w = w & (w -% 1u64)
      i = i + 1i64
    count

fn cpuset_zero : *u64 -> () | s -> os.linux.memset(s as ptr, 0i32, CPU_SETSIZE as u64); ()
fn cpuset_fill : *u64 -> () | s -> os.linux.memset(s as ptr, 0xFFi32, CPU_SETSIZE as u64); ()

