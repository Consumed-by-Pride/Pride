-- §11  UTSNAME

struct Utsname
  sysname    : u8   -- 65 bytes
  nodename   : u8   -- 65 bytes  (at offset 65)
  release    : u8   -- 65 bytes  (at offset 130)
  version    : u8   -- 65 bytes  (at offset 195)
  machine    : u8   -- 65 bytes  (at offset 260)
  domainname : u8   -- 65 bytes  (at offset 325)
  -- total: 390 bytes

const UTSNAME_FIELD_LEN : i64 = 65i64

fn utsname_sysname    : *Utsname -> *u8 | u -> u as *u8
fn utsname_nodename   : *Utsname -> *u8 | u -> (u as i64 + 65i64)  as *u8
fn utsname_release    : *Utsname -> *u8 | u -> (u as i64 + 130i64) as *u8
fn utsname_version    : *Utsname -> *u8 | u -> (u as i64 + 195i64) as *u8
fn utsname_machine    : *Utsname -> *u8 | u -> (u as i64 + 260i64) as *u8
fn utsname_domainname : *Utsname -> *u8 | u -> (u as i64 + 325i64) as *u8

-- §12  RLIMIT

struct Rlimit
  cur : u64   -- RLIM_INFINITY = 0xFFFFFFFFFFFFFFFF
  max : u64

const RLIM_INFINITY : u64 = 18446744073709551615u64   -- 0xFFFFFFFFFFFFFFFF

-- §13  RUSAGE

struct Rusage
