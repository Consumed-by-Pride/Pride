mod os.linux.structs

-- Linux kernel data structures — ABI-stable types for x86-64.
-- Linux kernel ABI struct definitions for x86-64.
-- These are the types passed to/from the kernel via syscall pointers.
-- All sizes and offsets match the Linux 6.x x86-64 kernel ABI.

-- §1  TIME TYPES

struct Timespec
  sec  : i64
  nsec : i64

struct Timeval
  sec  : i64
  usec : i64

struct Timezone
  minuteswest : i32
  dsttime     : i32

struct ItimerSpec
  interval : Timespec
  value    : Timespec

struct ItimerVal
  interval : Timeval
  value    : Timeval

-- §2  FILE SYSTEM TYPES

-- stat(2) result — x86-64 layout (matches struct stat in sys/stat.h)
struct Stat
  dev       : u64
  ino       : u64
  nlink     : u64
  mode      : u32
  uid       : u32
  gid       : u32
  __pad0    : u32
  rdev      : u64
  size      : i64
  blksize   : i64
  blocks    : i64
  atim_sec  : i64
  atim_nsec : i64
  mtim_sec  : i64
  mtim_nsec : i64
  ctim_sec  : i64
  ctim_nsec : i64
  __unused0 : i64
  __unused1 : i64
  __unused2 : i64

-- statx(2) result — kernel 4.11+
struct StatxTimestamp
  sec  : i64
  nsec : u32
  pad  : i32

struct Statx
  mask             : u32
  blksize          : u32
  attributes       : u64
  nlink            : u32
  uid              : u32
  gid              : u32
  mode             : u16
  __spare0         : u16
  ino              : u64
  size             : u64
  blocks           : u64
  attributes_mask  : u64
  atime            : StatxTimestamp
  btime            : StatxTimestamp
  ctime            : StatxTimestamp
  mtime            : StatxTimestamp
  rdev_major       : u32
  rdev_minor       : u32
  dev_major        : u32
  dev_minor        : u32
  mnt_id           : u64
  dio_mem_align    : u32
  dio_offset_align : u32
  __spare2         : u64
  __spare3         : u64
  __spare4         : u64
  __spare5         : u64
  __spare6         : u64
  __spare7         : u64
  __spare8         : u64

-- statfs(2) result
struct Statfs
  type     : i64
  bsize    : i64
  blocks   : u64
  bfree    : u64
  bavail   : u64
  files    : u64
  ffree    : u64
  fsid_lo  : i32
  fsid_hi  : i32
  namelen  : i64
  frsize   : i64
  flags    : i64
  spare0   : i64
  spare1   : i64
  spare2   : i64
  spare3   : i64

-- dirent64 — getdents64(2) entry
struct Dirent64
  ino    : u64
  off    : u64
  reclen : u16
  type_  : u8
  name   : u8   -- first byte of null-terminated name; walk +sizeof(Dirent64) to get name string

-- §3  SOCKET TYPES

const SOCKADDR_DATA_LEN : i64 = 14i64
const SOCKADDR_STORAGE_SIZE : i64 = 128i64

struct Sockaddr
  family : u16
  data   : u8   -- 14 bytes follow; access via specific subtypes below

-- IPv4
struct SockaddrIn
  family : u16   -- AF_INET = 2
  port   : u16   -- big-endian
  addr   : u32   -- big-endian IPv4 address
  zero   : u64   -- 8 zero bytes padding

-- IPv6
struct SockaddrIn6
  family   : u16   -- AF_INET6 = 10
  port     : u16
  flowinfo : u32
  addr     : u8   -- 16 bytes follow
  scope_id : u32

-- Unix domain socket
struct SockaddrUn
  family : u16   -- AF_UNIX = 1
  path   : u8    -- 108 bytes follow (null-terminated path)

-- Packet socket (AF_PACKET)
struct SockaddrLl
  family   : u16
  protocol : u16
  ifindex  : i32
  hatype   : u16
  pkttype  : u8
  halen    : u8
  addr     : u64   -- 8 bytes

-- Netlink socket
struct SockaddrNl
  family : u16
  pad1   : u16
  pid    : u32
  groups : u32

-- XDP socket
struct SockaddrXdp
  family         : u16
  flags          : u16
  ifindex        : u32
  queue_id       : u32
  shared_umem_fd : u32

-- Vsock
struct SockaddrVm
  family    : u16
  reserved1 : u16
  port      : u32
  cid       : u32
  flags     : u8
  zero      : u32   -- 3 padding bytes as u24 effectively

-- §4  MSGHDR / CMSG

struct IoVec
  base : ptr
  len  : u64

struct Msghdr
  name       : ptr    -- *Sockaddr
  namelen    : u32
  __pad1     : u32
  iov        : ptr    -- *IoVec
  iovlen     : u64
  control    : ptr
  controllen : u64
  flags      : i32
  __pad2     : i32

struct MmsghdrHdr
  hdr : Msghdr
  len : u32
  __pad : u32

struct Cmsghdr
  len   : u64
  level : i32
  type_ : i32
  -- data follows immediately after

-- §5  EPOLL

struct EpollEvent
  events : u32
  __pad  : u32   -- x86-64 alignment pad
  data   : u64   -- union: ptr(usize) | fd(i32) | u32 | u64 — we expose as u64

fn epoll_data_fd : u64 -> i32  | d -> (d & 0xFFFFFFFFu64) as i32
fn epoll_data_u32 : u64 -> u32 | d -> (d & 0xFFFFFFFFu64) as u32
fn epoll_data_u64 : u64 -> u64 | d -> d
fn epoll_make_data_fd  : i32 -> u64 | fd -> fd as u64 & 0xFFFFFFFFu64
fn epoll_make_data_u64 : u64 -> u64 | v -> v

-- §6  INOTIFY

struct InotifyEvent
  wd     : i32
  mask   : u32
  cookie : u32
  len    : u32
  -- name follows: [len]u8 (null-terminated, padded to multiple of 4)

