-- NLMSG alignment helpers
fn nlmsg_align   : i64 -> i64 | n -> (n + 3i64) & -4i64
fn nlmsg_hdrlen  : () -> i64  | () -> nlmsg_align(16i64)   -- sizeof(NlMsgHdr) = 16
fn nlmsg_length  : i64 -> i32 | len -> (nlmsg_hdrlen() + len) as i32
fn nlmsg_ok      : (*NlMsgHdr, i64) -> bool | (nlh, len) -> len >= 16i64 && nlh.len >= 16u32 && nlh.len as i64 <= len
fn nlmsg_next    : (*NlMsgHdr, i64) -> *NlMsgHdr | (nlh, len) ->
    (nlh as i64 + nlmsg_align(nlh.len as i64)) as *NlMsgHdr
fn nla_data      : *NlAttr -> ptr | nla -> (nla as i64 + 4i64) as ptr
fn nla_len       : *NlAttr -> i64 | nla -> nla.len as i64 - 4i64

