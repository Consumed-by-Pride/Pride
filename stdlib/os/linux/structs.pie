-- §14  SIGINFO

struct SiginfoFields   -- simplified — full siginfo_t is a union
  signo : i32
  errno_ : i32
  code   : i32
  __pad0  : i32
  -- union follows — we expose as raw bytes
  data   : u8   -- 112 bytes follow

const SI_MAX_SIZE : i64 = 128i64

-- SI_CODE values
const SI_USER     : i32 = 0i32
const SI_KERNEL   : i32 = 128i32
const SI_QUEUE    : i32 = -1i32
const SI_TIMER    : i32 = -2i32
const SI_MESGQ    : i32 = -3i32
const SI_ASYNCIO  : i32 = -4i32
const SI_SIGIO    : i32 = -5i32
const SI_TKILL    : i32 = -6i32
const SI_DETHREAD : i32 = -7i32
const SI_ASYNCNL  : i32 = -60i32

-- §15  SIGSET

const NSIG       : i64 = 64i64
const SIGSET_NWORDS : i64 = 2i64   -- 64 bits / 32 bits per word = 2 words for 64 signals

struct Sigset
  lo : u64   -- signals 1..64 — we use a single u64 on x86-64 (kernel uses 2 × u32)
  hi : u64   -- reserved / RT signals 33..64 for compat

fn sigset_empty  : () -> Sigset | () -> Sigset { lo: 0u64, hi: 0u64 }
fn sigset_full   : () -> Sigset | () -> Sigset { lo: 0xFFFFFFFFFFFFFFFFu64, hi: 0xFFFFFFFFFFFFFFFFu64 }
fn sigset_add    : (*Sigset, i64) -> () | (s, sig) -> if sig >= 1i64 && sig <= 64i64 then s.lo = s.lo | (1u64 << (sig - 1i64) as u64)
fn sigset_del    : (*Sigset, i64) -> () | (s, sig) -> if sig >= 1i64 && sig <= 64i64 then s.lo = s.lo & !(1u64 << (sig - 1i64) as u64)
fn sigset_has    : (*Sigset, i64) -> bool | (s, sig) -> if sig < 1i64 || sig > 64i64 then false else (s.lo >> (sig - 1i64) as u64) & 1u64 != 0u64
fn sigset_or     : (*Sigset, *Sigset) -> Sigset | (a, b) -> Sigset { lo: a.lo | b.lo, hi: a.hi | b.hi }
fn sigset_and    : (*Sigset, *Sigset) -> Sigset | (a, b) -> Sigset { lo: a.lo & b.lo, hi: a.hi & b.hi }
fn sigset_not    : *Sigset -> Sigset | s -> Sigset { lo: !s.lo, hi: !s.hi }

-- §16  SIGACTION

struct KSigaction
  handler   : ptr    -- fn(i32)->() or fn(i32,ptr,ptr)->()
  flags     : u64
  restorer  : ptr    -- required on x86-64 for SA_RESTORER
  mask      : Sigset

