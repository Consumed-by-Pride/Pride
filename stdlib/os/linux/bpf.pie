-- §16  BPF ATTRIBUTE UNION (the attr argument to bpf(2))
-- We model it as a raw byte array (128 bytes) + typed accessors.
-- The bpf(2) syscall uses a union — callers zero-fill and set relevant fields.

struct BpfMapCreateAttr
  map_type     : u32
  key_size     : u32
  value_size   : u32
  max_entries  : u32
  map_flags    : u32
  inner_map_fd : u32
  numa_node    : u32
  map_name     : u8   -- 16 bytes (BPF_OBJ_NAME_LEN)
  map_ifindex  : u32
  btf_fd       : u32
  btf_key_type_id    : u32
  btf_value_type_id  : u32
  btf_vmlinux_value_type_id : u32
  map_extra    : u64

struct BpfMapElemAttr
  map_fd   : u32
  __pad0   : u32
  key      : u64
  value_or_next_key : u64
  flags    : u64

struct BpfProgLoadAttr
  prog_type         : u32
  insn_cnt          : u32
  insns             : u64   -- ptr to Insn[]
  license           : u64   -- ptr to *u8
  log_level         : u32
  log_size          : u32
  log_buf           : u64   -- ptr to u8[]
  kern_version      : u32
  prog_flags        : u32
  prog_name         : u8    -- 16 bytes
  prog_ifindex      : u32
  expected_attach_type : u32
  prog_btf_fd       : u32
  func_info_rec_size : u32
  func_info         : u64
  func_info_cnt     : u32
  line_info_rec_size : u32
  line_info         : u64
  line_info_cnt     : u32
  attach_btf_id     : u32
  attach_prog_fd    : u32
  core_relo_cnt     : u32
  fd_array          : u64
  core_relos        : u64
  core_relo_rec_size : u32

-- §17  XDP RETURN CODES
const XDP_ABORTED : u32 = 0u32
const XDP_DROP    : u32 = 1u32
const XDP_PASS    : u32 = 2u32
const XDP_TX      : u32 = 3u32
const XDP_REDIRECT: u32 = 4u32

-- §18  SYSCALL WRAPPERS

fn bpf_map_create : (u32, u32, u32, u32, u32) -> i64
  | (map_type, key_size, value_size, max_entries, flags) ->
    let attr = os.linux.malloc(128i64) as *u32
    os.linux.memset(attr as ptr, 0i32, 128u64)
    attr[0u32] = map_type
    attr[1u32] = key_size
    attr[2u32] = value_size
    attr[3u32] = max_entries
    attr[4u32] = flags
    let fd = os.linux.bpf(MAP_CREATE as i64, attr as ptr, 128i64)
    os.linux.free(attr as ptr); fd

fn bpf_map_lookup : (i64, ptr, ptr) -> i64
  | (map_fd, key, value) ->
    let attr = os.linux.malloc(32i64) as *u64
    os.linux.memset(attr as ptr, 0i32, 32u64)
    (attr as *u32)[0u32] = map_fd as u32
    attr[1i64] = key as u64; attr[2i64] = value as u64; attr[3i64] = 0u64
    let r = os.linux.bpf(MAP_LOOKUP_ELEM as i64, attr as ptr, 32i64)
    os.linux.free(attr as ptr); r

fn bpf_map_update : (i64, ptr, ptr, u64) -> i64
  | (map_fd, key, value, flags) ->
    let attr = os.linux.malloc(32i64) as *u64
    os.linux.memset(attr as ptr, 0i32, 32u64)
    (attr as *u32)[0u32] = map_fd as u32
    attr[1i64] = key as u64; attr[2i64] = value as u64; attr[3i64] = flags
    let r = os.linux.bpf(MAP_UPDATE_ELEM as i64, attr as ptr, 32i64)
    os.linux.free(attr as ptr); r

fn bpf_map_delete : (i64, ptr) -> i64
  | (map_fd, key) ->
    let attr = os.linux.malloc(32i64) as *u64
    os.linux.memset(attr as ptr, 0i32, 32u64)
    (attr as *u32)[0u32] = map_fd as u32
    attr[1i64] = key as u64
    let r = os.linux.bpf(MAP_DELETE_ELEM as i64, attr as ptr, 32i64)
    os.linux.free(attr as ptr); r

fn bpf_map_get_next_key : (i64, ptr, ptr) -> i64
  | (map_fd, key, next_key) ->
    let attr = os.linux.malloc(32i64) as *u64
    os.linux.memset(attr as ptr, 0i32, 32u64)
    (attr as *u32)[0u32] = map_fd as u32
    attr[1i64] = key as u64; attr[2i64] = next_key as u64
    let r = os.linux.bpf(MAP_GET_NEXT_KEY as i64, attr as ptr, 32i64)
    os.linux.free(attr as ptr); r

fn bpf_prog_load : (u32, ptr, u32, ptr, u32, ptr, u32, u32, u32) -> i64
  | (prog_type, insns, insn_cnt, license, log_level, log_buf, log_size, kern_version, flags) ->
    let attr_sz : i64 = 128i64
    let attr = os.linux.malloc(attr_sz) as *u32
    os.linux.memset(attr as ptr, 0i32, attr_sz as u64)
    attr[0u32] = prog_type
    attr[1u32] = insn_cnt
    (attr as *u64)[1i64] = insns as u64
    (attr as *u64)[2i64] = license as u64
    attr[6u32] = log_level
    attr[7u32] = log_size
    (attr as *u64)[4i64] = log_buf as u64
    attr[10u32] = kern_version
    attr[11u32] = flags
    let fd = os.linux.bpf(PROG_LOAD as i64, attr as ptr, attr_sz)
    os.linux.free(attr as ptr); fd

fn bpf_prog_load_simple : (u32, ptr, u32, ptr) -> i64
  | (prog_type, insns, insn_cnt, license) ->
    bpf_prog_load(prog_type, insns, insn_cnt, license, 0u32, 0 as ptr, 0u32, 0u32, 0u32)

fn bpf_obj_pin : (i64, ptr) -> i64
  | (fd, path) ->
    let attr = os.linux.malloc(24i64) as *u64
    os.linux.memset(attr as ptr, 0i32, 24u64)
    (attr as *u32)[0u32] = fd as u32
    attr[1i64] = path as u64
    let r = os.linux.bpf(OBJ_PIN as i64, attr as ptr, 24i64)
    os.linux.free(attr as ptr); r

fn bpf_obj_get : ptr -> i64
  | path ->
    let attr = os.linux.malloc(16i64) as *u64
    os.linux.memset(attr as ptr, 0i32, 16u64)
    attr[1i64] = path as u64
    let r = os.linux.bpf(OBJ_GET as i64, attr as ptr, 16i64)
    os.linux.free(attr as ptr); r

fn bpf_prog_attach : (i64, i64, u32, u32) -> i64
  | (prog_fd, target_fd, attach_type, flags) ->
    let attr = os.linux.malloc(16i64) as *u32
    os.linux.memset(attr as ptr, 0i32, 16u64)
    attr[0u32] = target_fd as u32
    attr[1u32] = prog_fd as u32
    attr[2u32] = attach_type
    attr[3u32] = flags
    let r = os.linux.bpf(PROG_ATTACH as i64, attr as ptr, 16i64)
    os.linux.free(attr as ptr); r

fn bpf_prog_detach : (i64, u32) -> i64
  | (target_fd, attach_type) ->
    let attr = os.linux.malloc(16i64) as *u32
    os.linux.memset(attr as ptr, 0i32, 16u64)
    attr[0u32] = target_fd as u32
    attr[2u32] = attach_type
    let r = os.linux.bpf(PROG_DETACH as i64, attr as ptr, 16i64)
    os.linux.free(attr as ptr); r

fn bpf_map_freeze : i64 -> i64
  | map_fd ->
    let attr = os.linux.malloc(8i64) as *u32
    attr[0u32] = map_fd as u32
    let r = os.linux.bpf(MAP_FREEZE as i64, attr as ptr, 4i64)
    os.linux.free(attr as ptr); r