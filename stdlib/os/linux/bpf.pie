-- §8  eBPF INSTRUCTION (64-bit)
-- opcode | dst_reg:4 | src_reg:4 | offset:16 | imm:32
struct Insn
  code    : u8
  regs    : u8    -- dst(3:0) | src(7:4)
  off     : i16
  imm     : i32

fn insn_dst : *Insn -> u8 | i -> i.regs & 0xFu8
fn insn_src : *Insn -> u8 | i -> (i.regs >> 4u8) & 0xFu8
fn insn_make_regs : (u8, u8) -> u8 | (dst, src) -> (src << 4u8) | (dst & 0xFu8)

-- §9  REGISTER NAMES
const R0  : u8 = 0u8   -- return value / caller-saved
const R1  : u8 = 1u8   -- fn arg 1 / caller-saved
const R2  : u8 = 2u8   -- fn arg 2
const R3  : u8 = 3u8   -- fn arg 3
const R4  : u8 = 4u8   -- fn arg 4
const R5  : u8 = 5u8   -- fn arg 5
const R6  : u8 = 6u8   -- callee-saved
const R7  : u8 = 7u8   -- callee-saved
const R8  : u8 = 8u8   -- callee-saved
const R9  : u8 = 9u8   -- callee-saved
const R10 : u8 = 10u8  -- frame pointer (read-only)
const FP  : u8 = 10u8

-- §10  INSTRUCTION CLASS BITS
const CLS_LD    : u8 = 0x00u8
const CLS_LDX   : u8 = 0x01u8
const CLS_ST    : u8 = 0x02u8
const CLS_STX   : u8 = 0x03u8
const CLS_ALU   : u8 = 0x04u8
const CLS_JMP   : u8 = 0x05u8
const CLS_JMP32 : u8 = 0x06u8
const CLS_ALU64 : u8 = 0x07u8

-- §11  ALU OPERATION CODES
const ALU_ADD  : u8 = 0x00u8
const ALU_SUB  : u8 = 0x10u8
const ALU_MUL  : u8 = 0x20u8
const ALU_DIV  : u8 = 0x30u8
const ALU_OR   : u8 = 0x40u8
const ALU_AND  : u8 = 0x50u8
const ALU_LSH  : u8 = 0x60u8
const ALU_RSH  : u8 = 0x70u8
const ALU_NEG  : u8 = 0x80u8
const ALU_MOD  : u8 = 0x90u8
const ALU_XOR  : u8 = 0xa0u8
const ALU_MOV  : u8 = 0xb0u8
const ALU_ARSH : u8 = 0xc0u8
const ALU_END  : u8 = 0xd0u8

const SRC_K    : u8 = 0x00u8   -- use immediate
const SRC_X    : u8 = 0x08u8   -- use register

-- §12  JMP OPERATION CODES
const JMP_JA   : u8 = 0x00u8
const JMP_JEQ  : u8 = 0x10u8
const JMP_JGT  : u8 = 0x20u8
const JMP_JGE  : u8 = 0x30u8
const JMP_JSET : u8 = 0x40u8
const JMP_JNE  : u8 = 0x50u8
const JMP_JSGT : u8 = 0x60u8
const JMP_JSGE : u8 = 0x70u8
const JMP_CALL : u8 = 0x80u8
const JMP_EXIT : u8 = 0x90u8
const JMP_JLT  : u8 = 0xa0u8
const JMP_JLE  : u8 = 0xb0u8
const JMP_JSLT : u8 = 0xc0u8
const JMP_JSLE : u8 = 0xd0u8

-- §13  MEMORY SIZE CODES
const SIZE_W  : u8 = 0x00u8   -- 4 bytes
const SIZE_H  : u8 = 0x08u8   -- 2 bytes
const SIZE_B  : u8 = 0x10u8   -- 1 byte
const SIZE_DW : u8 = 0x18u8   -- 8 bytes

-- §14  INSTRUCTION HELPERS

fn bpf_mov64_reg : (u8, u8) -> Insn
  | (dst, src) -> Insn { code: CLS_ALU64 | SRC_X | ALU_MOV, regs: insn_make_regs(dst, src), off: 0i16, imm: 0i32 }

fn bpf_mov64_imm : (u8, i32) -> Insn
  | (dst, imm) -> Insn { code: CLS_ALU64 | SRC_K | ALU_MOV, regs: insn_make_regs(dst, 0u8), off: 0i16, imm: imm }

fn bpf_alu64_reg : (u8, u8, u8) -> Insn
  | (op, dst, src) -> Insn { code: CLS_ALU64 | SRC_X | op, regs: insn_make_regs(dst, src), off: 0i16, imm: 0i32 }

fn bpf_alu64_imm : (u8, u8, i32) -> Insn
  | (op, dst, imm) -> Insn { code: CLS_ALU64 | SRC_K | op, regs: insn_make_regs(dst, 0u8), off: 0i16, imm: imm }

fn bpf_add64_imm : (u8, i32) -> Insn | (dst, imm) -> bpf_alu64_imm(ALU_ADD, dst, imm)
fn bpf_sub64_imm : (u8, i32) -> Insn | (dst, imm) -> bpf_alu64_imm(ALU_SUB, dst, imm)
fn bpf_and64_imm : (u8, i32) -> Insn | (dst, imm) -> bpf_alu64_imm(ALU_AND, dst, imm)
fn bpf_or64_imm  : (u8, i32) -> Insn | (dst, imm) -> bpf_alu64_imm(ALU_OR,  dst, imm)
fn bpf_lsh64_imm : (u8, i32) -> Insn | (dst, imm) -> bpf_alu64_imm(ALU_LSH, dst, imm)
fn bpf_rsh64_imm : (u8, i32) -> Insn | (dst, imm) -> bpf_alu64_imm(ALU_RSH, dst, imm)
fn bpf_add64_reg : (u8, u8) -> Insn  | (dst, src) -> bpf_alu64_reg(ALU_ADD, dst, src)

fn bpf_ldx_mem : (u8, u8, u8, i16) -> Insn
  | (size, dst, src, off) ->
    Insn { code: CLS_LDX | size | 0x60u8, regs: insn_make_regs(dst, src), off: off, imm: 0i32 }

fn bpf_stx_mem : (u8, u8, u8, i16) -> Insn
  | (size, dst, src, off) ->
    Insn { code: CLS_STX | size | 0x60u8, regs: insn_make_regs(dst, src), off: off, imm: 0i32 }

fn bpf_st_mem : (u8, u8, i16, i32) -> Insn
  | (size, dst, off, imm) ->
    Insn { code: CLS_ST | size | 0x60u8, regs: insn_make_regs(dst, 0u8), off: off, imm: imm }

fn bpf_ld_imm64 : (u8, u64) -> (Insn, Insn)
  | (dst, imm) ->
    let lo = (imm & 0xFFFFFFFFu64) as i32
    let hi = (imm >> 32u64) as i32
    (Insn { code: CLS_LD | SIZE_DW | 0x00u8, regs: insn_make_regs(dst, 0u8), off: 0i16, imm: lo },
     Insn { code: 0u8, regs: 0u8, off: 0i16, imm: hi })

fn bpf_jmp_imm : (u8, u8, i32, i16) -> Insn
  | (op, dst, imm, off) ->
    Insn { code: CLS_JMP | SRC_K | op, regs: insn_make_regs(dst, 0u8), off: off, imm: imm }

fn bpf_jmp_reg : (u8, u8, u8, i16) -> Insn
  | (op, dst, src, off) ->
    Insn { code: CLS_JMP | SRC_X | op, regs: insn_make_regs(dst, src), off: off, imm: 0i32 }

fn bpf_exit : () -> Insn
  | () -> Insn { code: CLS_JMP | JMP_EXIT, regs: 0u8, off: 0i16, imm: 0i32 }

fn bpf_call : i32 -> Insn
  | helper -> Insn { code: CLS_JMP | JMP_CALL, regs: 0u8, off: 0i16, imm: helper }

fn bpf_ja : i16 -> Insn
  | off -> Insn { code: CLS_JMP | JMP_JA, regs: 0u8, off: off, imm: 0i32 }

