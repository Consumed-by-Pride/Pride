mod os.windows.ws2_32

-- Winsock2 (ws2_32.dll) function declarations.

-- Windows socket API — parallel to POSIX sockets on Linux.

-- §1  WINSOCK TYPES
-- SOCKET is a UINT_PTR (usize) on Windows; INVALID_SOCKET = ~0
const INVALID_SOCKET   : u64 = 18446744073709551615u64  -- (SOCKET)(~0)
const SOCKET_ERROR     : i32 = -1i32
const SD_RECEIVE : i32 = 0i32
const SD_SEND    : i32 = 1i32
const SD_BOTH    : i32 = 2i32

-- §2  WSADATA
struct WsaData
  version        : u16
  high_version   : u16
  max_sockets    : u16
  max_udp_dg     : u16
  vendor_info    : ptr
  description    : u8   -- 257 bytes follow
  system_status  : u8   -- 129 bytes follow

-- §3  ADDRESS FAMILIES (same as Linux AF_* but for Winsock)
const AF_UNSPEC     : i32 = 0i32
const AF_UNIX       : i32 = 1i32
const AF_INET       : i32 = 2i32
const AF_IMPLINK    : i32 = 3i32
const AF_PUP        : i32 = 4i32
const AF_CHAOS      : i32 = 5i32
const AF_NS         : i32 = 6i32
const AF_ISO        : i32 = 7i32
const AF_OSI        : i32 = 7i32
const AF_ECMA       : i32 = 8i32
const AF_DATAKIT    : i32 = 9i32
const AF_CCITT      : i32 = 10i32
const AF_SNA        : i32 = 11i32
const AF_DECnet     : i32 = 12i32
const AF_DLI        : i32 = 13i32
const AF_LAT        : i32 = 14i32
const AF_HYLINK     : i32 = 15i32
const AF_APPLETALK  : i32 = 16i32
const AF_NETBIOS    : i32 = 17i32
const AF_VOICEVIEW  : i32 = 18i32
const AF_FIREFOX    : i32 = 19i32
const AF_UNKNOWN1   : i32 = 20i32
const AF_BAN        : i32 = 21i32
const AF_ATM        : i32 = 22i32
const AF_INET6      : i32 = 23i32
const AF_CLUSTER    : i32 = 24i32
const AF_12844      : i32 = 25i32
const AF_IRDA       : i32 = 26i32
const AF_NETDES     : i32 = 28i32
const AF_TCNPROCESS : i32 = 29i32
const AF_TCNMESSAGE : i32 = 30i32
const AF_ICLFXBM    : i32 = 31i32
const AF_BTH        : i32 = 32i32
const AF_LINK       : i32 = 33i32
const AF_HYPERV     : i32 = 34i32
const AF_MAX        : i32 = 35i32

-- §4  SOCKET TYPES
const SOCK_STREAM    : i32 = 1i32
const SOCK_DGRAM     : i32 = 2i32
const SOCK_RAW       : i32 = 3i32
const SOCK_RDM       : i32 = 4i32
const SOCK_SEQPACKET : i32 = 5i32

-- §5  IPPROTO VALUES
const IPPROTO_HOPOPTS   : i32 = 0i32
const IPPROTO_ICMP      : i32 = 1i32
const IPPROTO_IGMP      : i32 = 2i32
const IPPROTO_GGP       : i32 = 3i32
const IPPROTO_IPV4      : i32 = 4i32
const IPPROTO_ST        : i32 = 5i32
const IPPROTO_TCP       : i32 = 6i32
const IPPROTO_CBT       : i32 = 7i32
const IPPROTO_EGP       : i32 = 8i32
const IPPROTO_IGP       : i32 = 9i32
const IPPROTO_PUP       : i32 = 12i32
const IPPROTO_UDP       : i32 = 17i32
const IPPROTO_IDP       : i32 = 22i32
const IPPROTO_RDP       : i32 = 27i32
const IPPROTO_IPV6      : i32 = 41i32
const IPPROTO_ROUTING   : i32 = 43i32
const IPPROTO_FRAGMENT  : i32 = 44i32
const IPPROTO_ESP       : i32 = 50i32
const IPPROTO_AH        : i32 = 51i32
const IPPROTO_ICMPV6    : i32 = 58i32
const IPPROTO_NONE      : i32 = 59i32
const IPPROTO_DSTOPTS   : i32 = 60i32
const IPPROTO_ND        : i32 = 77i32
const IPPROTO_ICLFXBM   : i32 = 78i32
const IPPROTO_PIM       : i32 = 103i32
const IPPROTO_PGM       : i32 = 113i32
const IPPROTO_L2TP      : i32 = 115i32
const IPPROTO_SCTP      : i32 = 132i32
const IPPROTO_RAW       : i32 = 255i32

-- §6  SOCKADDR STRUCTS (Windows layout — same as Linux on x86-64)

struct SockaddrIn
  sin_family : u16   -- AF_INET = 2
  sin_port   : u16   -- big-endian
  sin_addr   : u32   -- big-endian IPv4
  sin_zero   : u64   -- 8 zero bytes

struct SockaddrIn6
  sin6_family   : u16
  sin6_port     : u16
  sin6_flowinfo : u32
  sin6_addr     : u8   -- 16 bytes
  sin6_scope_id : u32

-- §7  SOCKET OPTIONS
const SOL_SOCKET    : i32 = 65535i32   -- 0xffff on Windows
const SO_DEBUG      : i32 = 1i32
const SO_ACCEPTCONN : i32 = 2i32
const SO_REUSEADDR  : i32 = 4i32
const SO_KEEPALIVE  : i32 = 8i32
const SO_DONTROUTE  : i32 = 16i32
const SO_BROADCAST  : i32 = 32i32
const SO_USELOOPBACK : i32 = 64i32
const SO_LINGER     : i32 = 128i32
const SO_OOBINLINE  : i32 = 256i32
const SO_DONTLINGER : i32 = -129i32   -- ~SO_LINGER
const SO_EXCLUSIVEADDRUSE : i32 = -4i32   -- ~SO_REUSEADDR
const SO_SNDBUF     : i32 = 4097i32
const SO_RCVBUF     : i32 = 4098i32
const SO_SNDLOWAT   : i32 = 4099i32
const SO_RCVLOWAT   : i32 = 4100i32
const SO_SNDTIMEO   : i32 = 4101i32
const SO_RCVTIMEO   : i32 = 4102i32
const SO_ERROR      : i32 = 4103i32
const SO_TYPE       : i32 = 4104i32

const TCP_NODELAY   : i32 = 1i32
const TCP_KEEPALIVE : i32 = 3i32
const TCP_EXPEDITED_1122 : i32 = 2i32
const TCP_KEEPIDLE  : i32 = 3i32
const TCP_KEEPCNT   : i32 = 16i32
const TCP_KEEPINTVL : i32 = 17i32
const TCP_FASTOPEN  : i32 = 15i32

-- §8  MSG FLAGS
const MSG_OOB      : i32 = 1i32
const MSG_PEEK     : i32 = 2i32
const MSG_DONTROUTE : i32 = 4i32
const MSG_WAITALL  : i32 = 8i32
const MSG_PARTIAL  : i32 = 32768i32
const MSG_INTERRUPT : i32 = 16i32
const MSG_PUSH_IMMEDIATE : i32 = 32i32

-- §9  SELECT / WSA

struct FdSet
  count : u32
  -- up to 64 sockets follow
  fd    : u8   -- 64 * 8 = 512 bytes

struct Timeval
  sec  : i32
  usec : i32

-- §10  WSABUF
struct WsaBuf
  len : u32
  buf : ptr

-- §11  WSAMSG
struct WsaMsg
  name        : ptr    -- *SockaddrIn or other
  name_len    : i32
  lpBuffers   : ptr    -- *WsaBuf
  dwBufferCount : u32
  control     : WsaBuf
  dwFlags     : u32

-- §12  ADDRINFO
struct AddrinfoW
  flags      : i32
  family     : i32
  socktype   : i32
  protocol   : i32
  addrlen    : u64
  canonname  : ptr    -- *u16
  addr       : ptr    -- *SockaddrIn or *SockaddrIn6
  next       : ptr    -- *AddrinfoW

struct AddrinfoExW
  ai_flags     : i32
  ai_family    : i32
  ai_socktype  : i32
  ai_protocol  : i32
  ai_addrlen   : u64
  ai_canonname : ptr
  ai_addr      : ptr
  ai_blob      : ptr
  ai_bloblen   : u64
  ai_provider  : ptr
  ai_next      : ptr

-- §13  WSAOVERLAPPED
struct WsaOverlapped
  internal       : u64
  internal_high  : u64
  offset         : u32
  offset_high    : u32
  event          : ptr

-- §14  FUNCTION DECLARATIONS

fn WSAStartup            : (u16, ptr) -> i32                                 #extern("WSAStartup") #cc(winapi)
fn WSACleanup            : () -> i32                                          #extern("WSACleanup") #cc(winapi)
fn WSAGetLastError       : () -> i32                                          #extern("WSAGetLastError") #cc(winapi)
fn WSASetLastError       : i32 -> ()                                          #extern("WSASetLastError") #cc(winapi)
fn WSASocketW            : (i32, i32, i32, ptr, u32, u32) -> u64             #extern("WSASocketW") #cc(winapi)
fn WSAIoctl              : (u64, u32, ptr, u32, ptr, u32, ptr, ptr, ptr) -> i32  #extern("WSAIoctl") #cc(winapi)
fn WSASend               : (u64, ptr, u32, ptr, u32, ptr, ptr) -> i32       #extern("WSASend") #cc(winapi)
fn WSASendTo             : (u64, ptr, u32, ptr, u32, ptr, i32, ptr, ptr) -> i32  #extern("WSASendTo") #cc(winapi)
fn WSARecv               : (u64, ptr, u32, ptr, ptr, ptr, ptr) -> i32       #extern("WSARecv") #cc(winapi)
fn WSARecvFrom           : (u64, ptr, u32, ptr, ptr, ptr, ptr, ptr, ptr) -> i32  #extern("WSARecvFrom") #cc(winapi)
fn WSAGetOverlappedResult : (u64, ptr, ptr, i32, ptr) -> i32                #extern("WSAGetOverlappedResult") #cc(winapi)
fn WSACreateEvent        : () -> ptr                                          #extern("WSACreateEvent") #cc(winapi)
fn WSACloseEvent         : ptr -> i32                                         #extern("WSACloseEvent") #cc(winapi)
fn WSASetEvent           : ptr -> i32                                         #extern("WSASetEvent") #cc(winapi)
fn WSAResetEvent         : ptr -> i32                                         #extern("WSAResetEvent") #cc(winapi)
fn WSAWaitForMultipleEvents : (u32, ptr, i32, u32, i32) -> u32               #extern("WSAWaitForMultipleEvents") #cc(winapi)
fn WSAEventSelect        : (u64, ptr, u32) -> i32                            #extern("WSAEventSelect") #cc(winapi)
fn WSAEnumNetworkEvents  : (u64, ptr, ptr) -> i32                            #extern("WSAEnumNetworkEvents") #cc(winapi)
fn WSADuplicateSocketW   : (u64, u32, ptr) -> i32                           #extern("WSADuplicateSocketW") #cc(winapi)
fn WSAStringToAddressW   : (ptr, i32, ptr, ptr, ptr) -> i32                 #extern("WSAStringToAddressW") #cc(winapi)
fn WSAAddressToStringW   : (ptr, u32, ptr, ptr, ptr) -> i32                 #extern("WSAAddressToStringW") #cc(winapi)

fn socket                : (i32, i32, i32) -> u64                            #extern("socket") #cc(winapi)
fn closesocket           : u64 -> i32                                         #extern("closesocket") #cc(winapi)
fn bind                  : (u64, ptr, i32) -> i32                            #extern("bind") #cc(winapi)
fn listen                : (u64, i32) -> i32                                  #extern("listen") #cc(winapi)
fn accept                : (u64, ptr, ptr) -> u64                            #extern("accept") #cc(winapi)
fn connect               : (u64, ptr, i32) -> i32                            #extern("connect") #cc(winapi)
fn shutdown              : (u64, i32) -> i32                                  #extern("shutdown") #cc(winapi)
fn send                  : (u64, ptr, i32, i32) -> i32                       #extern("send") #cc(winapi)
fn sendto                : (u64, ptr, i32, i32, ptr, i32) -> i32             #extern("sendto") #cc(winapi)
fn recv                  : (u64, ptr, i32, i32) -> i32                       #extern("recv") #cc(winapi)
fn recvfrom              : (u64, ptr, i32, i32, ptr, ptr) -> i32             #extern("recvfrom") #cc(winapi)
fn getsockname           : (u64, ptr, ptr) -> i32                            #extern("getsockname") #cc(winapi)
fn getpeername           : (u64, ptr, ptr) -> i32                            #extern("getpeername") #cc(winapi)
fn setsockopt            : (u64, i32, i32, ptr, i32) -> i32                  #extern("setsockopt") #cc(winapi)
fn getsockopt            : (u64, i32, i32, ptr, ptr) -> i32                  #extern("getsockopt") #cc(winapi)
fn ioctlsocket           : (u64, i32, ptr) -> i32                            #extern("ioctlsocket") #cc(winapi)
fn select_sock           : (i32, ptr, ptr, ptr, ptr) -> i32                  #extern("select") #cc(winapi)
fn getaddrinfo           : (ptr, ptr, ptr, ptr) -> i32                       #extern("getaddrinfo") #cc(winapi)
fn GetAddrInfoW          : (ptr, ptr, ptr, ptr) -> i32                       #extern("GetAddrInfoW") #cc(winapi)
fn freeaddrinfo          : ptr -> ()                                          #extern("freeaddrinfo") #cc(winapi)
fn FreeAddrInfoW         : ptr -> ()                                          #extern("FreeAddrInfoW") #cc(winapi)
fn getnameinfo           : (ptr, i32, ptr, u32, ptr, u32, i32) -> i32        #extern("getnameinfo") #cc(winapi)
fn GetNameInfoW          : (ptr, i32, ptr, u32, ptr, u32, i32) -> i32        #extern("GetNameInfoW") #cc(winapi)
fn gethostname           : (ptr, i32) -> i32                                  #extern("gethostname") #cc(winapi)
fn inet_addr             : ptr -> u32                                          #extern("inet_addr") #cc(winapi)
fn inet_ntoa             : u32 -> ptr                                         #extern("inet_ntoa") #cc(winapi)
fn inet_pton             : (i32, ptr, ptr) -> i32                            #extern("inet_pton") #cc(winapi)
fn inet_ntop             : (i32, ptr, ptr, u32) -> ptr                       #extern("inet_ntop") #cc(winapi)
fn htons                 : u16 -> u16                                         #extern("htons") #cc(winapi)
fn htonl                 : u32 -> u32                                         #extern("htonl") #cc(winapi)
fn ntohs                 : u16 -> u16                                         #extern("ntohs") #cc(winapi)
fn ntohl                 : u32 -> u32                                         #extern("ntohl") #cc(winapi)

-- §15  WSAEVENT NETWORK EVENTS
const FD_READ            : u32 = 1u32
const FD_WRITE           : u32 = 2u32
const FD_OOB             : u32 = 4u32
const FD_ACCEPT          : u32 = 8u32
const FD_CONNECT         : u32 = 16u32
const FD_CLOSE           : u32 = 32u32
const FD_QOS             : u32 = 64u32
const FD_GROUP_QOS       : u32 = 128u32
const FD_ROUTING_INTERFACE_CHANGE : u32 = 256u32
const FD_ADDRESS_LIST_CHANGE : u32 = 512u32

struct WsaNetworkEvents
  network_events : i32
  error_code     : u32   -- 10 error codes follow (one per FD_* bit)

