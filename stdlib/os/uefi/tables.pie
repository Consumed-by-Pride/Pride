mod os.uefi.tables

use os.uefi
use os.uefi.status
use os.uefi.tables.boot_services
use os.uefi.tables.runtime_services

-- UEFI System Table and related structures.
-- Port of Zig's std/os/uefi/tables.zig.

-- §1  CONFIGURATION TABLE ENTRY

struct ConfigurationTable
  vendor_guid  : os.uefi.Guid
  vendor_table : ptr

-- Known Configuration Table GUIDs
const EFI_ACPI_TABLE_GUID : os.uefi.Guid = os.uefi.Guid {
  data1: 0xEB9D2D30u32, data2: 0x2D88u16, data3: 0x11D3u16,
  data4: 0x9A160090273FC14Du64
}
const EFI_ACPI_20_TABLE_GUID : os.uefi.Guid = os.uefi.Guid {
  data1: 0x8868E871u32, data2: 0xE4F1u16, data3: 0x11D3u16,
  data4: 0xBC220080C73C8811u64
}
const SMBIOS_TABLE_GUID : os.uefi.Guid = os.uefi.Guid {
  data1: 0xEB9D2D31u32, data2: 0x2D88u16, data3: 0x11D3u16,
  data4: 0x9A160090273FC14Du64
}
const SMBIOS3_TABLE_GUID : os.uefi.Guid = os.uefi.Guid {
  data1: 0xF2FD1544u32, data2: 0x9794u16, data3: 0x4A2Cu16,
  data4: 0x992E87B163640B7Bu64
}
const EFI_DTB_TABLE_GUID : os.uefi.Guid = os.uefi.Guid {
