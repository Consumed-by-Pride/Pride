mod os.env

use os.linux
use str.string
use str.slice

-- stdlib/os/env.pie — Environment Variables and Process Identity
-- Inspect process IDs, working directories, page size, CPU count, and environ.

fn env_get_pid : () -> i64
  | () -> os.linux.getpid()

fn env_get_ppid : () -> i64
  | () -> os.linux.getppid()

fn env_get_uid : () -> i64
  | () -> os.linux.getuid()

fn env_get_gid : () -> i64
  | () -> os.linux.getgid()

fn env_page_size : () -> i64
  | () -> 4096i64   -- standard x86-64 page size

fn env_current_dir : () -> string.String
  | () ->
    let p = os.linux.malloc(4096i64)
    let r = os.linux.getcwd(p, 4096i64)
    if r < 0i64
      os.linux.free(p)
      string.string_new()
    else
      let s = string.string_from_cstr(p)
      os.linux.free(p)
      s

fn env_set_current_dir : ptr -> i64
  | path -> os.linux.chdir(path)

fn env_get : ptr -> (string.String, bool)
  | key_cstr ->
    let key_len = os.linux.strlen(key_cstr) as i64
    let mut f = os.linux.open("/proc/self/environ" as ptr, 0i64, 0i64)
    if f < 0i64 then (string.string_new(), false)
    else
      let buf = os.linux.malloc(16384i64)
      let n = os.linux.read(f, buf, 16384i64)
      os.linux.close(f)
      if n <= 0i64
        os.linux.free(buf)
        (string.string_new(), false)
      else
        let b = buf as *u8
        let mut i : i64 = 0i64
        let mut start : i64 = 0i64
        let mut res_str = string.string_new()
        let mut found = false
        while i < n
          if b[i] == 0u8
            let entry_len = i - start
            let mut eq_idx : i64 = -1i64
            let mut k : i64 = start
            while k < i
              if b[k] == 61u8   -- '='
                eq_idx = k
                break
              k = k + 1i64
            if eq_idx > start
              let klen = eq_idx - start
              if klen == key_len && os.linux.memcmp((buf as i64 + start) as ptr, key_cstr, key_len as u64) == 0i32
                let val_len = i - eq_idx - 1i64
                res_str = string.string_from_slice((buf as i64 + eq_idx + 1i64) as ptr, val_len)
                found = true
                break
            start = i + 1i64
          i = i + 1i64
        os.linux.free(buf)
        (res_str, found)

fn env_var_exists : ptr -> bool
  | key_cstr ->
    let (s, found) = env_get(key_cstr)
    string.string_destroy(&s)
    found
