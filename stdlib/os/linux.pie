-- pthread constants
const PTHREAD_CREATE_JOINABLE   : i64 = 0i64
const PTHREAD_CREATE_DETACHED   : i64 = 1i64
const PTHREAD_MUTEX_TIMED_NP    : i64 = 0i64
const PTHREAD_MUTEX_RECURSIVE_NP : i64 = 1i64
const PTHREAD_MUTEX_ERRORCHECK_NP : i64 = 2i64
const PTHREAD_MUTEX_ADAPTIVE_NP : i64 = 3i64
const PTHREAD_MUTEX_NORMAL      : i64 = 0i64
const PTHREAD_MUTEX_RECURSIVE   : i64 = 1i64
const PTHREAD_MUTEX_ERRORCHECK  : i64 = 2i64
const PTHREAD_MUTEX_DEFAULT     : i64 = 0i64
const PTHREAD_MUTEX_STALLED     : i64 = 0i64
const PTHREAD_MUTEX_ROBUST      : i64 = 1i64
const PTHREAD_CANCEL_ENABLE     : i64 = 0i64
const PTHREAD_CANCEL_DISABLE    : i64 = 1i64
const PTHREAD_CANCEL_DEFERRED   : i64 = 0i64
const PTHREAD_CANCEL_ASYNCHRONOUS : i64 = 1i64
const PTHREAD_CANCELED          : i64 = -1i64
const PTHREAD_SCOPE_SYSTEM      : i64 = 0i64
const PTHREAD_SCOPE_PROCESS     : i64 = 1i64
const PTHREAD_INHERIT_SCHED     : i64 = 0i64
const PTHREAD_EXPLICIT_SCHED    : i64 = 1i64
const PTHREAD_PROCESS_PRIVATE   : i64 = 0i64
const PTHREAD_PROCESS_SHARED    : i64 = 1i64
const PTHREAD_BARRIER_SERIAL_THREAD : i64 = -1i64

-- §37  DIRECT SYSCALL WRAPPERS — I/O
fn read     : (i64, ptr, i64) -> i64
  | (fd, buf, n) -> syscall3(syscalls.NR_READ, fd, buf as i64, n)

fn write    : (i64, ptr, i64) -> i64
  | (fd, buf, n) -> syscall3(syscalls.NR_WRITE, fd, buf as i64, n)

fn open     : (ptr, i64, i64) -> i64
  | (path, flags, mode) -> syscall3(syscalls.NR_OPEN, path as i64, flags, mode)

fn openat   : (i64, ptr, i64, i64) -> i64
  | (dirfd, path, flags, mode) -> syscall4(syscalls.NR_OPENAT, dirfd, path as i64, flags, mode)

fn close    : i64 -> i64
  | fd -> syscall1(syscalls.NR_CLOSE, fd)

fn close_range : (i64, i64, i64) -> i64
  | (first, last, flags) -> syscall3(syscalls.NR_CLOSE_RANGE, first, last, flags)

fn lseek    : (i64, i64, i64) -> i64
  | (fd, off, whence) -> syscall3(syscalls.NR_LSEEK, fd, off, whence)

fn pread64  : (i64, ptr, i64, i64) -> i64
  | (fd, buf, n, off) -> syscall4(syscalls.NR_PREAD64, fd, buf as i64, n, off)

fn pwrite64 : (i64, ptr, i64, i64) -> i64
  | (fd, buf, n, off) -> syscall4(syscalls.NR_PWRITE64, fd, buf as i64, n, off)

fn readv    : (i64, ptr, i64) -> i64
  | (fd, iov, iovcnt) -> syscall3(syscalls.NR_READV, fd, iov as i64, iovcnt)

fn writev   : (i64, ptr, i64) -> i64
  | (fd, iov, iovcnt) -> syscall3(syscalls.NR_WRITEV, fd, iov as i64, iovcnt)

fn preadv   : (i64, ptr, i64, i64) -> i64
  | (fd, iov, iovcnt, off) -> syscall4(syscalls.NR_PREADV, fd, iov as i64, iovcnt, off)

fn pwritev  : (i64, ptr, i64, i64) -> i64
  | (fd, iov, iovcnt, off) -> syscall4(syscalls.NR_PWRITEV, fd, iov as i64, iovcnt, off)

fn preadv2  : (i64, ptr, i64, i64, i64) -> i64
  | (fd, iov, iovcnt, off, flags) -> syscall5(syscalls.NR_PREADV2, fd, iov as i64, iovcnt, off, flags)

fn pwritev2 : (i64, ptr, i64, i64, i64) -> i64
  | (fd, iov, iovcnt, off, flags) -> syscall5(syscalls.NR_PWRITEV2, fd, iov as i64, iovcnt, off, flags)

fn sendfile : (i64, i64, ptr, i64) -> i64
  | (out_fd, in_fd, offset, count) -> syscall4(syscalls.NR_SENDFILE, out_fd, in_fd, offset as i64, count)

fn splice   : (i64, ptr, i64, ptr, i64, i64) -> i64
  | (fd_in, off_in, fd_out, off_out, len, flags) -> syscall6(syscalls.NR_SPLICE, fd_in, off_in as i64, fd_out, off_out as i64, len, flags)

fn tee      : (i64, i64, i64, i64) -> i64
  | (fd_in, fd_out, len, flags) -> syscall4(syscalls.NR_TEE, fd_in, fd_out, len, flags)

fn copy_file_range : (i64, ptr, i64, ptr, i64, i64) -> i64
  | (fd_in, off_in, fd_out, off_out, len, flags) -> syscall6(syscalls.NR_COPY_FILE_RANGE, fd_in, off_in as i64, fd_out, off_out as i64, len, flags)

fn ioctl    : (i64, i64, i64) -> i64
  | (fd, req, arg) -> syscall3(syscalls.NR_IOCTL, fd, req, arg)

fn fcntl    : (i64, i64, i64) -> i64
  | (fd, cmd, arg) -> syscall3(syscalls.NR_FCNTL, fd, cmd, arg)

fn dup      : i64 -> i64
  | fd -> syscall1(syscalls.NR_DUP, fd)

fn dup2     : (i64, i64) -> i64
  | (old, new) -> syscall2(syscalls.NR_DUP2, old, new)

fn dup3     : (i64, i64, i64) -> i64
  | (old, new, flags) -> syscall3(syscalls.NR_DUP3, old, new, flags)

fn pipe     : ptr -> i64
  | fds -> syscall1(syscalls.NR_PIPE, fds as i64)

fn pipe2    : (ptr, i64) -> i64
  | (fds, flags) -> syscall2(syscalls.NR_PIPE2, fds as i64, flags)

fn fsync    : i64 -> i64
  | fd -> syscall1(syscalls.NR_FSYNC, fd)

fn fdatasync : i64 -> i64
  | fd -> syscall1(syscalls.NR_FDATASYNC, fd)

fn sync      : () -> i64  | () -> syscall0(syscalls.NR_SYNC)
fn syncfs    : i64 -> i64 | fd -> syscall1(syscalls.NR_SYNCFS, fd)

fn fallocate : (i64, i64, i64, i64) -> i64
  | (fd, mode, off, len) -> syscall4(syscalls.NR_FALLOCATE, fd, mode, off, len)

fn fadvise64 : (i64, i64, i64, i64) -> i64
  | (fd, off, len, advice) -> syscall4(syscalls.NR_FADVISE64, fd, off, len, advice)

fn readahead : (i64, i64, i64) -> i64
  | (fd, off, count) -> syscall3(syscalls.NR_READAHEAD, fd, off, count)

-- §38  DIRECT SYSCALL WRAPPERS — filesystem
fn stat     : (ptr, ptr) -> i64
  | (path, buf) -> syscall2(syscalls.NR_STAT, path as i64, buf as i64)

fn fstat    : (i64, ptr) -> i64
  | (fd, buf) -> syscall2(syscalls.NR_FSTAT, fd, buf as i64)

fn lstat    : (ptr, ptr) -> i64
  | (path, buf) -> syscall2(syscalls.NR_LSTAT, path as i64, buf as i64)

fn statx    : (i64, ptr, i64, i64, ptr) -> i64
  | (dirfd, path, flags, mask, buf) -> syscall5(syscalls.NR_STATX, dirfd, path as i64, flags, mask, buf as i64)

fn newfstatat : (i64, ptr, ptr, i64) -> i64
  | (dirfd, path, buf, flags) -> syscall4(syscalls.NR_NEWFSTATAT, dirfd, path as i64, buf as i64, flags)

fn statfs   : (ptr, ptr) -> i64
  | (path, buf) -> syscall2(syscalls.NR_STATFS, path as i64, buf as i64)

fn fstatfs  : (i64, ptr) -> i64
  | (fd, buf) -> syscall2(syscalls.NR_FSTATFS, fd, buf as i64)

fn access   : (ptr, i64) -> i64
  | (path, mode) -> syscall2(syscalls.NR_ACCESS, path as i64, mode)

fn faccessat : (i64, ptr, i64, i64) -> i64
  | (dirfd, path, mode, flags) -> syscall4(syscalls.NR_FACCESSAT, dirfd, path as i64, mode, flags)

fn faccessat2 : (i64, ptr, i64, i64) -> i64
  | (dirfd, path, mode, flags) -> syscall4(syscalls.NR_FACCESSAT2, dirfd, path as i64, mode, flags)

fn mkdir    : (ptr, i64) -> i64
  | (path, mode) -> syscall2(syscalls.NR_MKDIR, path as i64, mode)

fn mkdirat  : (i64, ptr, i64) -> i64
  | (dirfd, path, mode) -> syscall3(syscalls.NR_MKDIRAT, dirfd, path as i64, mode)

fn rmdir    : ptr -> i64
  | path -> syscall1(syscalls.NR_RMDIR, path as i64)

fn unlink   : ptr -> i64
  | path -> syscall1(syscalls.NR_UNLINK, path as i64)

fn unlinkat : (i64, ptr, i64) -> i64
  | (dirfd, path, flags) -> syscall3(syscalls.NR_UNLINKAT, dirfd, path as i64, flags)

fn rename   : (ptr, ptr) -> i64
  | (old, new) -> syscall2(syscalls.NR_RENAME, old as i64, new as i64)

fn renameat : (i64, ptr, i64, ptr) -> i64
  | (old_dir, old, new_dir, new) -> syscall4(syscalls.NR_RENAMEAT, old_dir, old as i64, new_dir, new as i64)

fn renameat2 : (i64, ptr, i64, ptr, i64) -> i64
  | (old_dir, old, new_dir, new, flags) -> syscall5(syscalls.NR_RENAMEAT2, old_dir, old as i64, new_dir, new as i64, flags)

fn link     : (ptr, ptr) -> i64
  | (old, new) -> syscall2(syscalls.NR_LINK, old as i64, new as i64)

fn linkat   : (i64, ptr, i64, ptr, i64) -> i64
  | (old_dir, old, new_dir, new, flags) -> syscall5(syscalls.NR_LINKAT, old_dir, old as i64, new_dir, new as i64, flags)

fn symlink  : (ptr, ptr) -> i64
  | (target, link) -> syscall2(syscalls.NR_SYMLINK, target as i64, link as i64)

fn symlinkat : (ptr, i64, ptr) -> i64
  | (target, dirfd, link) -> syscall3(syscalls.NR_SYMLINKAT, target as i64, dirfd, link as i64)

fn readlink : (ptr, ptr, i64) -> i64
  | (path, buf, n) -> syscall3(syscalls.NR_READLINK, path as i64, buf as i64, n)

fn readlinkat : (i64, ptr, ptr, i64) -> i64
  | (dirfd, path, buf, n) -> syscall4(syscalls.NR_READLINKAT, dirfd, path as i64, buf as i64, n)

fn chmod    : (ptr, i64) -> i64
  | (path, mode) -> syscall2(syscalls.NR_CHMOD, path as i64, mode)

fn fchmod   : (i64, i64) -> i64
  | (fd, mode) -> syscall2(syscalls.NR_FCHMOD, fd, mode)

fn fchmodat : (i64, ptr, i64, i64) -> i64
  | (dirfd, path, mode, flags) -> syscall4(syscalls.NR_FCHMODAT, dirfd, path as i64, mode, flags)

fn fchmodat2 : (i64, ptr, i64, i64) -> i64
  | (dirfd, path, mode, flags) -> syscall4(syscalls.NR_FCHMODAT2, dirfd, path as i64, mode, flags)

fn chown    : (ptr, i64, i64) -> i64
  | (path, uid, gid) -> syscall3(syscalls.NR_CHOWN, path as i64, uid, gid)

fn fchown   : (i64, i64, i64) -> i64
  | (fd, uid, gid) -> syscall3(syscalls.NR_FCHOWN, fd, uid, gid)

fn lchown   : (ptr, i64, i64) -> i64
  | (path, uid, gid) -> syscall3(syscalls.NR_LCHOWN, path as i64, uid, gid)

fn fchownat : (i64, ptr, i64, i64, i64) -> i64
  | (dirfd, path, uid, gid, flags) -> syscall5(syscalls.NR_FCHOWNAT, dirfd, path as i64, uid, gid, flags)

fn truncate : (ptr, i64) -> i64
  | (path, len) -> syscall2(syscalls.NR_TRUNCATE, path as i64, len)

fn ftruncate : (i64, i64) -> i64
  | (fd, len) -> syscall2(syscalls.NR_FTRUNCATE, fd, len)

fn getcwd   : (ptr, i64) -> i64
  | (buf, n) -> syscall2(syscalls.NR_GETCWD, buf as i64, n)

fn chdir    : ptr -> i64
  | path -> syscall1(syscalls.NR_CHDIR, path as i64)

fn fchdir   : i64 -> i64
  | fd -> syscall1(syscalls.NR_FCHDIR, fd)

fn chroot   : ptr -> i64
  | path -> syscall1(syscalls.NR_CHROOT, path as i64)

fn creat    : (ptr, i64) -> i64
  | (path, mode) -> syscall2(syscalls.NR_CREAT, path as i64, mode)

fn mknod    : (ptr, i64, i64) -> i64
  | (path, mode, dev) -> syscall3(syscalls.NR_MKNOD, path as i64, mode, dev)

fn mknodat  : (i64, ptr, i64, i64) -> i64
  | (dirfd, path, mode, dev) -> syscall4(syscalls.NR_MKNODAT, dirfd, path as i64, mode, dev)

fn getdents64 : (i64, ptr, i64) -> i64
  | (fd, buf, count) -> syscall3(syscalls.NR_GETDENTS64, fd, buf as i64, count)

fn umask    : i64 -> i64
  | mask -> syscall1(syscalls.NR_UMASK, mask)

fn utimensat : (i64, ptr, ptr, i64) -> i64
  | (dirfd, path, times, flags) -> syscall4(syscalls.NR_UTIMENSAT, dirfd, path as i64, times as i64, flags)

fn utime    : (ptr, ptr) -> i64
  | (path, times) -> syscall2(syscalls.NR_UTIME, path as i64, times as i64)

fn pivot_root : (ptr, ptr) -> i64
  | (new_root, put_old) -> syscall2(syscalls.NR_PIVOT_ROOT, new_root as i64, put_old as i64)

fn mount    : (ptr, ptr, ptr, i64, ptr) -> i64
  | (src, tgt, fs, flags, data) -> syscall5(syscalls.NR_MOUNT, src as i64, tgt as i64, fs as i64, flags, data as i64)

fn umount2  : (ptr, i64) -> i64
  | (tgt, flags) -> syscall2(syscalls.NR_UMOUNT2, tgt as i64, flags)

fn setxattr : (ptr, ptr, ptr, i64, i64) -> i64
  | (path, name, value, size, flags) -> syscall5(syscalls.NR_SETXATTR, path as i64, name as i64, value as i64, size, flags)

fn lsetxattr : (ptr, ptr, ptr, i64, i64) -> i64
  | (path, name, value, size, flags) -> syscall5(syscalls.NR_LSETXATTR, path as i64, name as i64, value as i64, size, flags)

fn fsetxattr : (i64, ptr, ptr, i64, i64) -> i64
  | (fd, name, value, size, flags) -> syscall5(syscalls.NR_FSETXATTR, fd, name as i64, value as i64, size, flags)

fn getxattr : (ptr, ptr, ptr, i64) -> i64
  | (path, name, value, size) -> syscall4(syscalls.NR_GETXATTR, path as i64, name as i64, value as i64, size)

fn lgetxattr : (ptr, ptr, ptr, i64) -> i64
  | (path, name, value, size) -> syscall4(syscalls.NR_LGETXATTR, path as i64, name as i64, value as i64, size)

fn fgetxattr : (i64, ptr, ptr, i64) -> i64
  | (fd, name, value, size) -> syscall4(syscalls.NR_FGETXATTR, fd, name as i64, value as i64, size)

fn listxattr : (ptr, ptr, i64) -> i64
  | (path, list, size) -> syscall3(syscalls.NR_LISTXATTR, path as i64, list as i64, size)

fn llistxattr : (ptr, ptr, i64) -> i64
  | (path, list, size) -> syscall3(syscalls.NR_LLISTXATTR, path as i64, list as i64, size)

fn flistxattr : (i64, ptr, i64) -> i64
  | (fd, list, size) -> syscall3(syscalls.NR_FLISTXATTR, fd, list as i64, size)

fn removexattr : (ptr, ptr) -> i64
  | (path, name) -> syscall2(syscalls.NR_REMOVEXATTR, path as i64, name as i64)

fn lremovexattr : (ptr, ptr) -> i64
  | (path, name) -> syscall2(syscalls.NR_LREMOVEXATTR, path as i64, name as i64)

fn fremovexattr : (i64, ptr) -> i64
  | (fd, name) -> syscall2(syscalls.NR_FREMOVEXATTR, fd, name as i64)

fn memfd_create : (ptr, i64) -> i64
  | (name, flags) -> syscall2(syscalls.NR_MEMFD_CREATE, name as i64, flags)

fn openat2  : (i64, ptr, ptr, i64) -> i64
  | (dirfd, path, how, size) -> syscall4(syscalls.NR_OPENAT2, dirfd, path as i64, how as i64, size)

-- §39  DIRECT SYSCALL WRAPPERS — memory
fn mmap     : (ptr, i64, i64, i64, i64, i64) -> ptr
  | (addr, len, prot, flags, fd, off) ->
    syscall6(syscalls.NR_MMAP, addr as i64, len, prot, flags, fd, off) as ptr

fn munmap   : (ptr, i64) -> i64
  | (addr, len) -> syscall2(syscalls.NR_MUNMAP, addr as i64, len)

fn mprotect : (ptr, i64, i64) -> i64
  | (addr, len, prot) -> syscall3(syscalls.NR_MPROTECT, addr as i64, len, prot)

fn mremap   : (ptr, i64, i64, i64, ptr) -> ptr
  | (addr, old_len, new_len, flags, new_addr) ->
    syscall5(syscalls.NR_MREMAP, addr as i64, old_len, new_len, flags, new_addr as i64) as ptr

fn madvise  : (ptr, i64, i64) -> i64
  | (addr, len, advice) -> syscall3(syscalls.NR_MADVISE, addr as i64, len, advice)

fn msync    : (ptr, i64, i64) -> i64
  | (addr, len, flags) -> syscall3(syscalls.NR_MSYNC, addr as i64, len, flags)

fn mincore  : (ptr, i64, ptr) -> i64
  | (addr, len, vec) -> syscall3(syscalls.NR_MINCORE, addr as i64, len, vec as i64)

fn mlock    : (ptr, i64) -> i64
  | (addr, len) -> syscall2(syscalls.NR_MLOCK, addr as i64, len)

fn mlock2   : (ptr, i64, i64) -> i64
  | (addr, len, flags) -> syscall3(syscalls.NR_MLOCK2, addr as i64, len, flags)

fn munlock  : (ptr, i64) -> i64
  | (addr, len) -> syscall2(syscalls.NR_MUNLOCK, addr as i64, len)

fn mlockall : i64 -> i64
  | flags -> syscall1(syscalls.NR_MLOCKALL, flags)

fn munlockall : () -> i64
  | () -> syscall0(syscalls.NR_MUNLOCKALL)

fn brk      : ptr -> ptr
  | addr -> syscall1(syscalls.NR_BRK, addr as i64) as ptr

fn pkey_alloc : (i64, i64) -> i64
  | (flags, access_rights) -> syscall2(syscalls.NR_PKEY_ALLOC, flags, access_rights)

fn pkey_free : i64 -> i64
  | pkey -> syscall1(syscalls.NR_PKEY_FREE, pkey)

fn pkey_mprotect : (ptr, i64, i64, i64) -> i64
  | (addr, len, prot, pkey) -> syscall4(syscalls.NR_PKEY_MPROTECT, addr as i64, len, prot, pkey)

fn mseal     : (ptr, i64, i64) -> i64
  | (addr, len, flags) -> syscall3(syscalls.NR_MSEAL, addr as i64, len, flags)

fn process_madvise : (i64, ptr, i64, i64, i64) -> i64
  | (pidfd, iov, vlen, advice, flags) -> syscall5(syscalls.NR_PROCESS_MADVISE, pidfd, iov as i64, vlen, advice, flags)

fn process_vm_readv  : (i64, ptr, i64, ptr, i64, i64) -> i64
  | (pid, lvec, liovcnt, rvec, riovcnt, flags) -> syscall6(syscalls.NR_PROCESS_VM_READV, pid, lvec as i64, liovcnt, rvec as i64, riovcnt, flags)

fn process_vm_writev : (i64, ptr, i64, ptr, i64, i64) -> i64
  | (pid, lvec, liovcnt, rvec, riovcnt, flags) -> syscall6(syscalls.NR_PROCESS_VM_WRITEV, pid, lvec as i64, liovcnt, rvec as i64, riovcnt, flags)

-- §40  DIRECT SYSCALL WRAPPERS — process
fn fork     : () -> i64  | () -> syscall0(syscalls.NR_FORK)
fn vfork    : () -> i64  | () -> syscall0(syscalls.NR_VFORK)

fn clone    : (i64, ptr, ptr, ptr, ptr) -> i64
  | (flags, stack, parent_tid, child_tid, tls) ->
    syscall5(syscalls.NR_CLONE, flags, stack as i64, parent_tid as i64, child_tid as i64, tls as i64)

fn clone3   : (ptr, i64) -> i64
  | (args, size) -> syscall2(syscalls.NR_CLONE3, args as i64, size)

fn execve   : (ptr, ptr, ptr) -> i64
  | (path, argv, envp) -> syscall3(syscalls.NR_EXECVE, path as i64, argv as i64, envp as i64)

fn execveat : (i64, ptr, ptr, ptr, i64) -> i64
  | (dirfd, path, argv, envp, flags) -> syscall5(syscalls.NR_EXECVEAT, dirfd, path as i64, argv as i64, envp as i64, flags)

fn exit_group : i64 -> ⊥
  | code -> syscall1(syscalls.NR_EXIT_GROUP, code); unreachable

fn _exit    : i64 -> ⊥
  | code -> syscall1(syscalls.NR_EXIT, code); unreachable

fn wait4    : (i64, ptr, i64, ptr) -> i64
  | (pid, status, options, rusage) -> syscall4(syscalls.NR_WAIT4, pid, status as i64, options, rusage as i64)

fn waitid   : (i64, i64, ptr, i64, ptr) -> i64
  | (which, pid, infop, options, rusage) -> syscall5(syscalls.NR_WAITID, which, pid, infop as i64, options, rusage as i64)

fn kill     : (i64, i64) -> i64
  | (pid, sig) -> syscall2(syscalls.NR_KILL, pid, sig)

fn tkill    : (i64, i64) -> i64
  | (tid, sig) -> syscall2(syscalls.NR_TKILL, tid, sig)

fn tgkill   : (i64, i64, i64) -> i64
  | (tgid, tid, sig) -> syscall3(syscalls.NR_TGKILL, tgid, tid, sig)

fn getpid   : () -> i64  | () -> syscall0(syscalls.NR_GETPID)
fn getppid  : () -> i64  | () -> syscall0(syscalls.NR_GETPPID)
fn gettid   : () -> i64  | () -> syscall0(syscalls.NR_GETTID)
fn getuid   : () -> i64  | () -> syscall0(syscalls.NR_GETUID)
fn getgid   : () -> i64  | () -> syscall0(syscalls.NR_GETGID)
fn geteuid  : () -> i64  | () -> syscall0(syscalls.NR_GETEUID)
fn getegid  : () -> i64  | () -> syscall0(syscalls.NR_GETEGID)
fn getpgid  : i64 -> i64 | pid -> syscall1(syscalls.NR_GETPGID, pid)
fn getpgrp  : () -> i64  | () -> syscall0(syscalls.NR_GETPGRP)
fn getsid   : i64 -> i64 | pid -> syscall1(syscalls.NR_GETSID, pid)
fn setuid   : i64 -> i64 | uid -> syscall1(syscalls.NR_SETUID, uid)
fn setgid   : i64 -> i64 | gid -> syscall1(syscalls.NR_SETGID, gid)
fn setpgid  : (i64, i64) -> i64 | (pid, pgid) -> syscall2(syscalls.NR_SETPGID, pid, pgid)
fn setsid   : () -> i64  | () -> syscall0(syscalls.NR_SETSID)
fn setreuid : (i64, i64) -> i64 | (ruid, euid) -> syscall2(syscalls.NR_SETREUID, ruid, euid)
fn setregid : (i64, i64) -> i64 | (rgid, egid) -> syscall2(syscalls.NR_SETREGID, rgid, egid)
fn setresuid : (i64, i64, i64) -> i64 | (r,e,s) -> syscall3(syscalls.NR_SETRESUID, r, e, s)
fn setresgid : (i64, i64, i64) -> i64 | (r,e,s) -> syscall3(syscalls.NR_SETRESGID, r, e, s)
fn getresuid : (ptr, ptr, ptr) -> i64 | (r,e,s) -> syscall3(syscalls.NR_GETRESUID, r as i64, e as i64, s as i64)
fn getresgid : (ptr, ptr, ptr) -> i64 | (r,e,s) -> syscall3(syscalls.NR_GETRESGID, r as i64, e as i64, s as i64)
fn setfsuid : i64 -> i64 | uid -> syscall1(syscalls.NR_SETFSUID, uid)
fn setfsgid : i64 -> i64 | gid -> syscall1(syscalls.NR_SETFSGID, gid)
fn getgroups : (i64, ptr) -> i64 | (size, list) -> syscall2(syscalls.NR_GETGROUPS, size, list as i64)
fn setgroups : (i64, ptr) -> i64 | (size, list) -> syscall2(syscalls.NR_SETGROUPS, size, list as i64)

fn prctl    : (i64, i64, i64, i64, i64) -> i64
  | (op, a2, a3, a4, a5) -> syscall5(syscalls.NR_PRCTL, op, a2, a3, a4, a5)

fn arch_prctl : (i64, i64) -> i64
  | (code, addr) -> syscall2(syscalls.NR_ARCH_PRCTL, code, addr)

fn ptrace   : (i64, i64, ptr, ptr) -> i64
  | (req, pid, addr, data) -> syscall4(syscalls.NR_PTRACE, req, pid, addr as i64, data as i64)

fn capget   : (ptr, ptr) -> i64
  | (hdrp, datap) -> syscall2(syscalls.NR_CAPGET, hdrp as i64, datap as i64)

fn capset   : (ptr, ptr) -> i64
  | (hdrp, datap) -> syscall2(syscalls.NR_CAPSET, hdrp as i64, datap as i64)

fn prlimit64 : (i64, i64, ptr, ptr) -> i64
  | (pid, resource, new_lim, old_lim) -> syscall4(syscalls.NR_PRLIMIT64, pid, resource, new_lim as i64, old_lim as i64)

fn getrlimit : (i64, ptr) -> i64
  | (resource, rlim) -> syscall2(syscalls.NR_GETRLIMIT, resource, rlim as i64)

fn setrlimit : (i64, ptr) -> i64
  | (resource, rlim) -> syscall2(syscalls.NR_SETRLIMIT, resource, rlim as i64)

fn getrusage : (i64, ptr) -> i64
  | (who, usage) -> syscall2(syscalls.NR_GETRUSAGE, who, usage as i64)

fn sched_yield : () -> i64  | () -> syscall0(syscalls.NR_SCHED_YIELD)

fn sched_setaffinity : (i64, i64, ptr) -> i64
  | (pid, len, mask) -> syscall3(syscalls.NR_SCHED_SETAFFINITY, pid, len, mask as i64)

fn sched_getaffinity : (i64, i64, ptr) -> i64
  | (pid, len, mask) -> syscall3(syscalls.NR_SCHED_GETAFFINITY, pid, len, mask as i64)

fn sched_setscheduler : (i64, i64, ptr) -> i64
  | (pid, policy, param) -> syscall3(syscalls.NR_SCHED_SETSCHEDULER, pid, policy, param as i64)

fn sched_getscheduler : i64 -> i64
  | pid -> syscall1(syscalls.NR_SCHED_GETSCHEDULER, pid)

fn sched_setparam : (i64, ptr) -> i64
  | (pid, param) -> syscall2(syscalls.NR_SCHED_SETPARAM, pid, param as i64)

fn sched_getparam : (i64, ptr) -> i64
  | (pid, param) -> syscall2(syscalls.NR_SCHED_GETPARAM, pid, param as i64)

fn sched_setattr : (i64, ptr, i64) -> i64
  | (pid, attr, flags) -> syscall3(syscalls.NR_SCHED_SETATTR, pid, attr as i64, flags)

fn sched_getattr : (i64, ptr, i64, i64) -> i64
  | (pid, attr, size, flags) -> syscall4(syscalls.NR_SCHED_GETATTR, pid, attr as i64, size, flags)

fn sched_get_priority_max : i64 -> i64
  | policy -> syscall1(syscalls.NR_SCHED_GET_PRIORITY_MAX, policy)

fn sched_get_priority_min : i64 -> i64
  | policy -> syscall1(syscalls.NR_SCHED_GET_PRIORITY_MIN, policy)

fn sched_rr_get_interval : (i64, ptr) -> i64
  | (pid, tp) -> syscall2(syscalls.NR_SCHED_RR_GET_INTERVAL, pid, tp as i64)

fn getcpu   : (ptr, ptr, ptr) -> i64
  | (cpu, node, cache) -> syscall3(syscalls.NR_GETCPU, cpu as i64, node as i64, cache as i64)

fn pidfd_open : (i64, i64) -> i64
  | (pid, flags) -> syscall2(syscalls.NR_PIDFD_OPEN, pid, flags)

fn pidfd_getfd : (i64, i64, i64) -> i64
  | (pidfd, targetfd, flags) -> syscall3(syscalls.NR_PIDFD_GETFD, pidfd, targetfd, flags)

fn setns    : (i64, i64) -> i64
  | (fd, nstype) -> syscall2(syscalls.NR_SETNS, fd, nstype)

fn unshare  : i64 -> i64
  | flags -> syscall1(syscalls.NR_UNSHARE, flags)

fn personality : i64 -> i64
  | persona -> syscall1(syscalls.NR_PERSONALITY, persona)

fn reboot   : (i64, i64, i64, ptr) -> i64
  | (magic, magic2, cmd, arg) -> syscall4(syscalls.NR_REBOOT, magic, magic2, cmd, arg as i64)

fn kexec_load : (i64, i64, ptr, i64) -> i64
  | (entry, nr_segs, segs, flags) -> syscall4(syscalls.NR_KEXEC_LOAD, entry, nr_segs, segs as i64, flags)

fn init_module : (ptr, i64, ptr) -> i64
  | (mod_image, len, param_values) -> syscall3(syscalls.NR_INIT_MODULE, mod_image as i64, len, param_values as i64)

fn finit_module : (i64, ptr, i64) -> i64
  | (fd, param_values, flags) -> syscall3(syscalls.NR_FINIT_MODULE, fd, param_values as i64, flags)

fn delete_module : (ptr, i64) -> i64
  | (name, flags) -> syscall2(syscalls.NR_DELETE_MODULE, name as i64, flags)

fn kcmp     : (i64, i64, i64, i64, i64) -> i64
  | (pid1, pid2, type_, idx1, idx2) -> syscall5(syscalls.NR_KCMP, pid1, pid2, type_, idx1, idx2)

-- §41  DIRECT SYSCALL WRAPPERS — networking
fn socket   : (i64, i64, i64) -> i64
  | (domain, type_, proto) -> syscall3(syscalls.NR_SOCKET, domain, type_, proto)

fn socketpair : (i64, i64, i64, ptr) -> i64
  | (domain, type_, proto, sv) -> syscall4(syscalls.NR_SOCKETPAIR, domain, type_, proto, sv as i64)

fn bind     : (i64, ptr, i64) -> i64
  | (fd, addr, addrlen) -> syscall3(syscalls.NR_BIND, fd, addr as i64, addrlen)

fn listen   : (i64, i64) -> i64
  | (fd, backlog) -> syscall2(syscalls.NR_LISTEN, fd, backlog)

fn accept   : (i64, ptr, ptr) -> i64
  | (fd, addr, addrlen) -> syscall3(syscalls.NR_ACCEPT, fd, addr as i64, addrlen as i64)

fn accept4  : (i64, ptr, ptr, i64) -> i64
  | (fd, addr, addrlen, flags) -> syscall4(syscalls.NR_ACCEPT4, fd, addr as i64, addrlen as i64, flags)

fn connect  : (i64, ptr, i64) -> i64
  | (fd, addr, addrlen) -> syscall3(syscalls.NR_CONNECT, fd, addr as i64, addrlen)

fn shutdown : (i64, i64) -> i64
  | (fd, how) -> syscall2(syscalls.NR_SHUTDOWN, fd, how)

fn getsockname : (i64, ptr, ptr) -> i64
  | (fd, addr, addrlen) -> syscall3(syscalls.NR_GETSOCKNAME, fd, addr as i64, addrlen as i64)

fn getpeername : (i64, ptr, ptr) -> i64
  | (fd, addr, addrlen) -> syscall3(syscalls.NR_GETPEERNAME, fd, addr as i64, addrlen as i64)

fn setsockopt : (i64, i64, i64, ptr, i64) -> i64
  | (fd, level, optname, optval, optlen) -> syscall5(syscalls.NR_SETSOCKOPT, fd, level, optname, optval as i64, optlen)

fn getsockopt : (i64, i64, i64, ptr, ptr) -> i64
  | (fd, level, optname, optval, optlen) -> syscall5(syscalls.NR_GETSOCKOPT, fd, level, optname, optval as i64, optlen as i64)

fn sendto   : (i64, ptr, i64, i64, ptr, i64) -> i64
  | (fd, buf, len, flags, addr, addrlen) -> syscall6(syscalls.NR_SENDTO, fd, buf as i64, len, flags, addr as i64, addrlen)

fn recvfrom : (i64, ptr, i64, i64, ptr, ptr) -> i64
  | (fd, buf, len, flags, addr, addrlen) -> syscall6(syscalls.NR_RECVFROM, fd, buf as i64, len, flags, addr as i64, addrlen as i64)

fn sendmsg  : (i64, ptr, i64) -> i64
  | (fd, msg, flags) -> syscall3(syscalls.NR_SENDMSG, fd, msg as i64, flags)

fn recvmsg  : (i64, ptr, i64) -> i64
  | (fd, msg, flags) -> syscall3(syscalls.NR_RECVMSG, fd, msg as i64, flags)

fn sendmmsg : (i64, ptr, i64, i64) -> i64
  | (fd, mmsg, vlen, flags) -> syscall4(syscalls.NR_SENDMMSG, fd, mmsg as i64, vlen, flags)

fn recvmmsg : (i64, ptr, i64, i64, ptr) -> i64
  | (fd, mmsg, vlen, flags, timeout) -> syscall5(syscalls.NR_RECVMMSG, fd, mmsg as i64, vlen, flags, timeout as i64)

-- §42  DIRECT SYSCALL WRAPPERS — time
fn clock_gettime  : (i64, ptr) -> i64
  | (clk, tp) -> syscall2(syscalls.NR_CLOCK_GETTIME, clk, tp as i64)

fn clock_settime  : (i64, ptr) -> i64
  | (clk, tp) -> syscall2(syscalls.NR_CLOCK_SETTIME, clk, tp as i64)

fn clock_getres   : (i64, ptr) -> i64
  | (clk, res) -> syscall2(syscalls.NR_CLOCK_GETRES, clk, res as i64)

fn clock_nanosleep : (i64, i64, ptr, ptr) -> i64
  | (clk, flags, req, rem) -> syscall4(syscalls.NR_CLOCK_NANOSLEEP, clk, flags, req as i64, rem as i64)

fn nanosleep : (ptr, ptr) -> i64
  | (req, rem) -> syscall2(syscalls.NR_NANOSLEEP, req as i64, rem as i64)

fn gettimeofday : (ptr, ptr) -> i64
  | (tv, tz) -> syscall2(syscalls.NR_GETTIMEOFDAY, tv as i64, tz as i64)

fn settimeofday : (ptr, ptr) -> i64
  | (tv, tz) -> syscall2(syscalls.NR_SETTIMEOFDAY, tv as i64, tz as i64)

fn adjtimex : ptr -> i64
  | buf -> syscall1(syscalls.NR_ADJTIMEX, buf as i64)

fn timer_create   : (i64, ptr, ptr) -> i64
  | (clk, event, timerid) -> syscall3(syscalls.NR_TIMER_CREATE, clk, event as i64, timerid as i64)

fn timer_settime  : (i64, i64, ptr, ptr) -> i64
  | (timerid, flags, new_value, old_value) -> syscall4(syscalls.NR_TIMER_SETTIME, timerid, flags, new_value as i64, old_value as i64)

fn timer_gettime  : (i64, ptr) -> i64
  | (timerid, curr_value) -> syscall2(syscalls.NR_TIMER_GETTIME, timerid, curr_value as i64)

fn timer_getoverrun : i64 -> i64
  | timerid -> syscall1(syscalls.NR_TIMER_GETOVERRUN, timerid)

fn timer_delete   : i64 -> i64
  | timerid -> syscall1(syscalls.NR_TIMER_DELETE, timerid)

fn getitimer : (i64, ptr) -> i64
  | (which, value) -> syscall2(syscalls.NR_GETITIMER, which, value as i64)

fn setitimer : (i64, ptr, ptr) -> i64
  | (which, new_value, old_value) -> syscall3(syscalls.NR_SETITIMER, which, new_value as i64, old_value as i64)

fn alarm     : i64 -> i64
  | seconds -> syscall1(syscalls.NR_ALARM, seconds)

fn times     : ptr -> i64
  | buf -> syscall1(syscalls.NR_TIMES, buf as i64)

fn sysinfo   : ptr -> i64
  | info -> syscall1(syscalls.NR_SYSINFO, info as i64)

fn uname     : ptr -> i64
  | buf -> syscall1(syscalls.NR_UNAME, buf as i64)

