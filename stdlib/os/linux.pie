mod os.linux

use os.linux.syscalls

-- §1  RAW SYSCALL BRIDGE
fn syscall0 : i64 -> i64                                    #extern("syscall") #cc(c)
fn syscall1 : (i64, i64) -> i64                             #extern("syscall") #cc(c)
fn syscall2 : (i64, i64, i64) -> i64                        #extern("syscall") #cc(c)
fn syscall3 : (i64, i64, i64, i64) -> i64                   #extern("syscall") #cc(c)
fn syscall4 : (i64, i64, i64, i64, i64) -> i64              #extern("syscall") #cc(c)
fn syscall5 : (i64, i64, i64, i64, i64, i64) -> i64         #extern("syscall") #cc(c)
fn syscall6 : (i64, i64, i64, i64, i64, i64, i64) -> i64    #extern("syscall") #cc(c)

