-- §51  DERIVED HELPERS — byte-exact I/O
fn write_all : (i64, ptr, i64) -> i64
  | (fd, buf, n) ->
    let mut off : i64 = 0i64
    while off < n
      let r = write(fd, (buf as i64 + off) as ptr, n - off)
      if r < 0i64 then r
      off = off + r
    n

fn read_all : (i64, ptr, i64) -> i64
  | (fd, buf, n) ->
    let mut off : i64 = 0i64
    while off < n
      let r = read(fd, (buf as i64 + off) as ptr, n - off)
      if r <= 0i64 then off
      off = off + r
    off

fn read_file : (ptr, ptr, i64) -> i64
  | (path, buf, cap) ->
    let fd = open(path, O_RDONLY, 0i64)
    if fd < 0i64 then fd
    let n = read_all(fd, buf, cap)
    close(fd)
    n

fn write_file : (ptr, ptr, i64) -> i64
  | (path, buf, n) ->
    let fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 493i64)
    if fd < 0i64 then fd
    let written = write_all(fd, buf, n)
    close(fd)
    written

-- §52  DERIVED HELPERS — filesystem
fn mkdir_p : (ptr, i64) -> i64
  | (path, mode) ->
    let buf : *u8 = malloc(4096i64) as *u8
    let mut i : i64 = 0i64
    let mut plen : i64 = 0i64
    while (path as *u8)[plen] != 0u8 then plen = plen + 1i64
    memcpy(buf as ptr, path as ptr, plen as u64)
    buf[plen] = 0u8
    while i <= plen
      if buf[i] == 47u8 && i > 0i64
        buf[i] = 0u8
        mkdir(buf as ptr, mode)
        buf[i] = 47u8
      i = i + 1i64
    let r = mkdir(path, mode)
    free(buf as ptr)
    r

fn file_exists : ptr -> bool
  | path ->
    let r = access(path, F_OK)
    r == 0i64

fn file_size : ptr -> i64
  | path ->
    let buf : *u8 = malloc(144i64) as *u8
    let r = stat(path, buf as ptr)
    if r < 0i64
      free(buf as ptr)
      -1i64
    else
      let sz = (buf as *i64)[6i64]
      free(buf as ptr)
      sz

fn is_dir : ptr -> bool
  | path ->
    let buf : *u8 = malloc(144i64) as *u8
    let r = stat(path, buf as ptr)
    if r < 0i64
      free(buf as ptr)
      false
    else
      let mode = (buf as *i64)[3i64] as i64
      free(buf as ptr)
      (mode & S_IFMT) == S_IFDIR

-- §53  DERIVED HELPERS — fd flags
fn set_nonblocking : i64 -> i64
  | fd ->
    let flags = fcntl(fd, F_GETFL, 0i64)
    if flags < 0i64 then flags
    fcntl(fd, F_SETFL, flags | O_NONBLOCK)

fn set_blocking : i64 -> i64
  | fd ->
    let flags = fcntl(fd, F_GETFL, 0i64)
    if flags < 0i64 then flags
    fcntl(fd, F_SETFL, flags & (-1i64 ^ O_NONBLOCK))

fn set_cloexec : i64 -> i64
  | fd ->
    let flags = fcntl(fd, F_GETFD, 0i64)
    if flags < 0i64 then flags
    fcntl(fd, F_SETFD, flags | FD_CLOEXEC)

fn clear_cloexec : i64 -> i64
  | fd ->
    let flags = fcntl(fd, F_GETFD, 0i64)
    if flags < 0i64 then flags
    fcntl(fd, F_SETFD, flags & (-1i64 ^ FD_CLOEXEC))

-- §54  DERIVED HELPERS — socket options
fn set_reuseaddr : i64 -> i64
  | fd ->
    let val : *i32 = malloc(4i64) as *i32; val[0i32] = 1i32
    let r = setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, val as ptr, 4i64)
    free(val as ptr); r

fn set_reuseport : i64 -> i64
  | fd ->
    let val : *i32 = malloc(4i64) as *i32; val[0i32] = 1i32
    let r = setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, val as ptr, 4i64)
    free(val as ptr); r

fn set_nodelay : i64 -> i64
  | fd ->
    let val : *i32 = malloc(4i64) as *i32; val[0i32] = 1i32
    let r = setsockopt(fd, SOL_TCP, TCP_NODELAY, val as ptr, 4i64)
    free(val as ptr); r

fn set_keepalive : i64 -> i64
  | fd ->
    let val : *i32 = malloc(4i64) as *i32; val[0i32] = 1i32
    let r = setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, val as ptr, 4i64)
    free(val as ptr); r

fn set_keepidle : (i64, i32) -> i64
  | (fd, secs) ->
    let val : *i32 = malloc(4i64) as *i32; val[0i32] = secs
    let r = setsockopt(fd, SOL_TCP, TCP_KEEPIDLE, val as ptr, 4i64)
    free(val as ptr); r

fn set_keepintvl : (i64, i32) -> i64
  | (fd, secs) ->
    let val : *i32 = malloc(4i64) as *i32; val[0i32] = secs
    let r = setsockopt(fd, SOL_TCP, TCP_KEEPINTVL, val as ptr, 4i64)
    free(val as ptr); r

fn set_keepcnt : (i64, i32) -> i64
  | (fd, cnt) ->
    let val : *i32 = malloc(4i64) as *i32; val[0i32] = cnt
    let r = setsockopt(fd, SOL_TCP, TCP_KEEPCNT, val as ptr, 4i64)
    free(val as ptr); r

fn set_sndbuf : (i64, i32) -> i64
  | (fd, size) ->
    let val : *i32 = malloc(4i64) as *i32; val[0i32] = size
    let r = setsockopt(fd, SOL_SOCKET, SO_SNDBUF, val as ptr, 4i64)
    free(val as ptr); r

fn set_rcvbuf : (i64, i32) -> i64
  | (fd, size) ->
    let val : *i32 = malloc(4i64) as *i32; val[0i32] = size
    let r = setsockopt(fd, SOL_SOCKET, SO_RCVBUF, val as ptr, 4i64)
    free(val as ptr); r

fn set_recv_timeout : (i64, i64, i64) -> i64
  | (fd, sec, usec) ->
    let tv : *i64 = malloc(16i64) as *i64; tv[0i64] = sec; tv[1i64] = usec
    let r = setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, tv as ptr, 16i64)
    free(tv as ptr); r

fn set_send_timeout : (i64, i64, i64) -> i64
  | (fd, sec, usec) ->
    let tv : *i64 = malloc(16i64) as *i64; tv[0i64] = sec; tv[1i64] = usec
    let r = setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, tv as ptr, 16i64)
    free(tv as ptr); r

fn get_sock_error : i64 -> i32
  | fd ->
    let val : *i32 = malloc(4i64) as *i32
    let len : *i32 = malloc(4i64) as *i32; len[0i32] = 4i32
    getsockopt(fd, SOL_SOCKET, SO_ERROR, val as ptr, len as ptr)
    let e = val[0i32]; free(val as ptr); free(len as ptr); e

-- §55  DERIVED HELPERS — byte order
fn htonll : u64 -> u64
  | v ->
    let hi = htonl((v >> 32u64) as u32) as u64
    let lo = htonl((v & 0xFFFFFFFFu64) as u32) as u64
    (lo << 32u64) | hi

fn ntohll : u64 -> u64
  | v -> htonll(v)

-- §56  DERIVED HELPERS — random
fn getrandom_exact : (ptr, i64) -> i64
  | (buf, n) ->
    let mut off : i64 = 0i64
    while off < n
      let r = getrandom((buf as i64 + off) as ptr, n - off, 0i64)
      if r < 0i64 then r
      off = off + r
    n

fn random_u64 : () -> u64
  | () ->
    let val : *u64 = malloc(8i64) as *u64
    getrandom_exact(val as ptr, 8i64)
    let v = val[0i64]; free(val as ptr); v

fn random_u32 : () -> u32
  | () -> (random_u64() & 0xFFFFFFFFu64) as u32

fn random_range : (i64, i64) -> i64
  | (lo, hi) ->
    if lo >= hi then lo
    let range = (hi - lo) as u64
    let v = random_u64() % range
    lo + v as i64

-- §57  DERIVED HELPERS — system info
fn cpu_count : () -> i64
  | () ->
    let buf : *u8 = malloc(4096i64) as *u8
    let n = read_file("/sys/devices/system/cpu/online" as ptr, buf as ptr, 4095i64)
    if n <= 0i64
      free(buf as ptr); 1i64
    else
      buf[n] = 0u8
      let mut count : i64 = 0i64
      let mut i : i64 = 0i64
      while i < n
        if buf[i] == 44u8 then count = count + 1i64
        if buf[i] == 45u8
          -- range: parse end
          let mut j = i + 1i64; let mut end_val : i64 = 0i64
          while buf[j] >= 48u8 && buf[j] <= 57u8
            end_val = end_val * 10i64 + buf[j] as i64 - 48i64; j = j + 1i64
          let mut start_val : i64 = 0i64; let mut k = i - 1i64
          while k >= 0i64 && buf[k] >= 48u8 && buf[k] <= 57u8 then k = k - 1i64
          k = k + 1i64
          while buf[k] >= 48u8 && buf[k] <= 57u8
            start_val = start_val * 10i64 + buf[k] as i64 - 48i64; k = k + 1i64
          count = count + end_val - start_val
        i = i + 1i64
      free(buf as ptr); count + 1i64

fn hostname : (ptr, i64) -> i64
  | (buf, n) ->
    let uts : *u8 = malloc(390i64) as *u8
    let r = uname(uts as ptr)
    if r < 0i64 then free(uts as ptr); r
    let hlen = strlen((uts as i64 + 65i64) as ptr) as i64
    let copy_n = if hlen < n - 1i64 then hlen else n - 1i64
    memcpy(buf, (uts as i64 + 65i64) as ptr, copy_n as u64)
    (buf as *u8)[copy_n] = 0u8
    free(uts as ptr); copy_n

fn sleep_ns : i64 -> ()
  | ns ->
    let ts : *i64 = malloc(16i64) as *i64
    ts[0i64] = ns / 1000000000i64; ts[1i64] = ns % 1000000000i64
    nanosleep(ts as ptr, 0 as ptr); free(ts as ptr)

fn sleep_ms : i64 -> ()  | ms -> sleep_ns(ms * 1000000i64)
fn sleep_sec : i64 -> () | s  -> sleep_ns(s * 1000000000i64)

fn monotonic_ns : () -> i64
  | () ->
    let ts : *i64 = malloc(16i64) as *i64
    clock_gettime(CLOCK_MONOTONIC, ts as ptr)
    let v = ts[0i64] * 1000000000i64 + ts[1i64]
    free(ts as ptr); v

fn realtime_ns : () -> i64
  | () ->
    let ts : *i64 = malloc(16i64) as *i64
    clock_gettime(CLOCK_REALTIME, ts as ptr)
    let v = ts[0i64] * 1000000000i64 + ts[1i64]
    free(ts as ptr); v

-- §58  PROC HELPERS
fn proc_read : (ptr, ptr, i64) -> i64
  | (procpath, buf, cap) -> read_file(procpath, buf, cap)

fn proc_self_exe : (ptr, i64) -> i64
  | (buf, cap) -> readlink("/proc/self/exe" as ptr, buf, cap)

fn proc_self_maps : (ptr, i64) -> i64
  | (buf, cap) -> read_file("/proc/self/maps" as ptr, buf, cap)

fn proc_self_status : (ptr, i64) -> i64
  | (buf, cap) -> read_file("/proc/self/status" as ptr, buf, cap)

fn proc_self_cwd : (ptr, i64) -> i64
  | (buf, cap) -> readlink("/proc/self/cwd" as ptr, buf, cap)

fn proc_self_fd : (i64, ptr, i64) -> i64
  | (fd, buf, cap) ->
    let path : *u8 = malloc(64i64) as *u8
    snprintf(path as ptr, 64u64, "/proc/self/fd/%ld" as ptr, fd)
    let r = readlink(path as ptr, buf, cap)
    free(path as ptr); r

fn proc_pid_exists : i64 -> bool
  | pid ->
    let path : *u8 = malloc(32i64) as *u8
    snprintf(path as ptr, 32u64, "/proc/%ld" as ptr, pid)
    let r = access(path as ptr, F_OK)
    free(path as ptr); r == 0i64

-- §59  ERRNO HELPERS
fn errno_str : i64 -> *u8
  | e -> strerror(e as i32) as *u8

fn is_err : i64 -> bool
  | v -> v < 0i64 && v >= -4095i64

fn errno_from : i64 -> i64
  | v -> if is_err(v) then -v else 0i64