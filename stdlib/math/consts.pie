mod math.consts

-- stdlib/math/consts.pie — Mathematical and Numeric Constants
-- Authoritative IEEE-754 and integer limits, plus fundamental transcendental constants.

const PI        : f64 = 3.141592653589793238462643383279502884f64
const TAU       : f64 = 6.283185307179586476925286766559005768f64
const E         : f64 = 2.718281828459045235360287471352662498f64
const SQRT_2    : f64 = 1.414213562373095048801688724209698079f64
const FRAC_1_SQRT_2 : f64 = 0.707106781186547524400844362104849039f64
const LN_2      : f64 = 0.693147180559945309417232121458176568f64
const LN_10     : f64 = 2.302585092994045684017991454684364208f64
const LOG2_E    : f64 = 1.442695040888963407359924681001892137f64
const LOG10_E   : f64 = 0.434294481903251827651128918916605082f64

const INT64_MAX : i64 =  9223372036854775807i64
const INT64_MIN : i64 = -9223372036854775807i64 - 1i64
const INT32_MAX : i64 =  2147483647i64
const INT32_MIN : i64 = -2147483648i64
const UINT64_MAX: u64 = 18446744073709551615u64
