mod math.round

-- stdlib/math/round.pie — Rounding, Truncation, and Euclidean Division

fn floor_f64 : f64 -> f64
  | x ->
    let i = x as i64
    let f = i as f64
    if x < 0.0f64 && x != f then (i - 1i64) as f64 else f

fn ceil_f64 : f64 -> f64
  | x ->
    let i = x as i64
    let f = i as f64
    if x > 0.0f64 && x != f then (i + 1i64) as f64 else f

fn trunc_f64 : f64 -> f64
  | x -> (x as i64) as f64

fn round_f64 : f64 -> f64
  | x ->
    if x >= 0.0f64 then floor_f64(x + 0.5f64)
    else ceil_f64(x - 0.5f64)

fn div_floor_i64 : (i64, i64) -> i64
  | (a, b) ->
    let q = a / b
    let r = a % b
    if (r != 0i64) && ((a < 0i64) != (b < 0i64)) then q - 1i64 else q

fn div_ceil_i64 : (i64, i64) -> i64
  | (a, b) ->
    let q = a / b
    let r = a % b
    if (r != 0i64) && ((a > 0i64) == (b > 0i64)) then q + 1i64 else q

fn rem_euclid_i64 : (i64, i64) -> i64
  | (a, b) ->
    let r = a % b
    if r < 0i64
      if b < 0i64 then r - b else r + b
    else r
