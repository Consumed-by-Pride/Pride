mod async.task

-- stdlib/async/task.pie — Asynchronous Task and Future Representation
-- Represents lightweight cooperative tasks state machines.

struct Task
  id       : i64
  state    : i64
  result   : i64
  is_ready : bool

const TASK_PENDING : i64 = 0i64
const TASK_READY   : i64 = 1i64
const TASK_DONE    : i64 = 2i64

fn task_new : i64 -> Task
  | id -> Task { id: id, state: TASK_PENDING, result: 0i64, is_ready: false }

fn task_poll : *Task -> bool
  | t ->
    if t.state == TASK_READY || t.state == TASK_DONE
      t.is_ready = true
      true
    else
      false

fn task_complete : (*Task, i64) -> ()
  | (t, res) ->
    t.result = res
    t.state = TASK_READY
    t.is_ready = true
