mod opt.option

-- stdlib/opt/option.pie — Option<T> and Result<T,E> as enum types
-- Migrated from compiler/stdlib/option.pie.

-- Option: tag=0 → None, tag=1 → Some(val). Layout: { i32, i64 }
enum Option
  None,
  Some(i64),

fn option_some : i64 -> Option | x -> Option.Some(x)
fn option_none : ()  -> Option | () -> Option.None

fn option_is_some : Option -> bool
  | o -> match o | Some(_) -> true | None -> false

fn option_is_none : Option -> bool
  | o -> match o | Some(_) -> false | None -> true

fn option_unwrap : Option -> i64
  | o -> match o | Some(v) -> v | None -> 0i64

fn option_unwrap_or : (Option, i64) -> i64
  | (o, default) -> match o | Some(v) -> v | None -> default

-- Result: tag=0 → Ok(val), tag=1 → Err(e). Layout: { i32, i64 }
enum Result
  Ok(i64),
  Err(i64),

fn result_ok  : i64 -> Result | v -> Result.Ok(v)
fn result_err : i64 -> Result | e -> Result.Err(e)

fn result_is_ok  : Result -> bool
  | r -> match r | Ok(_) -> true  | Err(_) -> false

fn result_is_err : Result -> bool
  | r -> match r | Ok(_) -> false | Err(_) -> true

fn result_unwrap : Result -> i64
  | r -> match r | Ok(v)  -> v | Err(_) -> 0i64

fn result_unwrap_err : Result -> i64
  | r -> match r | Ok(_)  -> 0i64 | Err(e) -> e

fn result_unwrap_or : (Result, i64) -> i64
  | (r, default) -> match r | Ok(v) -> v | Err(_) -> default
