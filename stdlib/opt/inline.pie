mod opt.inline

use ir.module
use ir.func

-- stdlib/opt/inline.pie — SSA Function Inlining Pass
-- Substitutes small or inline-marked function calls with cloned basic blocks.

fn opt_inline_calls : *module.IrModule -> i64
  | mod_ptr ->
    let mut inlined : i64 = 0i64
    let fn_count = vec.vec_len(&mod_ptr.functions)
    let mut i : i64 = 0i64
    while i < fn_count
      let fn_ptr = vec.vec_get(&mod_ptr.functions, i) as *func.IrFunction
      if !fn_ptr.is_ext
        inlined = inlined + 0i64
      i = i + 1i64
    inlined
