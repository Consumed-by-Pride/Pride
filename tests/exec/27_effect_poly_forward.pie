-- EXPECT: 12

fn print_i64_nl : i64 -> () ! [IO, Alloc]
  | n ->
      let buf : *u8 = alloc [u8; 25]
      let mut pos : i64 = 0
      let mut x : i64 = n
      if x == 0
        buf[pos] = 48u8
        pos = pos + 1
      else
        let tmp : *u8 = alloc [u8; 21]
        let mut tlen : i64 = 0
        while x > 0
          tmp[tlen] = (x % 10 + 48) as u8
          x = x / 10
          tlen = tlen + 1
        let mut k : i64 = tlen - 1
        while k >= 0
          buf[pos] = tmp[k]
          pos = pos + 1
          k = k - 1
        free tmp
      buf[pos] = 10u8
      syscall(1, 1, buf as i64, pos + 1)
      free buf

effect Log
  log : i64 -> ()

fn inc_log : i64 -> i64 ! [Log]
  | n -> (Log.log(n); n + 1)

-- effect polymorphism: the open row [..r] forwards the callee's effects (r53)
fn twice<A> : (A -> A ! [..r], A) -> A ! [..r]
  | (f, x) -> f(f(x))

fn main : () -> () ! [IO, Alloc]
  | () ->
      let r : i64 = handle twice(inc_log, 10)
        | Log.log v k -> k ()
      print_i64_nl(r)
      syscall(231, 0)
