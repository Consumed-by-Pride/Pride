-- EXPECT: 52
-- MSP stage passthrough: 'stage expr' unwraps the inner expr at compile time.
-- When stage evaluation isn't folded (no comptime context), the expression
-- falls through to runtime. y=42, stage y+10 should evaluate to y+10=52.
fn print_i64_nl : i64 -> () ! [IO, Alloc]
  | n ->
      let buf : *u8 = alloc [u8; 25]
      let mut pos : i64 = 0
      let mut x : i64 = n
      if x == 0
        buf[pos] = 48u8
        pos = pos + 1
      else
        let tmp : *u8 = alloc [u8; 21]
        let mut tlen : i64 = 0
        while x > 0
          tmp[tlen] = (x % 10 + 48) as u8
          x = x / 10
          tlen = tlen + 1
        let mut k : i64 = tlen - 1
        while k >= 0
          buf[pos] = tmp[k]
          pos = pos + 1
          k = k - 1
        free tmp
      buf[pos] = 10u8
      syscall(1, 1, buf as i64, pos + 1)
      free buf

fn compute : i64 -> i64
  | y ->
      let b = stage y + 10
      b

fn main : () -> () ! [IO, Alloc]
  | () ->
      print_i64_nl(compute(42))
      syscall(231, 0)
