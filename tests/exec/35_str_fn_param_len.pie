-- EXPECT: 5\n2\n

fn print_i64_nl : i64 -> () ! [IO, Alloc]
  | n ->
      let buf : *u8 = alloc [u8; 25]
      let mut pos : i64 = 0
      let mut x : i64 = n
      if x == 0
        buf[pos] = 48u8
        pos = pos + 1
      else
        let tmp : *u8 = alloc [u8; 21]
        let mut tlen : i64 = 0
        while x > 0
          tmp[tlen] = (x % 10 + 48) as u8
          x = x / 10
          tlen = tlen + 1
        let mut k : i64 = tlen - 1
        while k >= 0
          buf[pos] = tmp[k]
          pos = pos + 1
          k = k - 1
        free tmp
      buf[pos] = 10u8
      syscall(1, 1, buf as i64, pos + 1)
      free buf
fn slen : Str -> i64
  | s -> s.len
fn blen : Str -> i64
  | b ->
      let n : i64 = b.len
      n - 3
fn main : () -> () ! [IO, Alloc]
  | () ->
      print_i64_nl(slen("hello"))
      print_i64_nl(blen("hello"))
      syscall(231, 0)
