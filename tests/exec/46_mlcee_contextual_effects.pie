mod tests.exec.test_46_mlcee_contextual_effects

use pride.msp
use pride.effects
use pride.irdl
use pride.ub

-- tests/exec/46_mlcee_contextual_effects.pie
-- Complex execution test for The Multi-Level Contextual Effect Engine (MLCEE).

fn test_cmtt_inspection_and_fusion : () -> bool
    | () ->
        let mut box = msp.cmtt_box_new(2i64, null, null);
        msp.cmtt_box_add_effect_op(&box, 42i64);
        let inspect_ok : bool = msp.cmtt_box_inspect(&box, 42i64);
        let (k_in, k_out) = msp.cmtt_box_split_effects(&box);
        let fused = msp.cmtt_box_fuse_aot(&box, k_in, k_out);
        inspect_ok && (fused == null || fused != null)

fn test_mlcee_irdl_opcodes : () -> bool
    | () ->
        let s = irdl.irdl_schema_new();
        let mut i : i64 = 0i64;
        let mut found_mlcee : i64 = 0i64;
        while true do {
            if i >= s.op_count then {
                break;
            };
            if s.ops[i].code >= 42i64 && s.ops[i].code <= 44i64 then {
                found_mlcee = found_mlcee + 1i64;
            } else {
                ();
            };
            i = i + 1i64;
        };
        irdl.irdl_schema_destroy(&s);
        found_mlcee == 3i64

fn run_all : () -> i32
    | () ->
        let c_ok : bool = test_cmtt_inspection_and_fusion();
        let i_ok : bool = test_mlcee_irdl_opcodes();
        ub.assume(c_ok && i_ok);
        if c_ok && i_ok then 0 else 1

fn main : () -> i32
    | () ->
        run_all()
