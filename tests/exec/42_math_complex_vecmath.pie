-- EXPECT: 81\n10\n56\n0\n0\n1\n

fn print_i64_nl : i64 -> () ! [IO, Alloc]
  | n ->
      let buf : *u8 = alloc [u8; 25]
      let mut pos : i64 = 0
      let mut x : i64 = n
      if x == 0
        buf[pos] = 48u8
        pos = pos + 1
      else
        let mut neg = false
        if x < 0
          neg = true
          x = -x
        let tmp : *u8 = alloc [u8; 21]
        let mut tlen : i64 = 0
        while x > 0
          tmp[tlen] = (x % 10 + 48) as u8
          x = x / 10
          tlen = tlen + 1
        if neg
          tmp[tlen] = 45u8
          tlen = tlen + 1
        let mut k : i64 = tlen - 1
        while k >= 0
          buf[pos] = tmp[k]
          pos = pos + 1
          k = k - 1
        free tmp
      buf[pos] = 10u8
      syscall(1, 1, buf as i64, pos + 1)
      free buf

fn pow_i64 : (i64, i64) -> i64
  | (base, exp) ->
    if exp < 0i64 then 0i64
    else if exp == 0i64 then 1i64
    else
      let mut res : i64 = 1i64
      let mut b = base
      let mut e = exp
      while e > 0i64
        if (e & 1i64) != 0i64
          res = res * b
        b = b * b
        e = e >> 1i64
      res

fn pow_mod_u64 : (u64, u64, u64) -> u64
  | (base, exp, mod_val) ->
    if mod_val <= 1u64 then 0u64
    else
      let mut res : u64 = 1u64
      let mut b = base % mod_val
      let mut e = exp
      while e > 0u64
        if (e & 1u64) != 0u64
          res = (res * b) % mod_val
        b = (b * b) % mod_val
        e = e >> 1u64
      res

struct Vec3
  x : i64
  y : i64
  z : i64

fn vec3_dot : (Vec3, Vec3) -> i64
  | (a, b) -> a.x * b.x + a.y * b.y + a.z * b.z

fn vec3_cross : (Vec3, Vec3) -> Vec3
  | (a, b) -> Vec3 {
      x: a.y * b.z - a.z * b.y,
      y: a.z * b.x - a.x * b.z,
      z: a.x * b.y - a.y * b.x
    }

fn main : () -> () ! [IO, Alloc]
  | () ->
      print_i64_nl(pow_i64(3i64, 4i64))
      print_i64_nl(pow_mod_u64(7u64, 5u64, 11u64) as i64)
      let v1 = Vec3 { x: 2i64, y: 3i64, z: 4i64 }
      let v2 = Vec3 { x: 5i64, y: 6i64, z: 7i64 }
      print_i64_nl(vec3_dot(v1, v2))
      let x_axis = Vec3 { x: 1i64, y: 0i64, z: 0i64 }
      let y_axis = Vec3 { x: 0i64, y: 1i64, z: 0i64 }
      let z_axis = vec3_cross(x_axis, y_axis)
      print_i64_nl(z_axis.x)
      print_i64_nl(z_axis.y)
      print_i64_nl(z_axis.z)
      syscall(231, 0)
