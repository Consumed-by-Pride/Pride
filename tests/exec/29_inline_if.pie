-- EXPECT: 9\n1\n20\n

fn print_i64_nl : i64 -> () ! [IO, Alloc]
  | n ->
      let buf : *u8 = alloc [u8; 25]
      let mut pos : i64 = 0
      let mut x : i64 = n
      if x == 0
        buf[pos] = 48u8
        pos = pos + 1
      else
        let tmp : *u8 = alloc [u8; 21]
        let mut tlen : i64 = 0
        while x > 0
          tmp[tlen] = (x % 10 + 48) as u8
          x = x / 10
          tlen = tlen + 1
        let mut k : i64 = tlen - 1
        while k >= 0
          buf[pos] = tmp[k]
          pos = pos + 1
          k = k - 1
        free tmp
      buf[pos] = 10u8
      syscall(1, 1, buf as i64, pos + 1)
      free buf

fn main : () -> () ! [IO, Alloc]
  | () ->
      let a : i64 = 5
      let b : i64 = 9
      -- inline if-then-else as a value, both branches
      let m : i64 = if a > b then a else b
      print_i64_nl(m)
      print_i64_nl(if a < b then 1 else 2)
      -- chained inline ifs
      let x : i64 = 1
      print_i64_nl(if x == 0 then 10 else if x == 1 then 20 else 30)
      syscall(231, 0)
