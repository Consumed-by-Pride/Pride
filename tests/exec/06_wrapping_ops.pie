-- EXPECT: -2147483648\n2147483647
fn print_i64_nl : i64 -> () ! [IO, Alloc]
  | n ->
      let buf : *u8 = alloc [u8; 25]
      let mut pos : i64 = 0
      let mut x : i64 = n
      if x < 0
        buf[pos] = 45u8
        pos = pos + 1
        x = 0 - x
      if x == 0
        buf[pos] = 48u8
        pos = pos + 1
      else
        let tmp : *u8 = alloc [u8; 21]
        let mut tlen : i64 = 0
        while x > 0
          tmp[tlen] = (x % 10 + 48) as u8
          x = x / 10
          tlen = tlen + 1
        let mut k : i64 = tlen - 1
        while k >= 0
          buf[pos] = tmp[k]
          pos = pos + 1
          k = k - 1
        free tmp
      buf[pos] = 10u8
      syscall(1, 1, buf as i64, pos + 1)
      free buf

fn main : () -> () ! [IO, Alloc]
  | () ->
      -- 2147483647 + 1 wraps to -2147483648
      let a : i32 = 2147483647i32
      let b : i32 = 1i32
      let c : i32 = a +% b
      print_i64_nl(c as i64)
      -- i32 min - 1 wraps to i32 max = 2147483647
      -- i32 min computed as: 0 -% 2147483647 -% 1
      let mn : i32 = 0i32 -% 2147483647i32 -% 1i32
      let f : i32 = mn -% 1i32
      print_i64_nl(f as i64)
      syscall(231, 0)
