-- EXPECT: 11\n4\n6
struct Vec2
  x : i64
  y : i64
fn make_vec2 : (i64, i64) -> Vec2
  | (x, y) -> Vec2 { x: x, y: y }
fn dot : (Vec2, Vec2) -> i64
  | (a, b) -> a.x * b.x + a.y * b.y
fn add_vec2 : (Vec2, Vec2) -> Vec2
  | (a, b) -> Vec2 { x: a.x + b.x, y: a.y + b.y }
fn print_i64_nl : i64 -> () ! [IO, Alloc]
  | n ->
      let buf : *u8 = alloc [u8; 25]
      let mut pos : i64 = 0
      let mut x : i64 = n
      if x == 0
        buf[pos] = 48u8
        pos = pos + 1
      else
        let tmp : *u8 = alloc [u8; 21]
        let mut tlen : i64 = 0
        while x > 0
          tmp[tlen] = (x % 10 + 48) as u8
          x = x / 10
          tlen = tlen + 1
        let mut k : i64 = tlen - 1
        while k >= 0
          buf[pos] = tmp[k]
          pos = pos + 1
          k = k - 1
        free tmp
      buf[pos] = 10u8
      syscall(1, 1, buf as i64, pos + 1)
      free buf
fn main : () -> () ! [IO, Alloc]
  | () ->
      let a = make_vec2(3, 4)
      let b = make_vec2(1, 2)
      print_i64_nl(dot(a, b))
      let c = add_vec2(a, b)
      print_i64_nl(c.x)
      print_i64_nl(c.y)
      syscall(231, 0)
