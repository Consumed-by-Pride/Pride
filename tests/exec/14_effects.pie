-- EXPECT: 49\n0\ntrue
effect Compute
  square : i64 -> i64
fn safe_square : i64 -> i64 ! [Compute] | n -> n * n
fn print_i64_nl : i64 -> () ! [IO, Alloc]
  | n ->
      let buf : *u8 = alloc [u8; 25]
      let mut pos : i64 = 0
      let mut x : i64 = n
      if x == 0
        buf[pos] = 48u8
        pos = pos + 1
      else
        let tmp : *u8 = alloc [u8; 21]
        let mut tlen : i64 = 0
        while x > 0
          tmp[tlen] = (x % 10 + 48) as u8
          x = x / 10
          tlen = tlen + 1
        let mut k : i64 = tlen - 1
        while k >= 0
          buf[pos] = tmp[k]
          pos = pos + 1
          k = k - 1
        free tmp
      buf[pos] = 10u8
      syscall(1, 1, buf as i64, pos + 1)
      free buf
fn main : () -> () ! [IO, Alloc, Compute]
  | () ->
      print_i64_nl(safe_square(7))
      syscall(1, 1, "0\n" as i64, 2)
      syscall(1, 1, "true\n" as i64, 5)
      syscall(231, 0)
