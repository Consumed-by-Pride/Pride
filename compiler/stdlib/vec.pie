-- stdlib/vec.pie — Vec: heap-allocated growable array of i64
-- Pride standard library. No borrow checker. Trust the programmer.
--
-- Layout (struct Vec): ptr(*u8) + len(usize) + cap(usize)
-- Elements are i64 (8 bytes each). Generic versions via monomorphizer.
--
-- extern C bindings
fn malloc_vec : usize -> ptr #extern("malloc") #cc(c)
fn free_vec   : ptr   -> ()  #extern("free")   #cc(c)
fn memcpy_vec : (ptr, ptr, usize) -> ptr #extern("memcpy") #cc(c)

struct Vec
  ptr : ptr
  len : usize
  cap : usize

-- Empty Vec, no allocation.
fn vec_new : () -> Vec
  | () -> Vec { ptr: 0 as ptr, len: 0, cap: 0 }

-- Vec pre-allocated for n i64 elements.
fn vec_with_cap : usize -> Vec
  | (n) ->
      let bytes = n * 8
      let p = malloc_vec(bytes)
      Vec { ptr: p, len: 0, cap: n }

-- Internal: grow to new_cap elements.
fn vec_grow : (*Vec, usize) -> ()
  | (v, new_cap) ->
      let bytes = new_cap * 8
      let p2 = malloc_vec(bytes)
      if v.len > 0
        memcpy_vec(p2, v.ptr, v.len * 8)
      if v.cap > 0
        free_vec(v.ptr)
      v.ptr = p2
      v.cap = new_cap

-- Push x onto end. Doubles capacity when full. Amortized O(1).
fn vec_push : (*Vec, i64) -> ()
  | (v, x) ->
      if v.len >= v.cap
        let nc = if v.cap == 0 then 4 else v.cap * 2
        vec_grow(v, nc)
      let offset = v.len * 8
      let dst_addr = (v.ptr as usize) + offset
      let dst = dst_addr as *i64
      *dst = x
      v.len = v.len + 1

-- Pop last element. Returns (true, value) or (false, 0) if empty.
fn vec_pop : *Vec -> (bool, i64)
  | (v) ->
      if v.len == 0
        (false, 0i64)
      else
        v.len = v.len - 1
        let offset = v.len * 8
        let src_addr = (v.ptr as usize) + offset
        let src = src_addr as *i64
        (true, *src)

-- Get element at index i (unchecked).
fn vec_get : (*Vec, usize) -> i64
  | (v, i) ->
      let addr = (v.ptr as usize) + i * 8
      *(addr as *i64)

-- Set element at index i to x (unchecked).
fn vec_set : (*Vec, usize, i64) -> ()
  | (v, i, x) ->
      let addr = (v.ptr as usize) + i * 8
      let dst = addr as *i64
      *dst = x

fn vec_len : *Vec -> usize
  | (v) -> v.len
fn vec_cap : *Vec -> usize
  | (v) -> v.cap

-- Free backing store.
fn vec_free : *Vec -> ()
  | (v) ->
      if v.cap > 0
        free_vec(v.ptr)
      v.ptr = 0 as ptr
      v.len = 0
      v.cap = 0

-- Reset length to 0, keep allocation.
fn vec_clear : *Vec -> ()
  | (v) -> v.len = 0

-- Ensure capacity for at least len+n more elements.
fn vec_reserve : (*Vec, usize) -> ()
  | (v, n) ->
      let need = v.len + n
      if need > v.cap
        let nc = if v.cap == 0 then n else v.cap * 2
        let nc2 = if nc < need then need else nc
        vec_grow(v, nc2)

-- Swap two elements (unchecked).
fn vec_swap : (*Vec, usize, usize) -> ()
  | (v, i, j) ->
      let tmp = vec_get(v, i)
      vec_set(v, i, vec_get(v, j))
      vec_set(v, j, tmp)

-- Reverse in place.
fn vec_reverse : *Vec -> ()
  | (v) ->
      let mut lo : usize = 0
      let mut hi : usize = if v.len == 0 then 0 else v.len - 1
      while lo < hi
        vec_swap(v, lo, hi)
        lo = lo + 1
        hi = hi - 1
