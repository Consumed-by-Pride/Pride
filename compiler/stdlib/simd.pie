-- stdlib/simd.pie — SIMD type wrappers and intrinsics via LLVM vector types.
-- These are thin Pride wrappers; the actual SIMD ops use inline IR via extern.
-- Supported: f32x4 (SSE/NEON), i32x4, f64x2, i64x2, f32x8 (AVX), i32x8.

-- ─── Runtime SIMD ops (implemented in runtime.c) ────────────────────────────
fn simd_f32x4_add  : (ptr, ptr) -> ptr  #extern("__pride_simd_f32x4_add")  #cc(c)
fn simd_f32x4_sub  : (ptr, ptr) -> ptr  #extern("__pride_simd_f32x4_sub")  #cc(c)
fn simd_f32x4_mul  : (ptr, ptr) -> ptr  #extern("__pride_simd_f32x4_mul")  #cc(c)
fn simd_f32x4_div  : (ptr, ptr) -> ptr  #extern("__pride_simd_f32x4_div")  #cc(c)
fn simd_f32x4_sqrt : ptr -> ptr         #extern("__pride_simd_f32x4_sqrt") #cc(c)
fn simd_f32x4_fma  : (ptr, ptr, ptr) -> ptr #extern("__pride_simd_f32x4_fma") #cc(c)
fn simd_f32x4_dot  : (ptr, ptr) -> f32  #extern("__pride_simd_f32x4_dot")  #cc(c)
fn simd_f32x4_sum  : ptr -> f32         #extern("__pride_simd_f32x4_sum")  #cc(c)
fn simd_f32x4_min  : (ptr, ptr) -> ptr  #extern("__pride_simd_f32x4_min")  #cc(c)
fn simd_f32x4_max  : (ptr, ptr) -> ptr  #extern("__pride_simd_f32x4_max")  #cc(c)

fn simd_i32x4_add  : (ptr, ptr) -> ptr  #extern("__pride_simd_i32x4_add")  #cc(c)
fn simd_i32x4_sub  : (ptr, ptr) -> ptr  #extern("__pride_simd_i32x4_sub")  #cc(c)
fn simd_i32x4_mul  : (ptr, ptr) -> ptr  #extern("__pride_simd_i32x4_mul")  #cc(c)
fn simd_i32x4_and  : (ptr, ptr) -> ptr  #extern("__pride_simd_i32x4_and")  #cc(c)
fn simd_i32x4_or   : (ptr, ptr) -> ptr  #extern("__pride_simd_i32x4_or")   #cc(c)

fn malloc_simd : usize -> ptr  #extern("malloc") #cc(c)
fn free_simd   : ptr   -> ()   #extern("free")   #cc(c)

-- ─── f32x4: 4-lane 32-bit float vector ───────────────────────────────────────
struct F32x4
  data : ptr   -- 16-byte aligned *f32[4]

fn f32x4_new : (f32, f32, f32, f32) -> F32x4
  | (a, b, c, d) ->
      let p = malloc_simd(16) as *f32
      *p = a
      *((p as usize + 4) as *f32) = b
      *((p as usize + 8) as *f32) = c
      *((p as usize + 12) as *f32) = d
      F32x4 { data: p as ptr }

fn f32x4_splat : f32 -> F32x4
  | (v) -> f32x4_new(v, v, v, v)

fn f32x4_get : (*F32x4, usize) -> f32
  | (v, i) -> *((v.data as usize + i * 4) as *f32)

fn f32x4_set : (*F32x4, usize, f32) -> ()
  | (v, i, x) ->
      *((v.data as usize + i * 4) as *f32) = x

fn f32x4_add : (*F32x4, *F32x4) -> F32x4
  | (a, b) -> F32x4 { data: simd_f32x4_add(a.data, b.data) }

fn f32x4_mul : (*F32x4, *F32x4) -> F32x4
  | (a, b) -> F32x4 { data: simd_f32x4_mul(a.data, b.data) }

fn f32x4_dot : (*F32x4, *F32x4) -> f32
  | (a, b) -> simd_f32x4_dot(a.data, b.data)

fn f32x4_sum : *F32x4 -> f32
  | (v) -> simd_f32x4_sum(v.data)

fn f32x4_free : *F32x4 -> ()
  | (v) -> free_simd(v.data)

-- ─── i32x4: 4-lane 32-bit integer vector ─────────────────────────────────────
struct I32x4
  data : ptr

fn i32x4_new : (i32, i32, i32, i32) -> I32x4
  | (a, b, c, d) ->
      let p = malloc_simd(16) as *i32
      *p = a
      *((p as usize + 4) as *i32) = b
      *((p as usize + 8) as *i32) = c
      *((p as usize + 12) as *i32) = d
      I32x4 { data: p as ptr }

fn i32x4_splat : i32 -> I32x4
  | (v) -> i32x4_new(v, v, v, v)

fn i32x4_add : (*I32x4, *I32x4) -> I32x4
  | (a, b) -> I32x4 { data: simd_i32x4_add(a.data, b.data) }

fn i32x4_free : *I32x4 -> ()
  | (v) -> free_simd(v.data)
