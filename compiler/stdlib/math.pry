-- stdlib/math.pry — Math intrinsics: float functions + wrapping/saturating arithmetic
-- All float functions are thin wrappers over libm via extern declarations.

-- ─── Float math (libm wrappers) ──────────────────────────────────────────────
fn sin   : f64 -> f64  #extern("sin")   #cc(c)
fn cos   : f64 -> f64  #extern("cos")   #cc(c)
fn tan   : f64 -> f64  #extern("tan")   #cc(c)
fn asin  : f64 -> f64  #extern("asin")  #cc(c)
fn acos  : f64 -> f64  #extern("acos")  #cc(c)
fn atan  : f64 -> f64  #extern("atan")  #cc(c)
fn atan2 : (f64, f64) -> f64 #extern("atan2") #cc(c)
fn sinh  : f64 -> f64  #extern("sinh")  #cc(c)
fn cosh  : f64 -> f64  #extern("cosh")  #cc(c)
fn tanh  : f64 -> f64  #extern("tanh")  #cc(c)
fn exp   : f64 -> f64  #extern("exp")   #cc(c)
fn exp2  : f64 -> f64  #extern("exp2")  #cc(c)
fn log   : f64 -> f64  #extern("log")   #cc(c)
fn log2  : f64 -> f64  #extern("log2")  #cc(c)
fn log10 : f64 -> f64  #extern("log10") #cc(c)
fn pow   : (f64, f64) -> f64 #extern("pow") #cc(c)
fn sqrt  : f64 -> f64  #extern("sqrt")  #cc(c)
fn cbrt  : f64 -> f64  #extern("cbrt")  #cc(c)
fn hypot : (f64, f64) -> f64 #extern("hypot") #cc(c)
fn fabs  : f64 -> f64  #extern("fabs")  #cc(c)
fn floor : f64 -> f64  #extern("floor") #cc(c)
fn ceil  : f64 -> f64  #extern("ceil")  #cc(c)
fn round : f64 -> f64  #extern("round") #cc(c)
fn trunc : f64 -> f64  #extern("trunc") #cc(c)
fn fmod  : (f64, f64) -> f64 #extern("fmod")  #cc(c)
fn fma   : (f64, f64, f64) -> f64 #extern("fma") #cc(c)
fn copysign : (f64, f64) -> f64 #extern("copysign") #cc(c)

-- f32 variants
fn sinf  : f32 -> f32  #extern("sinf")  #cc(c)
fn cosf  : f32 -> f32  #extern("cosf")  #cc(c)
fn sqrtf : f32 -> f32  #extern("sqrtf") #cc(c)
fn expf  : f32 -> f32  #extern("expf")  #cc(c)
fn logf  : f32 -> f32  #extern("logf")  #cc(c)
fn powf  : (f32, f32) -> f32 #extern("powf") #cc(c)
fn fabsf : f32 -> f32  #extern("fabsf") #cc(c)
fn floorf: f32 -> f32  #extern("floorf") #cc(c)
fn ceilf : f32 -> f32  #extern("ceilf") #cc(c)
fn roundf: f32 -> f32  #extern("roundf") #cc(c)
fn fmaf  : (f32, f32, f32) -> f32 #extern("fmaf") #cc(c)

-- ─── Float constants ──────────────────────────────────────────────────────────
let PI     : f64 = 3.141592653589793
let E      : f64 = 2.718281828459045
let SQRT2  : f64 = 1.4142135623730951
let LN2    : f64 = 0.6931471805599453
let LN10   : f64 = 2.302585092994046
let LOG2E  : f64 = 1.4426950408889634
let LOG10E : f64 = 0.4342944819032518
let TAU    : f64 = 6.283185307179586
let INF    : f64 = 1.0 / 0.0
let NAN    : f64 = 0.0 / 0.0
let EPSILON: f64 = 2.220446049250313e-16

-- ─── Wrapping arithmetic (i64) ────────────────────────────────────────────────
-- These always return the low 64 bits — no UB, no trapping.
fn wrapping_add : (i64, i64) -> i64
  | (a, b) -> a + b

fn wrapping_sub : (i64, i64) -> i64
  | (a, b) -> a - b

fn wrapping_mul : (i64, i64) -> i64
  | (a, b) -> a * b

fn wrapping_neg : i64 -> i64
  | (a) -> 0 - a

fn wrapping_shl : (i64, u32) -> i64
  | (a, n) -> a << n

fn wrapping_shr : (i64, u32) -> i64
  | (a, n) -> a >> n

-- ─── Saturating arithmetic (i64) ──────────────────────────────────────────────
-- Clamp to [I64_MIN, I64_MAX] on overflow instead of wrapping.
let I64_MAX : i64 = 9223372036854775807
let I64_MIN : i64 = 0 - 9223372036854775807 - 1

fn saturating_add : (i64, i64) -> i64
  | (a, b) ->
      let r = a + b
      if (a > 0 && b > 0 && r < 0) then I64_MAX
      else if (a < 0 && b < 0 && r > 0) then I64_MIN
      else r

fn saturating_sub : (i64, i64) -> i64
  | (a, b) ->
      let r = a - b
      if (b < 0 && r < a) then I64_MAX
      else if (b > 0 && r > a) then I64_MIN
      else r

fn saturating_mul : (i64, i64) -> i64
  | (a, b) ->
      if b == 0 then 0
      else
        let r = a * b
        if r / b != a then
          if (a > 0) == (b > 0) then I64_MAX else I64_MIN
        else r

-- u64 saturating
let U64_MAX : u64 = 18446744073709551615

fn saturating_add_u : (u64, u64) -> u64
  | (a, b) ->
      let r = a + b
      if r < a then U64_MAX else r

fn saturating_sub_u : (u64, u64) -> u64
  | (a, b) ->
      if b > a then 0 else a - b

-- ─── Min / Max / Clamp ────────────────────────────────────────────────────────
fn min_i64 : (i64, i64) -> i64
  | (a, b) -> if a < b then a else b
fn max_i64 : (i64, i64) -> i64
  | (a, b) -> if a > b then a else b
fn clamp_i64 : (i64, i64, i64) -> i64
  | (v, lo, hi) -> if v < lo then lo else if v > hi then hi else v

fn min_f64 : (f64, f64) -> f64
  | (a, b) -> if a < b then a else b
fn max_f64 : (f64, f64) -> f64
  | (a, b) -> if a > b then a else b
fn clamp_f64 : (f64, f64, f64) -> f64
  | (v, lo, hi) -> if v < lo then lo else if v > hi then hi else v

fn abs_i64 : i64 -> i64
  | (a) -> if a < 0 then 0 - a else a
fn abs_f64 : f64 -> f64
  | (x) -> fabs(x)

-- ─── Integer power ───────────────────────────────────────────────────────────
fn ipow : (i64, u32) -> i64
  | (base, exp) ->
      let mut result : i64 = 1
      let mut b      : i64 = base
      let mut e      : u32 = exp
      while e > 0
        if e & 1 != 0 then result = result * b
        b = b * b
        e = e >> 1
      result

-- ─── GCD / LCM ───────────────────────────────────────────────────────────────
fn gcd : (i64, i64) -> i64
  | (a, b) ->
      let mut x : i64 = if a < 0 then 0 - a else a
      let mut y : i64 = if b < 0 then 0 - b else b
      while y != 0
        let t = y
        y = x % y
        x = t
      x

fn lcm : (i64, i64) -> i64
  | (a, b) ->
      let g = gcd(a, b)
      if g == 0 then 0 else (a / g) * b

-- ─── Byte swap ───────────────────────────────────────────────────────────────
fn bswap_i64 : i64 -> i64
  | (x) ->
      let a = x & 0xFF
      let b = (x >> 8)  & 0xFF
      let c = (x >> 16) & 0xFF
      let d = (x >> 24) & 0xFF
      let e = (x >> 32) & 0xFF
      let f = (x >> 40) & 0xFF
      let g = (x >> 48) & 0xFF
      let h = (x >> 56) & 0xFF
      (a << 56) | (b << 48) | (c << 40) | (d << 32) | (e << 24) | (f << 16) | (g << 8) | h

fn bswap_i32 : i32 -> i32
  | (x) ->
      let a = x & 0xFF
      let b = (x >> 8)  & 0xFF
      let c = (x >> 16) & 0xFF
      let d = (x >> 24) & 0xFF
      (a << 24) | (b << 16) | (c << 8) | d

-- ─── to_be / to_le (big/little endian conversion) ────────────────────────────
fn to_be_i64 : i64 -> i64
  | (x) -> bswap_i64(x)   -- assumes little-endian host (x86_64)

fn to_le_i64 : i64 -> i64
  | (x) -> x               -- already little-endian on x86_64

fn from_be_i64 : i64 -> i64
  | (x) -> bswap_i64(x)

fn from_le_i64 : i64 -> i64
  | (x) -> x

-- ─── wrapping/saturating for i32 ─────────────────────────────────────────────
let I32_MAX : i32 = 2147483647
let I32_MIN : i32 = 0 - 2147483647 - 1

fn wrapping_add_i32 : (i32, i32) -> i32
  | (a, b) -> a + b   -- LLVM add is already wrapping for integers

fn saturating_add_i32 : (i32, i32) -> i32
  | (a, b) ->
      let r : i64 = (a as i64) + (b as i64)
      if r > (I32_MAX as i64) then I32_MAX
      else if r < (I32_MIN as i64) then I32_MIN
      else r as i32

fn saturating_sub_i32 : (i32, i32) -> i32
  | (a, b) ->
      let r : i64 = (a as i64) - (b as i64)
      if r > (I32_MAX as i64) then I32_MAX
      else if r < (I32_MIN as i64) then I32_MIN
      else r as i32

-- ─── Integer sqrt ────────────────────────────────────────────────────────────
fn isqrt : i64 -> i64
  | (n) ->
      if n <= 0 then 0
      else
        let mut x : i64 = n
        let mut y : i64 = (x + 1) / 2
        while y < x
          x = y
          y = (x + n / x) / 2
        x

-- ─── Checked arithmetic (returns (bool, value) — true = overflow) ────────────
fn checked_add : (i64, i64) -> (bool, i64)
  | (a, b) ->
      let r = a + b
      if (a > 0 && b > 0 && r < 0) then (true, r)
      else if (a < 0 && b < 0 && r > 0) then (true, r)
      else (false, r)

fn checked_sub : (i64, i64) -> (bool, i64)
  | (a, b) ->
      let r = a - b
      if (b < 0 && r < a) then (true, r)
      else if (b > 0 && r > a) then (true, r)
      else (false, r)

fn checked_mul : (i64, i64) -> (bool, i64)
  | (a, b) ->
      if b == 0 then (false, 0)
      else
        let r = a * b
        (r / b != a, r)
