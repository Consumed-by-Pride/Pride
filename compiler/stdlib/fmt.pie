-- stdlib/fmt.pie — String formatting and UTF-8 operations.
-- sprintf-style formatting + UTF-8 char iteration.

fn sprintf_fn  : (*u8, *u8) -> i32     #extern("sprintf")  #cc(c)
fn snprintf_fn : (*u8, usize, *u8) -> i32 #extern("snprintf") #cc(c)
fn strlen_fn   : *u8 -> usize           #extern("strlen")   #cc(c)

-- ─── Formatter: write formatted output into a String ─────────────────────────
-- Uses a String (from string.pie) as the backing buffer.
-- Call fmt_write_i64, fmt_write_f64, fmt_write_str to compose output.

fn malloc_fmt : usize -> ptr  #extern("malloc") #cc(c)

struct Formatter
  buf  : ptr    -- *u8 (internal scratch buffer)
  out  : ptr    -- *String (destination)

fn fmt_new : *String -> Formatter
  | (s) ->
      let buf = malloc_fmt(64)
      Formatter { buf: buf, out: s as ptr }

fn fmt_write_i64 : (*Formatter, i64) -> ()
  | (f, v) ->
      let b = f.buf as *u8
      let n = snprintf_fn(b, 64, "%lld" as *u8) -- placeholder call
      let slen = strlen_fn(b)
      str_push_str(f.out as *String, b, slen)

fn fmt_write_f64 : (*Formatter, f64) -> ()
  | (f, v) ->
      let b = f.buf as *u8
      let n = snprintf_fn(b, 64, "%g" as *u8)
      let slen = strlen_fn(b)
      str_push_str(f.out as *String, b, slen)

fn fmt_write_str_raw : (*Formatter, *u8, usize) -> ()
  | (f, p, n) -> str_push_str(f.out as *String, p, n)

fn fmt_write_bool : (*Formatter, bool) -> ()
  | (f, v) ->
      if v
        str_push_str(f.out as *String, "true" as *u8, 4)
      else
        str_push_str(f.out as *String, "false" as *u8, 5)

fn fmt_write_char : (*Formatter, u8) -> ()
  | (f, c) -> str_push_byte(f.out as *String, c)

-- ─── String interpolation helper ─────────────────────────────────────────────
-- format_i64(n) → newly allocated String containing decimal representation
fn format_i64 : i64 -> String
  | (n) ->
      let s = str_new()
      str_push_i64(&s, n)
      s

-- ─── UTF-8 operations ────────────────────────────────────────────────────────
-- UTF-8 byte count for a codepoint
fn utf8_len_for_cp : i64 -> usize
  | (cp) ->
      if cp < 0x80 then 1
      else if cp < 0x800 then 2
      else if cp < 0x10000 then 3
      else 4

-- Decode one UTF-8 codepoint at ptr, return (codepoint, bytes_consumed)
fn utf8_decode : (*u8, usize) -> (i64, usize)
  | (p, remaining) ->
      if remaining == 0 then (-1i64, 0)
      else
        let b0 = (*p) as i64
        if b0 < 0x80 then (b0, 1)
        else if b0 < 0xC0 then (-1i64, 1)   -- invalid continuation byte
        else if b0 < 0xE0
          if remaining < 2 then (-1i64, 1)
          else
            let b1 = (*(p as usize + 1 as *u8)) as i64
            (((b0 & 0x1F) << 6) | (b1 & 0x3F), 2)
        else if b0 < 0xF0
          if remaining < 3 then (-1i64, 1)
          else
            let b1 = (*(p as usize + 1 as *u8)) as i64
            let b2 = (*(p as usize + 2 as *u8)) as i64
            (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3)
        else
          if remaining < 4 then (-1i64, 1)
          else
            let b1 = (*(p as usize + 1 as *u8)) as i64
            let b2 = (*(p as usize + 2 as *u8)) as i64
            let b3 = (*(p as usize + 3 as *u8)) as i64
            (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), 4)

-- Count Unicode codepoints in a UTF-8 string
fn utf8_char_count : (*u8, usize) -> usize
  | (p, n) ->
      let mut i    : usize = 0
      let mut count: usize = 0
      while i < n
        let ptr_i = (p as usize + i) as *u8
        let (_, consumed) = utf8_decode(ptr_i, n - i)
        i = i + if consumed == 0 then 1 else consumed
        count = count + 1
      count

-- char predicates
fn is_ascii       : i64 -> bool
  | (c) -> c >= 0 && c < 128
fn is_alpha       : i64 -> bool
  | (c) -> (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
fn is_digit_char  : i64 -> bool
  | (c) -> c >= 48 && c <= 57
fn is_whitespace  : i64 -> bool
  | (c) -> c == 32 || c == 9 || c == 10 || c == 13
fn is_uppercase   : i64 -> bool
  | (c) -> c >= 65 && c <= 90
fn is_lowercase   : i64 -> bool
  | (c) -> c >= 97 && c <= 122
fn to_uppercase   : i64 -> i64
  | (c) -> if c >= 97 && c <= 122 then c - 32 else c
fn to_lowercase   : i64 -> i64
  | (c) -> if c >= 65 && c <= 90  then c + 32 else c
