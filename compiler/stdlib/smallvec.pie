-- stdlib/smallvec.pie — SmallVec<N, i64>: N elements inline, spill to heap.
-- When len <= N, data lives in the inline buffer (no allocation).
-- Spills to heap when len > N.

fn malloc_sv : usize -> ptr  #extern("malloc") #cc(c)
fn free_sv   : ptr   -> ()   #extern("free")   #cc(c)
fn memcpy_sv : (ptr, ptr, usize) -> ptr #extern("memcpy") #cc(c)

-- SmallVec with N=8 inline slots. Each element is i64.
let SV_INLINE : usize = 8

struct SmallVec
  inline_buf : [i64; 8]   -- 8 inline i64 slots = 64 bytes
  heap_ptr   : ptr
  len        : usize
  cap        : usize       -- 0 = using inline, >0 = heap

fn sv_new : () -> SmallVec
  | () ->
      SmallVec {
        inline_buf: [0, 0, 0, 0, 0, 0, 0, 0],
        heap_ptr: 0 as ptr,
        len: 0,
        cap: 0
      }

fn sv_is_inline : *SmallVec -> bool
  | (s) -> s.cap == 0

fn sv_data_ptr : *SmallVec -> ptr
  | (s) ->
      if s.cap == 0
        &s.inline_buf[0] as ptr
      else
        s.heap_ptr

fn sv_get : (*SmallVec, usize) -> i64
  | (s, i) ->
      let p = (sv_data_ptr(s) as usize + i * 8) as *i64
      *p

fn sv_set : (*SmallVec, usize, i64) -> ()
  | (s, i, v) ->
      let p = (sv_data_ptr(s) as usize + i * 8) as *i64
      *p = v

fn sv_spill : *SmallVec -> ()
  | (s) ->
      if s.cap == 0
        let new_cap = SV_INLINE * 2
        let hp = malloc_sv(new_cap * 8)
        memcpy_sv(hp, &s.inline_buf[0] as ptr, s.len * 8)
        s.heap_ptr = hp
        s.cap = new_cap

fn sv_push : (*SmallVec, i64) -> ()
  | (s, v) ->
      if s.len >= SV_INLINE && s.cap == 0
        sv_spill(s)
      if s.cap > 0 && s.len >= s.cap
        let nc = s.cap * 2
        let hp2 = malloc_sv(nc * 8)
        memcpy_sv(hp2, s.heap_ptr, s.len * 8)
        free_sv(s.heap_ptr)
        s.heap_ptr = hp2
        s.cap = nc
      sv_set(s, s.len, v)
      s.len = s.len + 1

fn sv_pop : *SmallVec -> (bool, i64)
  | (s) ->
      if s.len == 0 then (false, 0i64)
      else
        s.len = s.len - 1
        (true, sv_get(s, s.len))

fn sv_len  : *SmallVec -> usize
  | (s) -> s.len
fn sv_clear: *SmallVec -> ()
  | (s) -> s.len = 0

fn sv_free : *SmallVec -> ()
  | (s) ->
      if s.cap > 0 then free_sv(s.heap_ptr)
      s.heap_ptr = 0 as ptr
      s.len = 0
      s.cap = 0
