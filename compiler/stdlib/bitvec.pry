-- stdlib/bitvec.pry — BitVec: space-efficient packed boolean array.
-- 64 bits per u64 word. O(1) get/set/clear. Growable.

fn malloc_bv : usize -> ptr  #extern("malloc") #cc(c)
fn free_bv   : ptr   -> ()   #extern("free")   #cc(c)
fn memset_bv : (ptr, i32, usize) -> ptr #extern("memset") #cc(c)
fn memcpy_bv : (ptr, ptr, usize) -> ptr #extern("memcpy") #cc(c)

struct BitVec
  words  : ptr   -- *u64
  nbits  : usize
  nwords : usize

fn bv_words_for : usize -> usize
  | (n) -> (n + 63) / 64

fn bv_new : () -> BitVec
  | () -> BitVec { words: 0 as ptr, nbits: 0, nwords: 0 }

fn bv_with_capacity : usize -> BitVec
  | (n) ->
      let nw = bv_words_for(n)
      let p  = malloc_bv(nw * 8)
      memset_bv(p, 0, nw * 8)
      BitVec { words: p, nbits: 0, nwords: nw }

fn bv_grow : (*BitVec, usize) -> ()
  | (bv, need_bits) ->
      let need_words = bv_words_for(need_bits)
      if need_words > bv.nwords
        let nc = if bv.nwords == 0 then need_words else bv.nwords * 2
        let nw = if nc < need_words then need_words else nc
        let p2 = malloc_bv(nw * 8)
        memset_bv(p2, 0, nw * 8)
        if bv.nwords > 0 then memcpy_bv(p2, bv.words, bv.nwords * 8)
        if bv.nwords > 0 then free_bv(bv.words)
        bv.words  = p2
        bv.nwords = nw

fn bv_get : (*BitVec, usize) -> bool
  | (bv, i) ->
      if i >= bv.nbits then false
      else
        let word_i = i / 64
        let bit_i  = i % 64
        let word   = *((bv.words as usize + word_i * 8) as *u64)
        (word >> bit_i) & 1 != 0

fn bv_set : (*BitVec, usize, bool) -> ()
  | (bv, i, v) ->
      if i >= bv.nbits then ()
      else
        let word_i = i / 64
        let bit_i  = i % 64
        let wp = (bv.words as usize + word_i * 8) as *u64
        if v
          *wp = *wp | (1 as u64 << bit_i)
        else
          *wp = *wp & !(1 as u64 << bit_i)

fn bv_push : (*BitVec, bool) -> ()
  | (bv, v) ->
      bv_grow(bv, bv.nbits + 1)
      bv.nbits = bv.nbits + 1
      bv_set(bv, bv.nbits - 1, v)

fn bv_count_ones : *BitVec -> usize
  | (bv) ->
      let mut count : usize = 0
      let mut w : usize = 0
      while w < bv.nwords
        let word = *((bv.words as usize + w * 8) as *u64)
        -- popcount via bit manipulation
        let mut x : u64 = word
        x = x - ((x >> 1) & 0x5555555555555555)
        x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333)
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F
        count = count + ((x * 0x0101010101010101) >> 56) as usize
        w = w + 1
      count

fn bv_len  : *BitVec -> usize
  | (bv) -> bv.nbits
fn bv_clear: *BitVec -> ()
  | (bv) -> bv.nbits = 0

fn bv_free : *BitVec -> ()
  | (bv) ->
      if bv.nwords > 0 then free_bv(bv.words)
      bv.words = 0 as ptr
      bv.nbits = 0
      bv.nwords = 0
