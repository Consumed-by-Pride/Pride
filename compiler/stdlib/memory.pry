-- stdlib/memory.pry — Memory primitives: unaligned, pool, stride_of, float bits
-- These wrap the runtime C implementations.

-- ─── stride_of ───────────────────────────────────────────────────────────────
fn stride_of_raw : i64 -> i64 #extern("__pryde_stride_of") #cc(c)

-- ─── Unaligned read/write ────────────────────────────────────────────────────
fn read_unaligned_i64 : ptr -> i64    #extern("__pryde_read_unaligned_i64")  #cc(c)
fn read_unaligned_i32 : ptr -> i32    #extern("__pryde_read_unaligned_i32")  #cc(c)
fn read_unaligned_i16 : ptr -> i16    #extern("__pryde_read_unaligned_i16")  #cc(c)
fn write_unaligned_i64 : (ptr, i64) -> () #extern("__pryde_write_unaligned_i64") #cc(c)
fn write_unaligned_i32 : (ptr, i32) -> () #extern("__pryde_write_unaligned_i32") #cc(c)
fn write_unaligned_i16 : (ptr, i16) -> () #extern("__pryde_write_unaligned_i16") #cc(c)

-- ─── Float bit manipulation ───────────────────────────────────────────────────
fn f64_to_bits   : f64 -> i64  #extern("__pryde_f64_to_bits")   #cc(c)
fn f64_from_bits : i64 -> f64  #extern("__pryde_f64_from_bits") #cc(c)
fn f32_to_bits   : f32 -> i32  #extern("__pryde_f32_to_bits")   #cc(c)
fn f32_from_bits : i32 -> f32  #extern("__pryde_f32_from_bits") #cc(c)
fn f64_nan       : () -> f64   #extern("__pryde_f64_nan")       #cc(c)
fn f64_inf       : () -> f64   #extern("__pryde_f64_inf")       #cc(c)
fn f64_is_nan    : f64 -> bool #extern("__pryde_f64_is_nan")    #cc(c)
fn f64_is_inf    : f64 -> bool #extern("__pryde_f64_is_inf")    #cc(c)
fn f64_is_finite : f64 -> bool #extern("__pryde_f64_is_finite") #cc(c)

-- ─── Pool allocator ──────────────────────────────────────────────────────────
fn pool_new_raw   : (i64, i64) -> ptr  #extern("__pryde_pool_new")      #cc(c)
fn pool_alloc_raw : ptr -> ptr         #extern("__pryde_pool_alloc")     #cc(c)
fn pool_free_raw  : (ptr, ptr) -> ()   #extern("__pryde_pool_free_slot") #cc(c)
fn pool_destroy   : ptr -> ()          #extern("__pryde_pool_destroy")   #cc(c)
fn pool_used      : ptr -> usize       #extern("__pryde_pool_used")      #cc(c)

struct Pool
  handle   : ptr
  obj_size : i64

fn pool_new : (i64, i64) -> Pool
  | (obj_size, cap) ->
      Pool { handle: pool_new_raw(obj_size, cap), obj_size: obj_size }

fn pool_alloc : *Pool -> ptr
  | (p) -> pool_alloc_raw(p.handle)

fn pool_free : (*Pool, ptr) -> ()
  | (p, obj) -> pool_free_raw(p.handle, obj)

fn pool_drop : *Pool -> ()
  | (p) -> pool_destroy(p.handle)
