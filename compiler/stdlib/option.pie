-- stdlib/option.pie — Option<T> and Result<T,E> (as enum types)
-- The canonical Pride stdlib error-handling types.

-- ─── Option ──────────────────────────────────────────────────────────────────
-- Option<i64>: Some(value) or None
-- Uses the discriminant encoding: tag=0 → None, tag=1 → Some(val)
-- Represented as { i32, i64 } per enum layout.

enum Option
  None,
  Some(i64),

fn option_some : i64 -> Option
  | (x) -> Option.Some(x)

fn option_none : () -> Option
  | () -> Option.None

fn option_is_some : Option -> bool
  | (o) ->
      match o
        | Some(_) -> true
        | None    -> false

fn option_is_none : Option -> bool
  | (o) ->
      match o
        | Some(_) -> false
        | None    -> true

fn option_unwrap : Option -> i64
  | (o) ->
      match o
        | Some(v) -> v
        | None    -> 0   -- panic in future; return 0 for now (programmer's responsibility)

fn option_unwrap_or : (Option, i64) -> i64
  | (o, default) ->
      match o
        | Some(v) -> v
        | None    -> default


fn result_ok  : i64 -> Result
  | (v) -> Result.Ok(v)
fn result_err : i64 -> Result
  | (e) -> Result.Err(e)

fn result_is_ok  : Result -> bool
  | (r) ->
      match r
        | Ok(_)  -> true
        | Err(_) -> false

fn result_is_err : Result -> bool
  | (r) ->
      match r
        | Ok(_)  -> false
        | Err(_) -> true

fn result_unwrap : Result -> i64
  | (r) ->
      match r
        | Ok(v)  -> v
        | Err(_) -> 0   -- programmer's responsibility

fn result_unwrap_err : Result -> i64
  | (r) ->
      match r
        | Ok(_)  -> 0
        | Err(e) -> e

fn result_unwrap_or : (Result, i64) -> i64
  | (r, default) ->
      match r
        | Ok(v)  -> v
        | Err(_) -> default


