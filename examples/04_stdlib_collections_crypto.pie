-- examples/04_stdlib_collections_crypto.pie
-- Linear-probe HashMap, VecDeque, struct-based sort, Option/Result enums.
-- Key rules: all mutable updates use `x = if cond then new else x` pattern.

fn malloc4 : i64 -> ptr  #extern("malloc") #cc(c)
fn free4   : ptr   -> () #extern("free")   #cc(c)
fn memset4 : (ptr, i32, i64) -> ptr #extern("memset") #cc(c)

-- ── §1  Linear-probe HashMap<i64, i64> ───────────────────────────────────────

let BUCKET : i64 = 24

struct HMap
  bkts : ptr
  mcap : i64
  mlen : i64

fn hm_new  : () -> HMap | () -> HMap { bkts: null, mcap: 0, mlen: 0 }
fn hm_baddr : (ptr, i64) -> i64   | (b, i) -> (b as i64) + i * BUCKET
fn hm_kptr  : (ptr, i64) -> *i64  | (b, i) -> hm_baddr(b, i) as *i64
fn hm_vptr  : (ptr, i64) -> *i64  | (b, i) -> (hm_baddr(b, i) + 8) as *i64
fn hm_uptr  : (ptr, i64) -> *bool | (b, i) -> (hm_baddr(b, i) + 16) as *bool
fn hm_hash  : (i64, i64) -> i64
  | (k, cap) ->
      let h = (14695981039346656037i64 ^ k) * 1099511628211i64
      let habs = if h < 0 then -h else h
      habs % cap

fn hm_rget_k : (i64, i64) -> i64   | (base, i) -> *((base + i * BUCKET) as *i64)
fn hm_rget_v : (i64, i64) -> i64   | (base, i) -> *((base + i * BUCKET + 8) as *i64)
fn hm_rget_u : (i64, i64) -> bool  | (base, i) -> *((base + i * BUCKET + 16) as *bool)

fn hm_grow : *HMap -> ()
  | m ->
      let nc      = if m.mcap == 0 then 16 else m.mcap * 2
      let old_cap = m.mcap
      let old_addr : i64 = m.bkts as i64   -- i64: no ptr-let double-indirection
      m.bkts = malloc4(nc * BUCKET)
      memset4(m.bkts, 0i32, nc * BUCKET)
      m.mcap  = nc
      if old_cap > 0
        let mut i : i64 = 0
        while i < old_cap
          if hm_rget_u(old_addr, i)
            let k2 = hm_rget_k(old_addr, i)
            let v2 = hm_rget_v(old_addr, i)
            let mut sl : i64 = hm_hash(k2, nc)
            while *hm_uptr(m.bkts, sl)
              sl = (sl + 1) % nc
            hm_rset_u(m.bkts, sl, true)
            hm_rset_k(m.bkts, sl, k2)
            hm_rset_v(m.bkts, sl, v2)
          i = i + 1
        free4(old_addr as ptr)

fn hm_bslot_addr : (ptr, i64) -> i64 | (b, i) -> (b as i64) + i * BUCKET
fn hm_rset_k : (ptr, i64, i64) -> () | (b, i, v) -> *((hm_bslot_addr(b, i)) as *i64) = v
fn hm_rset_v : (ptr, i64, i64) -> () | (b, i, v) -> *((hm_bslot_addr(b, i) + 8) as *i64) = v
fn hm_rset_u : (ptr, i64, bool) -> () | (b, i, v) -> *((hm_bslot_addr(b, i) + 16) as *bool) = v

fn hm_insert : (*HMap, i64, i64) -> ()
  | (m, k, v) ->
      if m.mcap == 0 || m.mlen * 100 >= m.mcap * 75
        hm_grow(m)
      let mut sl : i64 = hm_hash(k, m.mcap)
      while *hm_uptr(m.bkts, sl) && *hm_kptr(m.bkts, sl) != k
        sl = (sl + 1) % m.mcap
      let isnew = !*hm_uptr(m.bkts, sl)
      hm_rset_u(m.bkts, sl, true)
      m.mlen = if isnew then m.mlen + 1 else m.mlen
      hm_rset_k(m.bkts, sl, k)
      hm_rset_v(m.bkts, sl, v)

fn hm_get : (*HMap, i64) -> (bool, i64)
  | (m, k) ->
      if m.mcap == 0
        (false, 0)
      else
        let start : i64  = hm_hash(k, m.mcap)
        let mut sl    : i64  = start
        let mut found : bool = false
        let mut val   : i64  = 0
        let mut go    : bool = true
        while go
          let used = *hm_uptr(m.bkts, sl)
          let keq  = used && *hm_kptr(m.bkts, sl) == k
          found = if keq then true else found
          val   = if keq then *hm_vptr(m.bkts, sl) else val
          sl    = if !used then sl else if keq then sl else (sl + 1) % m.mcap
          go    = if !used then false else if keq then false else if sl == start then false else true
        (found, val)

fn hm_len : *HMap -> i64
  | m ->
      if m.mcap == 0
        0
      else
        let base : i64 = m.bkts as i64
        let mut cnt : i64 = 0
        let mut i   : i64 = 0
        while i < m.mcap
          let is_used = hm_rget_u(base, i)
          cnt = if is_used then cnt + 1 else cnt
          i   = i + 1
        cnt
fn hm_free : *HMap -> ()  | m -> if m.mcap > 0 then free4(m.bkts) else ()

fn demo_hashmap : () -> bool
  | () ->
      let mut m = hm_new()
      let mut i : i64 = 0
      while i < 10
        hm_insert(&m, i, i * i)
        i = i + 1
      let (ok0, v0) = hm_get(&m, 0)
      let (ok7, v7) = hm_get(&m, 7)
      let (ok9, v9) = hm_get(&m, 9)
      let (miss, _) = hm_get(&m, 99)
      hm_insert(&m, 5, 999)
      let (ok5, v5) = hm_get(&m, 5)
      let sz = hm_len(&m)
      hm_free(&m)
      ok0 && v0 == 0i64 && ok7 && v7 == 49i64 && ok9 && v9 == 81i64 && !miss && ok5 && v5 == 999i64 && sz == 10i64

-- ── §2  VecDeque ─────────────────────────────────────────────────────────────

struct Dq4
  buf4 : ptr
  hd4  : i64
  ln4  : i64
  cp4  : i64

fn dq4_new  : () -> Dq4  | () -> Dq4 { buf4: null, hd4: 0, ln4: 0, cp4: 0 }
fn dq4_rget : (ptr, i64) -> i64    | (p, i) -> *((p as i64 + i * 8) as *i64)
fn dq4_rset : (ptr, i64, i64) -> () | (p, i, v) -> *((p as i64 + i * 8) as *i64) = v

fn dq4_grow : *Dq4 -> ()
  | q ->
      let nc = if q.cp4 == 0 then 8 else q.cp4 * 2
      let nb = malloc4(nc * 8)
      if q.ln4 > 0
        let mut i : i64 = 0
        while i < q.ln4
          dq4_rset(nb, i, dq4_rget(q.buf4, (q.hd4 + i) % q.cp4))
          i = i + 1
      if q.cp4 > 0 then free4(q.buf4) else ()
      q.buf4 = nb
      q.hd4  = 0
      q.cp4  = nc

fn dq4_push_back  : (*Dq4, i64) -> ()
  | (q, x) ->
      if q.ln4 >= q.cp4 then dq4_grow(q) else ()
      let sl = (q.hd4 + q.ln4) % q.cp4
      dq4_rset(q.buf4, sl, x)
      q.ln4 = q.ln4 + 1

fn dq4_push_front : (*Dq4, i64) -> ()
  | (q, x) ->
      if q.ln4 >= q.cp4 then dq4_grow(q) else ()
      q.hd4 = (q.hd4 + q.cp4 - 1) % q.cp4
      dq4_rset(q.buf4, q.hd4, x)
      q.ln4 = q.ln4 + 1

fn dq4_pop_front : *Dq4 -> (bool, i64)
  | q ->
      if q.ln4 == 0
        (false, 0)
      else
        let v = dq4_rget(q.buf4, q.hd4)
        q.hd4 = (q.hd4 + 1) % q.cp4
        q.ln4 = q.ln4 - 1
        (true, v)

fn dq4_len  : *Dq4 -> i64 | q -> q.ln4
fn dq4_free : *Dq4 -> ()  | q -> if q.cp4 > 0 then free4(q.buf4) else ()

fn demo_deque : () -> bool
  | () ->
      let mut q = dq4_new()
      dq4_push_back(&q, 10)
      dq4_push_back(&q, 20)
      dq4_push_back(&q, 30)
      let (ok1, v1) = dq4_pop_front(&q)
      let (ok2, v2) = dq4_pop_front(&q)
      dq4_push_front(&q, 5)
      let (ok3, v3) = dq4_pop_front(&q)
      let (ok4, v4) = dq4_pop_front(&q)
      let (mt, _)   = dq4_pop_front(&q)
      dq4_free(&q)
      ok1 && v1 == 10i64 && ok2 && v2 == 20i64 && ok3 && v3 == 5i64 && ok4 && v4 == 30i64 && !mt

-- ── §3  Struct-based array sort (avoids ptr-to-stack-alloca bug) ─────────────

struct Arr8
  a0 : i64
  a1 : i64
  a2 : i64
  a3 : i64
  a4 : i64
  a5 : i64
  a6 : i64
  a7 : i64

fn a8_get : (*Arr8, i64) -> i64
  | (a, i) -> *((a as i64 + i * 8) as *i64)

fn a8_set : (*Arr8, i64, i64) -> ()
  | (a, i, v) -> *((a as i64 + i * 8) as *i64) = v

fn a8_sel_max : (*Arr8, i64, i64) -> i64
  | (a, n, from) ->
      let mut best : i64 = from
      let mut j    : i64 = from + 1
      while j < n
        best = if a8_get(a, j) > a8_get(a, best) then j else best
        j = j + 1
      best

fn a8_sel_swap : (*Arr8, i64, i64) -> ()
  | (a, i, j) ->
      let t = a8_get(a, i)
      a8_set(a, i, a8_get(a, j))
      a8_set(a, j, t)

fn demo_sort : () -> bool
  | () ->
      let mut d = Arr8 { a0: 3, a1: 1, a2: 4, a3: 1, a4: 5, a5: 9, a6: 2, a7: 6 }
      let mut k : i64 = 0
      while k < 4
        let best = a8_sel_max(&d, 8, k)
        if best != k then a8_sel_swap(&d, k, best) else ()
        k = k + 1
      a8_get(&d, 0) == 9i64 && a8_get(&d, 1) == 6i64 && a8_get(&d, 2) == 5i64 && a8_get(&d, 3) == 4i64

-- ── §4  Option and Result enums ──────────────────────────────────────────────

enum Opt4
  None4,
  Some4(i64),

enum Res4
  Ok4(i64),
  Err4(i64),

fn safe_div : (i64, i64) -> Res4
  | (a, b) -> if b == 0 then Res4.Err4(-1) else Res4.Ok4(a / b)

fn demo_option_result : () -> bool
  | () ->
      let sv = Opt4.Some4(42)
      let nv = Opt4.None4
      let is_some = match sv
        | Some4(_) -> true
        | None4    -> false
      let is_none = match nv
        | Some4(_) -> false
        | None4    -> true
      let uw = match sv
        | Some4(v) -> v
        | None4    -> 0
      let ok_r  = safe_div(100, 4)
      let err_r = safe_div(100, 0)
      let okv   = match ok_r
        | Ok4(v)  -> v
        | Err4(_) -> 0
      let errv  = match err_r
        | Ok4(_)  -> 0
        | Err4(e) -> e
      is_some && is_none && uw == 42i64 && okv == 25i64 && errv == (-1i64)

-- ── §5  Frequency table ───────────────────────────────────────────────────────

fn demo_frequency : () -> bool
  | () ->
      let data : [i64; 12] = [1i64,2i64,1i64,3i64,2i64,1i64,4i64,3i64,1i64,2i64,5i64,1i64]
      let mut freq = hm_new()
      let mut i : i64 = 0
      while i < 12
        let k = data[i]
        let (found, cur) = hm_get(&freq, k)
        if found then hm_insert(&freq, k, cur + 1) else hm_insert(&freq, k, 1)
        i = i + 1
      let (ok1, f1) = hm_get(&freq, 1)
      let (ok2, f2) = hm_get(&freq, 2)
      let (ok3, f3) = hm_get(&freq, 3)
      hm_free(&freq)
      ok1 && f1 == 5i64 && ok2 && f2 == 3i64 && ok3 && f3 == 2i64

fn main : () -> ()
  | () ->
      let r1 = demo_hashmap()
      let r2 = demo_deque()
      let r3 = demo_sort()
      let r4 = demo_option_result()
      let r5 = demo_frequency()
      let all = r1 && r2 && r3 && r4 && r5
      if all
        syscall(1, 1, "PASS\n" as i64, 5)
        syscall(231, 0)
      else
        syscall(1, 1, "FAIL\n" as i64, 5)
        syscall(231, 1)
