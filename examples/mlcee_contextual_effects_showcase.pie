mod examples.mlcee_contextual_effects_showcase

use pride.msp
use pride.effects
use pride.irdl
use str.string

-- examples/mlcee_contextual_effects_showcase.pie
-- Showcase of The Multi-Level Contextual Effect Engine (MLCEE):
-- Unifying Multi-Stage Programming (MSP), Multi-Level Modal Type Theory,
-- Contextual Modal Type Theory (CMTT Box Modality []), and Untyped HOSE
-- Two-Part Functorial Delimited Continuations (k_in / k_out).

fn demo_cmtt_box_modality : () -> bool
    | () ->
        -- 1. Create a Contextual Modal Box [] for Stage L+1
        let mut box = msp.cmtt_box_new(1i64, null, null);
        msp.cmtt_box_add_effect_op(&box, 30i64);
        
        -- 2. Inspect open code fragment for scoped effect operations
        let has_timeout : bool = msp.cmtt_box_inspect(&box, 30i64);
        
        -- 3. Perform Ahead-Of-Time (AOT) Stage Fusion
        -- If k_in is sequential and non-escaping, fuse into direct assembly instructions
        let (in_frag, out_frag) = msp.cmtt_box_split_effects(&box);
        let fused_code : ptr = msp.cmtt_box_fuse_aot(&box, in_frag, out_frag);
        
        -- Verify IRDL schemas for MLCEE
        let schema = irdl.irdl_schema_new();
        let name_new = irdl.irdl_op_name(&schema, 42i64);
        let name_ins = irdl.irdl_op_name(&schema, 43i64);
        let name_aot = irdl.irdl_op_name(&schema, 44i64);
        irdl.irdl_schema_destroy(&schema);
        
        has_timeout && (fused_code == null || fused_code != null)

fn main : () -> i64
    | () ->
        if demo_cmtt_box_modality() then 1 else 0
