-- examples/03_hose_prompt_dynamic_wind.pie
-- HOSE: prompt markers, dynamic-winding, local env, algebraic effects combined.
-- All handler arms are pure (no outer-local mutation).

fn prompt_install    : i64             -> i64  #extern("__pride_prompt_install")  #cc(c)
fn prompt_unwind     : i64             -> ()   #extern("__pride_prompt_unwind")   #cc(c)
fn is_in_scope       : i64             -> bool #extern("__pride_is_in_scope")     #cc(c)
fn dwind_push        : (i64, ptr, ptr, ptr) -> () #extern("__pride_dynamic_wind_push") #cc(c)
fn dwind_pop         : i64             -> ()   #extern("__pride_dynamic_wind_pop")    #cc(c)
fn dwind_enter       : i64             -> ()   #extern("__pride_dynamic_wind_enter")  #cc(c)
fn dwind_exit        : i64             -> ()   #extern("__pride_dynamic_wind_exit")   #cc(c)
fn local_bind        : (i64, ptr, i64) -> i64  #extern("__pride_local_bind")     #cc(c)
fn local_get         : i64             -> ptr  #extern("__pride_local_get")       #cc(c)

-- ── §1  Prompt lifecycle ──────────────────────────────────────────────────────

fn demo_prompt_lifecycle : () -> bool
  | () ->
      let pid : i64 = 42
      let inst = prompt_install(pid)
      let act  = is_in_scope(pid)
      prompt_unwind(pid)
      let gone = !is_in_scope(pid)
      inst == pid && act && gone

-- ── §2  Dynamic-winding (no-op thunks) ───────────────────────────────────────

fn demo_dynamic_wind : () -> bool
  | () ->
      let pid : i64 = 100
      prompt_install(pid)
      dwind_push(pid, null, null, null)
      dwind_enter(pid)
      dwind_exit(pid)
      dwind_pop(pid)
      prompt_unwind(pid)
      true

-- ── §3  Local environment binding ────────────────────────────────────────────

fn demo_local_env : () -> bool
  | () ->
      let pid  : i64 = 200
      let key1 : i64 = 1
      let key2 : i64 = 2
      prompt_install(pid)
      let b1 = local_bind(key1, 0xDEADBEEFi64 as ptr, pid)
      let g1 = local_get(key1)
      let b2 = local_bind(key2, 0x12345678i64 as ptr, pid)
      let g2 = local_get(key2)
      let miss = local_get(99)
      prompt_unwind(pid)
      b1 == key1 && b2 == key2 && (g1 as i64) == 0xDEADBEEFi64 && (g2 as i64) == 0x12345678i64 && miss == null

-- ── §4  Algebraic effect inside an active HOSE prompt ────────────────────────
-- Uses Ask pattern: handler provides values, computation accumulates.

effect SumQ
  sumq : i64 -> i64

fn run_sumq : i64 -> i64 ! [SumQ]
  | n ->
      let mut total : i64 = 0
      let mut i     : i64 = 0
      while i < n
        total = total + SumQ.sumq(i)
        i = i + 1
      total

fn demo_effect_inside_hose : () -> bool
  | () ->
      let pid : i64 = 300
      prompt_install(pid)
      let scope_active = is_in_scope(pid)
      -- sumq(i) returns i+1 → sum 1+2+3+4+5 = 15
      let result : i64 = handle run_sumq(5)
        | SumQ.sumq i k -> k (i + 1)
      prompt_unwind(pid)
      scope_active && result == 15i64

-- ── §5  Multi-prompt scope guard ────────────────────────────────────────────

fn demo_scope_guard : () -> bool
  | () ->
      let p1 : i64 = 401
      let p2 : i64 = 402
      prompt_install(p1)
      prompt_install(p2)
      let both = is_in_scope(p1) && is_in_scope(p2)
      prompt_unwind(p2)
      let p1only = is_in_scope(p1) && !is_in_scope(p2)
      prompt_unwind(p1)
      let none = !is_in_scope(p1) && !is_in_scope(p2)
      both && p1only && none

-- ── §6  Pure effect under HOSE scope ─────────────────────────────────────────
-- HOSE prompt active while an algebraic effect runs. Proves composition.

effect ProdQ
  prodq : i64 -> i64

fn run_prodq : i64 -> i64 ! [ProdQ]
  | n ->
      let mut prod : i64 = 1
      let mut i    : i64 = 1
      while i <= n
        prod = prod * ProdQ.prodq(i)
        i    = i + 1
      prod

fn demo_effect_under_hose : () -> bool
  | () ->
      let pid : i64 = 600
      prompt_install(pid)
      let active = is_in_scope(pid)
      -- prodq(i) returns i → product = 1*2*3*4*5 = 120
      let result : i64 = handle run_prodq(5)
        | ProdQ.prodq i k -> k i
      prompt_unwind(pid)
      active && result == 120i64

fn main : () -> ()
  | () ->
      let r1 = demo_prompt_lifecycle()
      let r2 = demo_dynamic_wind()
      let r3 = demo_local_env()
      let r4 = demo_effect_inside_hose()
      let r5 = demo_scope_guard()
      let r6 = demo_effect_under_hose()
      let all = r1 && r2 && r3 && r4 && r5 && r6
      if all then syscall(1, 1, "PASS\n" as i64, 5) else syscall(1, 1, "FAIL\n" as i64, 5)
      syscall(231, if all then 0 else 1)
