; A value whose RANGE exceeds its own DECLARED WIDTH.
;
; `is_signed` and `width` were being written and never read, so this
; question could not be asked at all. It is a real one: it is how a2 finds
; a truncated constant and decides an overflow check cannot be elided.
module width
func f pub entry=b1
  block b1
    ; declared u8, but the range says 300 -- cannot fit
    %1 = const.int ival=300  [range=300..300 w=8]
    ; declared i8, range fits
    %2 = const.int ival=100  [range=100..100 w=8]
    %3 = bin %1 %2 op=add
    ret %3
  end
endfunc
