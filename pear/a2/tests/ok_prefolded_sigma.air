; A sigma that a PREVIOUS pass already folded into a constant.
; This is legal AIR' -- a2 emits exactly this shape -- and it is the input
; the shape-based guard is blind to: %5 is edge-local knowledge wearing
; the clothes of an ordinary constant.
func probe entry=b1
  block b1
    %1 = mem.entry  [mem=entry:0<-0]
    %2 = param name=p
    %3 = const.int ival=0  [range=0..0 w=64]
    %4 = load.index %2 %3  [mem=use:0<-0 nonlocal mayfault]
    %6 = const.int ival=0  [range=0..0 w=64]
    %7 = bin %4 %6 op=eq  [range=0..1 w=1]
    branch %7 b2 b3
  end
  block b2  ; pred=b1
    %5 = const.int ival=0  [range=0..0 w=64 nonlocal] origin=%4
    ret %5
  end
  block b3  ; pred=b1
    %8 = sigma %4 fact=ne  [nonlocal mayfault] origin=%4
    ret %8
  end
endfunc
