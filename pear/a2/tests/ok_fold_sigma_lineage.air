; A FOLDED sigma must not teach its source's lineage the edge's value.
;
; `%8 = sigma %4 fact=eq [range=0..0] origin=%4` is the true edge of
; `n == 0`, and `%4` is a LOAD -- nothing may claim to know its value.
; SCCP folds %8 to the constant 0, which is correct. The bug was that the
; fold was then learned against origin=%4, so on a SECOND pass the load
; itself read back `range=0..0`, `n == 0` folded true, and the entire
; counted loop below became unreachable: 19 values collapsed to 3 and the
; function returned 0 for every input.
;
; Two separate defects had to be fixed for this to hold:
;   1. the guard in a2_sccp.c3 was passed `(uint)i`, the index of the
;      value WITHIN ITS BLOCK, instead of `vid` -- so it asked about an
;      unrelated value and passed for essentially every fold;
;   2. the guard tested `op == SIGMA`, but SCCP had just REWRITTEN the op
;      to const.int, so even with the right index the shape was gone.
;      origin != id is the durable form of the question.
;
; The assertion is run over TWO passes of a2, because a single pass never
; feeds the fact back round -- which is exactly why this survived until
; a2 was iterated.
module /tmp/fx/min.pie
func count_up entry=b1
  block b1
    %1 = mem.entry  [mem=entry:0<-0]
    %2 = param name=p
    %3 = const.int ival=0  [range=0..0 w=64 kb=18446744073709551615/0]
    %4 = load.index %2 %3  [mem=use:0<-0 nonlocal mayfault]
    %5 = pi %3 %4 fact=inbounds  [range=0..0 w=64 kb=18446744073709551615/0] origin=%3
    %6 = const.int ival=0  [range=0..0 w=64 kb=18446744073709551615/0]
    %7 = bin %4 %6 op=eq  [range=0..1 w=1]
    branch %7 b2 b3
  end
  block b2  ; pred=b1
    %8 = sigma %4 fact=eq  [range=0..0 mayfault] origin=%4
    %9 = const.int ival=0  [range=0..0 w=64 kb=18446744073709551615/0 nonlocal]
    jump b4
  end
  block b3  ; pred=b1
    %10 = sigma %4 fact=ne  [nonlocal mayfault] origin=%4
    %11 = const.int ival=0  [range=0..0 w=64 kb=18446744073709551615/0 nonlocal]
    %12 = const.int ival=0  [range=0..0 w=64 kb=18446744073709551615/0 nonlocal]
    jump b5
  end
  block b4  ; pred=b2,b7
    %13 = phi %9@b2 %16@b7  [nonlocal]
    ret %13
  end
  block b5  ; pred=b3,b6
    %14 = phi %12@b3 %21@b6  [nonlocal]
    %15 = phi %10@b3 %15@b6  [nonlocal mayfault]
    %16 = phi %11@b3 %19@b6  [nonlocal]
    %17 = bin %14 %15 op=lt  [range=0..1 w=1]
    branch %17 b6 b8
  end
  block b6  ; pred=b5
    %18 = sigma %14 fact=lt origin=%14
    %19 = bin %16 %18 op=add  [nonlocal]
    %20 = const.int ival=1  [range=1..1 w=64 kb=18446744073709551614/1]
    %21 = bin %18 %20 op=add  [nonlocal]
    jump b5
  end
  block b7  ; pred=b8
    %22 = const.unit
    jump b4
  end
  block b8  ; pred=b5
    %23 = sigma %14 fact=ge origin=%14
    jump b7
  end
endfunc
