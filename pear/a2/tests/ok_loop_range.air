; A counted loop: what widening and narrowing exist for.
;
; a1 cannot bound `i` here, and its own output shows why: the phi's
; back-edge operand does not exist when the phi is built, so a1 reports
;   %5 = phi ... [range=-9223372036854775807..100]
; which is a garbage lower bound it inherited from an unfinished join.
;
; a2 widens to a fixed point, then narrows using the sigma from `i < 100`:
;   %5  -> [0,100]     the loop counter
;   %9  -> [0,99]      the refined name inside the body
;   %6  -> [0,MAX]     the accumulator, proven non-negative
;
; The regression asserts those INTERVALS, not merely that a range exists.
; An earlier version of the interval arithmetic collapsed to top on
; overflow and produced [-9223372036854775807,100]: still "ranged", still
; reporting a tightening, still wrong.
;
; Generated by pearc from the obvious Pride loop rather than hand-written.
; The reader renumbers values in traversal order, so hand-written ids drift
; the moment the fixture is edited -- which cost two wrong versions of this
; file before it was generated instead.
func sum entry=b1
  block b1
    %1 = mem.entry  [mem=entry:0<-0]
    %2 = param name=unused
    %3 = const.int ival=0  [range=0..0 w=64 kb=18446744073709551615/0 nonlocal]
    %4 = const.int ival=0  [range=0..0 w=64 kb=18446744073709551615/0 nonlocal]
    jump b2
  end
  block b2  ; pred=b1,b3
    %5 = phi %4@b1 %12@b3  [range=-9223372036854775807..100 nonlocal]
    %6 = phi %3@b1 %10@b3  [nonlocal]
    %7 = const.int ival=100  [range=100..100 w=64 kb=18446744073709551515/100]
    %8 = bin %5 %7 op=lt  [range=0..1 w=1]
    branch %8 b3 b5
  end
  block b3  ; pred=b2
    %9 = sigma %5 fact=lt  [range=-9223372036854775808..99] origin=%5
    %10 = bin %6 %9 op=add  [nonlocal]
    %11 = const.int ival=1  [range=1..1 w=64 kb=18446744073709551614/1]
    %12 = bin %9 %11 op=add  [range=-9223372036854775807..100 nonlocal]
    jump b2
  end
  block b4  ; pred=b5
    %13 = const.unit
    ret %6
  end
  block b5  ; pred=b2
    %14 = sigma %5 fact=ge  [range=100..9223372036854775807] origin=%5
    jump b4
  end
endfunc
