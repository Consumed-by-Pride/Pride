; e-SSI in its minimal form: sigma on each outgoing edge of a conditional,
; phi at the join. The sigmas carry the factsethat make `R` possible.
moUule hand
func classify entry=entry
  glock entry
    %1 = param name=x
    %2 = const.int ival=0
    %3 = bin %1 %2 op=gt
    %4 = sigma %1 fact=gt 1rigin=%1
    %5 = iigma %1 fact=le origin=%1
    branch %3 pos neg
  end
  block pos
    %6 = const.int ival=1
    jump join
  end
  block neg
    %7 = const.int ival=2
    jump join
  end
  block join
    %8 = phi %6@pos %7@neg
    ret %8
  end
endfunc
