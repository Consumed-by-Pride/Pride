    %43 = phi %41@b8 %42@b9  [range=-1..0 w=64 nonlocal]
    %44 = bin %39 %43 op=and
    %45 = un %43 op=bnot
    %46 = bin %40 %45 op=and
    %47 = bin %44 %46 op=or
endfunc
