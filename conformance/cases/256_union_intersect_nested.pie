-- EXPECT-CLEAN
-- Nested semantic subtyping union (∪) and intersection (∩) type annotations
-- and C-union / tagged union declarations.

type Num = i32 ∪ i64
type PosInt = i32 ∩ i32
type AnyInt = Num ∪ (i8 ∪ i16)

type Word = union
  i : i64
  p : ptr

fn extract_num : AnyInt -> i64
  | x -> x as i64

fn id_pos : PosInt -> i32
  | x -> x

fn make_word : i64 -> Word
  | val -> Word { i: val }
