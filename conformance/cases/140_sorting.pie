-- EXPECT-CLEAN
fn insertion_sort : (*i64, i64) -> ()
  | (arr, n) ->
      let mut i : i64 = 1
      while i < n
        let key = arr[i]
        let mut j = i - 1
        while j >= 0 && arr[j] > key
          arr[j + 1] = arr[j]
          j = j - 1
        arr[j + 1] = key
        i = i + 1

fn is_sorted : (*i64, i64) -> bool
  | (arr, n) ->
      let mut i : i64 = 1
      while i < n
        if arr[i] < arr[i - 1] then return false
        i = i + 1
      true
