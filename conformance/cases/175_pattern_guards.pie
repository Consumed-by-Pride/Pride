-- EXPECT-CLEAN
fn classify : i64 -> i64
  | n, n < 0i64   -> 0i64 - 1i64
  | n, n == 0i64  -> 0i64
  | n, n < 10i64  -> 1i64
  | n, n < 100i64 -> 2i64
  | _             -> 3i64

fn fizzbuzz_num : i64 -> i64
  | n, n % 15i64 == 0i64 -> 4i64
  | n, n % 3i64  == 0i64 -> 3i64
  | n, n % 5i64  == 0i64 -> 5i64
  | _                    -> 0i64

fn sign : i64 -> i64
  | n, n > 0i64  -> 1i64
  | n, n < 0i64  -> 0i64 - 1i64
  | _            -> 0i64
