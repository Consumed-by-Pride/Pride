-- EXPECT-CLEAN
effect Fail
  abort : i32 -> ()

fn safe_div : (i32, i32) -> i32 ! [Fail]
  | (_, 0) -> Fail.abort(0 - 1)
  | (a, b) -> a / b

fn safe_sqrt : i64 -> i64 ! [Fail]
  | n, n < 0 -> Fail.abort(0 - 1)
  | n ->
      let mut r : i64 = 0
      let mut i : i64 = 1
      while i * i <= n
        r = i
        i = i + 1
      r

fn run_safe : () -> i32
  | () ->
      handle safe_div(10, 2)
        | Fail.abort _ k -> k(0 - 1)
