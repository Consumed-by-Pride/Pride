-- EXPECT-CLEAN
effect Counter
  tick  : () -> i64
  reset : () -> ()

fn count_to : i64 -> i64 ! [Counter]
  | n ->
    let mut i : i64 = 0i64
    while i < n
      let v : i64 = Counter.tick()
      i = v
    i

fn pure_counter : i64 -> i64
  | n ->
    let mut s : i64 = 0i64
    let mut i : i64 = 0i64
    while i < n
      s = s + i
      i = i + 1i64
    s
