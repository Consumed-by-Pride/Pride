-- EXPECT-CLEAN
fn popcount32 : u32 -> i32
  | x ->
    let n1 : u32 = x - ((x >> 1u32) & 0x55555555u32)
    let n2 : u32 = (n1 & 0x33333333u32) + ((n1 >> 2u32) & 0x33333333u32)
    let n3 : u32 = (n2 + (n2 >> 4u32)) & 0x0F0F0F0Fu32
    ((n3 * 0x01010101u32) >> 24u32) as i32

fn parity32 : u32 -> bool
  | x ->
    let a : u32 = x ^ (x >> 16u32)
    let b : u32 = a ^ (a >> 8u32)
    let c : u32 = b ^ (b >> 4u32)
    let d : u32 = c ^ (c >> 2u32)
    let e : u32 = d ^ (d >> 1u32)
    (e & 1u32) == 1u32

fn is_pow2 : u64 -> bool
  | x -> x > 0u64 && (x & (x - 1u64)) == 0u64

fn lowest_bit : u64 -> u64
  | x -> x & (0u64 - x)

fn bit_reverse16 : u16 -> u16
  | x ->
    let a : u32 = x as u32
    let b : u32 = ((a & 0xAAAAu32) >> 1u32) | ((a & 0x5555u32) << 1u32)
    let c : u32 = ((b & 0xCCCCu32) >> 2u32) | ((b & 0x3333u32) << 2u32)
    let d : u32 = ((c & 0xF0F0u32) >> 4u32) | ((c & 0x0F0Fu32) << 4u32)
    ((d >> 8u32) | (d << 8u32)) as u16
