-- EXPECT-CLEAN
fn log2_bucket : i64 -> i32
  | ns ->
    if ns <= 0i64 then 0i32
    else
      let mut n : i64 = ns
      let mut b : i32 = 0i32
      while n > 1i64 && b < 63i32
        n = n >> 1i64
        b = b + 1i32
      b

fn hist_mean : (i64, i64) -> i64
  | (total, count) ->
    if count == 0i64 then 0i64
    else total / count

fn time_elapsed_us : (i64, i64) -> i64
  | (start_ns, end_ns) ->
    (end_ns - start_ns) / 1000i64

fn zone_is_hot : (i64, i64, i64) -> bool
  | (zone_ns, total_ns, threshold_pct) ->
    if total_ns == 0i64 then false
    else (zone_ns * 100i64) / total_ns >= threshold_pct
